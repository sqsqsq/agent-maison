# Release artifact and cross-platform consistency: store and check out text as LF.
* text=auto eol=lf

# Hylyre vendor source tree: per-file sha256 in release.manifest.json is computed
# over LF bytes; pin explicitly so text=auto heuristics can never misclassify one.
profiles/hmos-app/vendor/hylyre/src/** text eol=lf

# Frozen machine logs may mix line endings; preserve exact source SHA bytes.
# These are evidence originals, not editable source text.
harness/tests/fixtures/host-recovery-history/20261024-fe4512-s1/**/*.log binary
harness/tests/fixtures/host-recovery-history/20261026-fe4512-s2/**/*.log binary

*.whl binary
*.traineddata binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
