{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{PROJECT_ROOT}}/framework/agents/codex/hooks/guard-framework-write.mjs\"",
            "commandWindows": "node \"{{PROJECT_ROOT}}/framework/agents/codex/hooks/guard-framework-write.mjs\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
