{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"rg --files 'doc/features' -g 'acceptance.yaml' | Select-Object -First 5\n\"'$examples=rg --files '\"'doc/features' -g 'acceptance.yaml' | Select-Object -First 2; foreach(\"'$p in $examples){Write-Output \"`n=== $p ===\";Get-Content -Raw $p}\nWrite-Output '\"'=== facts template ==='\nGet-Content -Raw 'framework/harness/templates/context-exploration.md'\nWrite-Output '=== facts utility key expectations ==='\nrg -n \\\"schema_version|established_by|source_code_paths|Code Facts|ready_to_produce|phase_delta|change_intent|estimated_loc_delta|touches_layers\\\" 'framework/harness/scripts/utils/context-facts.ts'\"","aggregated_output":"doc/features\\_archive\\bc-openCard-1.20260905\\acceptance.yaml\r\ndoc/features\\homepage\\acceptance.yaml\r\ndoc/features\\bc-openCard-1\\acceptance.yaml\r\n\n=== doc/features\\_archive\\bc-openCard-1.20260905\\acceptance.yaml ===\r\n# 验收标准 SSOT — bc-openCard-1（由 spec/spec.md §9 提取）\n# 规范：framework/skills/reference/spec-workflow-detail.md §Step 6\nschema_version: \"1.0\"\nfeature: \"bc-openCard-1\"\n\n# ─────────────────────────────────────────────────────────────\n# flows：有序屏链（映射形态，key = flow 名）\n# 每条相邻边由 ≥1 条 P0 AC 的 checkpoint 拥有；pre_screen == post_screen 为同屏断言，不注册边。\n# ─────────────────────────────────────────────────────────────\nflows:\n  bank_card_entry_flow:\n    description: \"从卡包经添加卡片页进入添加银行卡页面（含既有路由回归）\"\n    screens:\n      - card_pack\n      - add_card_entry\n      - add_bank_card_collapsed\n  bank_card_expand_flow:\n    description: \"添加银行卡页面收起态 → 展开态 → 全部银行页面\"\n    screens:\n      - add_bank_card_collapsed\n      - add_bank_card_expanded\n      - all_banks\n  all_banks_browse_flow:\n    description: \"在全部银行页面内浏览、字母定位与选行（同屏交互）\"\n    screens:\n      - all_banks\n  bank_card_back_flow:\n    description: \"从添加银行卡页面返回添加卡片页（返回路径回归）\"\n    screens:\n      - add_bank_card_collapsed\n      - add_card_entry\n\ncriteria:\n  - id: AC-1\n    prd_function: F8\n    priority: P0\n    description: \"在卡包页面点击「添加卡片」入口，进入添加卡片页面，页面上可见「银行卡」行与「管理非本机卡片」行。\"\n    testable: true\n    verification_steps:\n      - \"冷启动应用，进入卡包页面\"\n      - \"点击「添加卡片」入口行\"\n      - \"断言添加卡片页面已展开，且 add_card_bank_row / non_local_cards_entry 均可见\"\n    expected_result: \"停留在添加卡片页面，银行卡行与管理非本机卡片行均可见；既有路由未受损。\"\n    ut_layer: device\n    device_focus: \"卡包 → 添加卡片 的既有 pushPath 路由在本轮改动后仍可达\"\n    linked_flow: bank_card_entry_flow\n    linked_branch: \"主路径 · 入口段\"\n    checkpoint:\n      pre_screen: card_pack\n      action:\n        target_element_id: card_pack_add_card_entry\n      post_screen: add_card_entry\n      required_element_ids:\n        - add_card_bank_row\n        - non_local_cards_entry\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"测试用例要包含老代码和本轮新开发代码的页面互相跳转功能，不能导致原有路由受损。\"\n      snippet_sha256: \"ac15e5291b666545510f25a924e0a4199a235258a04a34557d111026129edaf8\"\n\n  - id: AC-2\n    prd_function: F8\n    priority: P0\n    description: \"在添加卡片页面点击「银行卡」行，跳转到添加银行卡页面收起态，标题为「添加银行卡」，不再出现「暂不支持」提示。\"\n    testable: true\n    verification_steps:\n      - \"处于添加卡片页面\"\n      - \"点击「银行卡」行（add_card_bank_row）\"\n      - \"断言页面标题为「添加银行卡」，白卡与更多药丸可见，且无「暂不支持」轻提示\"\n    expected_result: \"导航到添加银行卡页面收起态；col_page_title / col_bank_card / col_more_pill 均可见。\"\n    ut_layer: device\n    device_focus: \"银行卡行由 showToast 改接 pushPath 后的真实跳转\"\n    linked_flow: bank_card_entry_flow\n    linked_branch: \"主路径 · 入口段\"\n    checkpoint:\n      pre_screen: add_card_entry\n      action:\n        target_element_id: add_card_bank_row\n      post_screen: add_bank_card_collapsed\n      required_element_ids:\n        - col_page_title\n        - col_bank_card\n        - col_more_pill\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"当前版本从添卡入口，点击银行卡后，是提示暂不支持。本页面新增后，点击银行卡则跳转到本页面。\"\n      snippet_sha256: \"52dac7021339f39255e20cbf60e8ab1f306b917a49d42ada15f2d882219c65ff\"\n\n  - id: AC-3\n    prd_function: F1\n    priority: P0\n    description: \"添加银行卡页面收起态可见：标题「添加银行卡」、左副标题「免输卡号添卡」、右副标题「支持 20 家银行」、白卡内首行「招商银行」与末行「交通银行」、底部「更多」药丸及其文案「更多」。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面收起态\"\n      - \"点击首行「招商银行」（同屏断言，页面不跳转）\"\n      - \"逐项断言 col_page_title / col_subtitle_left / col_subtitle_right / col_row_cmb / col_row_bocom / col_more_pill / col_more_text 可见\"\n    expected_result: \"收起态版面与参考图一致：7 家银行 + 底部更多药丸；页面仍停留在收起态。\"\n    ut_layer: device\n    device_focus: \"收起态首屏元素齐备性与版面一致性（唯一与设备视口同口径的参考图）\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"主路径 · 收起态同屏断言\"\n    checkpoint:\n      pre_screen: add_bank_card_collapsed\n      action:\n        target_element_id: col_row_cmb\n      post_screen: add_bank_card_collapsed\n      required_element_ids:\n        - col_page_title\n        - col_subtitle_left\n        - col_subtitle_right\n        - col_row_cmb\n        - col_row_bocom\n        - col_more_pill\n        - col_more_text\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"最下方是剩余银行中前5个的小图标和一个更多按钮（点击更多后，则切换页面形态为展开态）\"\n      snippet_sha256: \"2510062d963d99bf1c28551036fe19f19aa906d92cee4621320c8eebd3a20b80\"\n\n  - id: AC-4\n    prd_function: F2\n    priority: P0\n    description: \"点击「更多」药丸后页面切为展开态，出现搜索框与「查看全部银行」文案，且导航栈深度不变。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面收起态\"\n      - \"点击「更多」药丸（col_more_pill）\"\n      - \"断言 exp_search_bar / exp_bank_card / exp_view_all_banks_btn 可见\"\n    expected_result: \"同一页面切换到展开态；搜索框与「查看全部银行」出现；未新增导航栈层级。\"\n    ut_layer: device\n    device_focus: \"形态切换（非路由跳转）与切换后元素齐备性\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"主路径 · 收起→展开\"\n    checkpoint:\n      pre_screen: add_bank_card_collapsed\n      action:\n        target_element_id: col_more_pill\n      post_screen: add_bank_card_expanded\n      required_element_ids:\n        - exp_search_bar\n        - exp_bank_card\n        - exp_view_all_banks_btn\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"点击下方的更多，页面会从收起态变为展开态。\"\n      snippet_sha256: \"b43bf3e762fe54937d89c36781e7a5417ff52c645f24c3c65e39582e22386b42\"\n\n  - id: AC-5\n    prd_function: F3\n    priority: P0\n    description: \"展开态白卡内共 20 行银行，向下滚动可达末行「中国银行」，且「查看全部银行」位于白卡内部末尾。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面展开态\"\n      - \"向下滚动直到末行可见\"\n      - \"点击首行「招商银行」（同屏断言，页面不跳转）\"\n      - \"断言 exp_row_cmb / exp_row_boc / exp_view_all_banks_btn 均可见\"\n    expected_result: \"20 行银行完整可滚动浏览；末行为「中国银行」；「查看全部银行」在白卡内。\"\n    ut_layer: device\n    device_focus: \"展开态长列表滚动可达性与白卡内页脚归属\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"主路径 · 展开态同屏断言\"\n    checkpoint:\n      pre_screen: add_bank_card_expanded\n      action:\n        target_element_id: exp_row_cmb\n      post_screen: add_bank_card_expanded\n      required_element_ids:\n        - exp_row_cmb\n        - exp_row_boc\n        - exp_view_all_banks_btn\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"展开态最多展示20家银行，同时最下方按钮变为查看全部银行。\"\n      snippet_sha256: \"a26b3308bc10141ae565a5347ef89077f3f28d8b5c1a47f3b9c7169a8a1c403d\"\n\n  - id: AC-6\n    prd_function: F4\n    priority: P0\n    description: \"点击「查看全部银行」跳转到全部银行页面，标题为「全部银行」，可见搜索框、字母索引条与首个分组标签「B」。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面展开态\"\n      - \"点击「查看全部银行」（exp_view_all_banks_btn）\"\n      - \"断言 ab_page_title / ab_search_bar / ab_letter_index / ab_group_label_B / ab_group_card_B 可见\"\n    expected_result: \"按既有路由规则跳转到全部银行页面并渲染 A-Z 分组列表与字母索引条。\"\n    ut_layer: device\n    device_focus: \"新增页面的 pushPath 跳转与首屏元素齐备性\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"主路径 · 展开→全部银行\"\n    checkpoint:\n      pre_screen: add_bank_card_expanded\n      action:\n        target_element_id: exp_view_all_banks_btn\n      post_screen: all_banks\n      required_element_ids:\n        - ab_page_title\n        - ab_search_bar\n        - ab_letter_index\n        - ab_group_label_B\n        - ab_group_card_B\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"查看全部银行按钮点击后进入全部银行页面，任一银行点击后，拉起选择卡类型半模态页面（当前还没有选择卡类型半模态页面，点击后提示暂不支持即可）。\"\n      snippet_sha256: \"c248e81e570bb728dd407bce4b9c2e78d62b9e98e9dcffcdfdbcf5557befddc0\"\n\n  - id: AC-7\n    prd_function: F5\n    priority: P0\n    description: \"全部银行页面按拼音首字母分为 11 组，顺序为 B、G、H、J、M、N、P、S、X、Y、Z，各组银行与 spec §5.3.2 完全一致。\"\n    testable: true\n    verification_steps:\n      - \"单元侧：对 20 条银行 mock 调用分组函数，断言分组键序与每组成员完全等于 spec §5.3.2\"\n      - \"设备侧：处于全部银行页面，点击「北京银行」行（同屏断言）\"\n      - \"设备侧：断言 ab_group_label_B / ab_group_label_G / ab_group_label_Z / ab_row_bob / ab_row_boc 可见\"\n    expected_result: \"分组函数输出 11 个分组、键序 B<G<H<J<M<N<P<S<X<Y<Z；页面渲染的分组标签与行与之一致。\"\n    ut_layer: both\n    ut_focus: \"拼音首字母分组纯函数：输入 20 条 mock，输出 11 组、键升序、组内保持输入声明顺序\"\n    device_focus: \"全部银行页面上分组标签与分组白卡的真实渲染顺序\"\n    linked_flow: all_banks_browse_flow\n    linked_branch: \"主路径 · 全部银行同屏断言\"\n    checkpoint:\n      pre_screen: all_banks\n      action:\n        target_element_id: ab_row_bob\n      post_screen: all_banks\n      required_element_ids:\n        - ab_group_label_B\n        - ab_group_label_G\n        - ab_group_label_Z\n        - ab_row_bob\n        - ab_row_boc\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"下方是将银行按拼音首字母A-Z顺序排序并分块的列表，右边有个A-Z的字母索引表，根据所有银行的拼音首字母汇总计算得来，部分字母没有对应银行则不展示。\"\n      snippet_sha256: \"1a709f44df45b36f9a3ef6bf79d8402485dae6dbc235c29810d0780e6faf7ac6\"\n\n  - id: AC-8\n    prd_function: F6\n    priority: P0\n    description: \"右侧字母索引条只展示 11 个有银行的字母（不含 A、C、D、E 等空字母）；点击「Z」后「招商银行」进入视口。\"\n    testable: true\n    verification_steps:\n      - \"处于全部银行页面\"\n      - \"点击字母索引条上的「Z」（ab_index_Z）\"\n      - \"断言 ab_group_label_Z 与 ab_row_cmb 进入视口\"\n    expected_result: \"索引条仅 11 个字母；点击 Z 后列表定位到 Z 分组，招商银行可见。\"\n    ut_layer: device\n    device_focus: \"字母索引条的字母集合裁剪与点击定位\"\n    linked_flow: all_banks_browse_flow\n    linked_branch: \"主路径 · 字母定位\"\n    checkpoint:\n      pre_screen: all_banks\n      action:\n        target_element_id: ab_index_Z\n      post_screen: all_banks\n      required_element_ids:\n        - ab_group_label_Z\n        - ab_row_cmb\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"用户在全部银行页面，可以通过滑动或右侧字母表快速选择到对应的银行。任一银行点击后，效果与添加银行卡页面效果一致。\"\n      snippet_sha256: \"278c7dcfb8075836df506c94593d2aa033814b9299c27a07b5325258cbb67227\"\n\n  - id: AC-9\n    prd_function: F7\n    priority: P0\n    description: \"收起态点击「工商银行」行，出现「暂不支持」提示，页面仍停留在添加银行卡页面收起态。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面收起态\"\n      - \"点击「工商银行」行（col_row_icbc）\"\n      - \"断言出现「暂不支持」轻提示，且 col_bank_card / col_more_pill 仍可见（未跳转）\"\n    expected_result: \"轻提示出现；导航栈深度不变；页面元素保持收起态。\"\n    ut_layer: device\n    device_focus: \"银行行点击的暂不支持提示与不跳转\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"分支 · 选卡类型半模态未实现\"\n    checkpoint:\n      pre_screen: add_bank_card_collapsed\n      action:\n        target_element_id: col_row_icbc\n      post_screen: add_bank_card_collapsed\n      required_element_ids:\n        - col_bank_card\n        - col_more_pill\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"查看全部银行按钮点击后进入全部银行页面，任一银行点击后，拉起选择卡类型半模态页面（当前还没有选择卡类型半模态页面，点击后提示暂不支持即可）。\"\n      snippet_sha256: \"c248e81e570bb728dd407bce4b9c2e78d62b9e98e9dcffcdfdbcf5557befddc0\"\n\n  - id: AC-10\n    prd_function: F7\n    priority: P0\n    description: \"全部银行页面点击「工商银行」行，出现「暂不支持」提示，页面仍停留在全部银行页面。\"\n    testable: true\n    verification_steps:\n      - \"处于全部银行页面\"\n      - \"点击 G 组中的「工商银行」行（ab_row_icbc）\"\n      - \"断言出现「暂不支持」轻提示，且 ab_group_card_G 仍可见（未跳转）\"\n    expected_result: \"轻提示出现；页面停留在全部银行页面，效果与添加银行卡页面一致。\"\n    ut_layer: device\n    device_focus: \"全部银行页面选行行为与添加银行卡页面保持一致\"\n    linked_flow: all_banks_browse_flow\n    linked_branch: \"分支 · 选卡类型半模态未实现\"\n    checkpoint:\n      pre_screen: all_banks\n      action:\n        target_element_id: ab_row_icbc\n      post_screen: all_banks\n      required_element_ids:\n        - ab_group_card_G\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"用户在全部银行页面，可以通过滑动或右侧字母表快速选择到对应的银行。任一银行点击后，效果与添加银行卡页面效果一致。\"\n      snippet_sha256: \"278c7dcfb8075836df506c94593d2aa033814b9299c27a07b5325258cbb67227\"\n\n  - id: AC-11\n    prd_function: F8\n    priority: P0\n    description: \"在添加银行卡页面点击返回按钮，回到添加卡片页面，且「银行卡」行仍可再次进入（路由未受损）。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面收起态\"\n      - \"点击左上角返回按钮（col_back_btn）\"\n      - \"断言回到添加卡片页面，add_card_bank_row / non_local_cards_entry 可见\"\n    expected_result: \"弹出导航栈栈顶，回到添加卡片页面，页面内容完整。\"\n    ut_layer: device\n    device_focus: \"新增页面返回链路与既有页面状态恢复\"\n    linked_flow: bank_card_back_flow\n    linked_branch: \"主路径 · 返回段\"\n    checkpoint:\n      pre_screen: add_bank_card_collapsed\n      action:\n        target_element_id: col_back_btn\n      post_screen: add_card_entry\n      required_element_ids:\n        - add_card_bank_row\n        - non_local_cards_entry\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"测试用例要包含老代码和本轮新开发代码的页面互相跳转功能，不能导致原有路由受损。\"\n      snippet_sha256: \"ac15e5291b666545510f25a924e0a4199a235258a04a34557d111026129edaf8\"\n\n  - id: AC-12\n    prd_function: F9\n    priority: P1\n    description: \"银行数据源返回 20 条记录，每条含名称、code、拼音首字母、logo 资源键；分组函数输出 11 个非空分组，键序为 B<G<H<J<M<N<P<S<X<Y<Z，组内顺序等于输入声明顺序。\"\n    testable: true\n    verification_steps:\n      - \"调用银行数据源获取列表，断言长度为 20\"\n      - \"逐条断言 name / code / initial / logoKey 四个字段非空，且 initial ∈ [A-Z]\"\n      - \"对该列表调用分组函数，断言键序与每组成员完全等于 spec §5.3.2\"\n    expected_result: \"20 条数据字段完整；分组结果 11 组，B(1)/G(4)/H(1)/J(2)/M(1)/N(3)/P(2)/S(1)/X(1)/Y(1)/Z(3)。\"\n    ut_layer: unit\n    ut_focus: \"银行 mock 数据源字段完整性 + 拼音首字母分组纯函数的键序与组内顺序\"\n    data_constraints: \"模拟数据，本地同步返回，不依赖任何网络或数据库\"\n    linked_flow: all_banks_browse_flow\n    linked_branch: \"数据子流程\"\n    requirement_ref:\n      source_path: doc/features/原始需求/1-1-银行卡/原始需求.md\n      snippet: \"下方是将银行按拼音首字母A-Z顺序排序并分块的列表，右边有个A-Z的字母索引表，根据所有银行的拼音首字母汇总计算得来，部分字母没有对应银行则不展示。\"\n      snippet_sha256: \"1a709f44df45b36f9a3ef6bf79d8402485dae6dbc235c29810d0780e6faf7ac6\"\n\n  - id: AC-13\n    prd_function: F9\n    priority: P1\n    description: \"分组函数对空数组输入返回空分组结构（长度 0），不抛异常。\"\n    testable: true\n    verification_steps:\n      - \"对空数组调用分组函数\"\n      - \"断言返回值长度为 0 且未抛异常\"\n    expected_result: \"返回空分组结构；索引字母集合同为空。\"\n    ut_layer: unit\n    ut_focus: \"分组纯函数的空输入边界\"\n    linked_flow: all_banks_browse_flow\n    linked_branch: \"数据子流程 · 空输入\"\n\n  - id: AC-14\n    prd_function: F10\n    priority: P1\n    description: \"展开态与全部银行页面均渲染搜索框（占位文案「搜索银行」+「搜索」按钮）；点击后出现「暂不支持」提示且列表内容不变。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面展开态\"\n      - \"点击搜索框内的「搜索」按钮（exp_search_button）\"\n      - \"断言出现「暂不支持」轻提示，且 exp_search_bar / exp_search_placeholder / exp_bank_card 仍可见\"\n    expected_result: \"搜索框按参考图渲染；点击不进入搜索态、列表内容不变。\"\n    ut_layer: device\n    device_focus: \"搜索框视觉渲染与「本轮不实现搜索功能」的行为口径\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"分支 · 搜索未实现\"\n    checkpoint:\n      pre_screen: add_bank_card_expanded\n      action:\n        target_element_id: exp_search_button\n      post_screen: add_bank_card_expanded\n      required_element_ids:\n        - exp_search_bar\n        - exp_search_placeholder\n        - exp_bank_card\n\n  - id: AC-15\n    prd_function: F8\n    priority: P1\n    description: \"在添加卡片页面点击返回，回到卡包页面，卡包页面原有内容完整可见（老链路未受损）。\"\n    testable: true\n    verification_steps:\n      - \"处于添加卡片页面（由 AC-11 返回而来）\"\n      - \"触发返回（页面返回按钮或系统返回）\"\n      - \"断言回到卡包页面且 card_pack_add_card_entry 可见\"\n    expected_result: \"回到卡包页面，既有内容完整；导航栈回到进入本链路前的深度。\"\n    ut_layer: device\n    device_focus: \"添加卡片 → 卡包 的既有返回链路在本轮改动后未受损（该边由系统返回触发，无页面内元素锚点，故不注册 checkpoint）\"\n    linked_branch: \"主路径 · 返回段延伸\"\n\n  - id: AC-16\n    prd_function: F11\n    priority: P2\n    description: \"华夏银行行在收起态与展开态均展示角标「首绑送12元券包」，其余 19 行不展示角标。\"\n    testable: true\n    verification_steps:\n      - \"处于添加银行卡页面收起态\"\n      - \"点击「华夏银行」行（同屏断言，页面不跳转）\"\n      - \"断言 col_badge_hxb 可见，且 col_row_cmb / col_row_icbc 上无角标\"\n    expected_result: \"仅华夏银行行带橙色描边角标「首绑送12元券包」。\"\n    ut_layer: device\n    device_focus: \"营销角标的唯一性与文案逐字一致\"\n    linked_flow: bank_card_expand_flow\n    linked_branch: \"分支 · 营销角标\"\n    checkpoint:\n      pre_screen: add_bank_card_collapsed\n      action:\n        target_element_id: col_row_hxb\n      post_screen: add_bank_card_collapsed\n      required_element_ids:\n        - col_badge_hxb\n        - col_row_hxb\n\n  - id: AC-G1\n    prd_function: F1\n    priority: P1\n    description: \"两个新页面在目标机型上正常显示，无布局错乱、无文字截断、无控件重叠。\"\n    testable: true\n    verification_steps:\n      - \"分别进入添加银行卡页面（收起态/展开态）与全部银行页面\"\n      - \"逐屏截图并核对 ui-spec 的 forbidden_overlap / protected_region 声明\"\n    expected_result: \"三屏均无控件 bounds 相交、无文字被截断。\"\n    ut_layer: device\n    device_focus: \"版面完整性与 forbidden_overlap 运行时布局树校验\"\n    linked_branch: \"通用\"\n\n  - id: AC-G2\n    prd_function: F2\n    priority: P1\n    description: \"形态切换与路由跳转的交互响应时间 ≤ 300ms。\"\n    testable: true\n    verification_steps:\n      - \"记录点击「更多」到展开态首帧的时间\"\n      - \"记录点击「查看全部银行」到全部银行页面首帧的时间\"\n    expected_result: \"两项均 ≤ 300ms。\"\n    ut_layer: device\n    device_focus: \"交互响应时延实测\"\n    linked_branch: \"通用\"\n\n  - id: AC-G3\n    prd_function: F9\n    priority: P1\n    description: \"银行数据为空或读取失败时给出明确空态/提示，不白屏、不崩溃。\"\n    testable: true\n    verification_steps:\n      - \"单元侧：注入空列表与抛异常的数据源，断言页面状态机进入空态且异常被捕获\"\n      - \"断言无未捕获的 Promise rejection\"\n    expected_result: \"空态占位渲染；异常被捕获并记录日志；无崩溃。\"\n    ut_layer: unit\n    ut_focus: \"空列表与异常数据源下的状态机分支与异常捕获\"\n    linked_branch: \"通用 · 异常\"\n\n  - id: AC-G4\n    prd_function: F8\n    priority: P0\n    description: \"本轮改动不破坏既有路由：卡包 → 添加卡片 → 各卡种行（银行卡跳转、其余四种提示暂不支持）与逐级返回全部可用。\"\n    testable: true\n    verification_steps:\n      - \"依次走通 卡包 → 添加卡片 → 添加银行卡 → 返回 → 卡包\"\n      - \"在添加卡片页面点击「交通卡」行，断言仍为「暂不支持」轻提示且不跳转\"\n    expected_result: \"新老链路互通；四个未改卡种行为保持不变。\"\n    ut_layer: device\n    device_focus: \"既有路由回归 + 未改卡种行为不变（该断言横跨多屏，逐边覆盖已由 AC-1/AC-2/AC-11 的 checkpoint 承担）\"\n    linked_branch: \"通用 · 路由回归\"\n\nboundaries:\n  - id: BD-1\n    prd_exception: E1\n    scenario: \"银行列表为空\"\n    description: \"仓储层返回空数组时三张列表页的降级渲染\"\n    handling: \"渲染空态占位文案；不渲染更多药丸、查看全部银行与字母索引条\"\n    expected_behavior: \"页面可见「暂无可选银行」，无崩溃、无空白卡壳\"\n    ut_layer: both\n    ut_focus: \"空列表输入下页面状态与派生数据（可见行、药丸银行、索引字母）均为空\"\n    device_focus: \"空态占位文案在真机上可见，且药丸/索引条确实不渲染\"\n\n  - id: BD-2\n    prd_exception: E2\n    scenario: \"银行列表读取失败\"\n    description: \"仓储层在初始化或读取时抛异常\"\n    handling: \"在页面加载入口与仓储层调用处均 catch 异常并记录日志，随后走空态版面\"\n    expected_behavior: \"轻提示「银行列表加载失败」；无未捕获 rejection；页面不白屏\"\n    ut_layer: both\n    ut_focus: \"初始化与读取两条路径的异常均被捕获（逐词覆盖「初始化」与「读取」两侧）\"\n    device_focus: \"真机上出现加载失败轻提示且页面保持可交互\"\n\n  - id: BD-3\n    prd_exception: E3\n    scenario: \"点击银行行时选卡类型半模态尚未实现\"\n    description: \"三张列表页中任一银行行的点击行为\"\n    handling: \"统一复用既有轻提示，不跳转、不改变导航栈\"\n    expected_behavior: \"出现「暂不支持」轻提示，页面停留原处\"\n    ut_layer: device\n    device_focus: \"三张页面上的选行行为一致\"\n\n  - id: BD-4\n    prd_exception: E4\n    scenario: \"点击搜索框或搜索按钮\"\n    description: \"搜索功能本轮不实现\"\n    handling: \"复用既有轻提示，不进入搜索态、不过滤列表\"\n    expected_behavior: \"出现「暂不支持」轻提示，列表内容与滚动位置不变\"\n    ut_layer: device\n    device_focus: \"搜索入口的降级行为\"\n\n  - id: BD-5\n    prd_exception: E5\n    scenario: \"剩余银行不足 5 个\"\n    description: \"大屏机型上可见行数增多，导致剩余银行少于 5 家\"\n    handling: \"药丸只展示实际剩余数量的小图标；剩余为 0 时整个药丸不渲染\"\n    expected_behavior: \"药丸图标数 = min(5, 剩余银行数)；剩余为 0 时无药丸\"\n    ut_layer: unit\n    ut_focus: \"可见行数 → 剩余银行 → 药丸图标数 的派生函数在 0/1/5/更多 各档的输出\"\n\n  - id: BD-6\n    prd_exception: E6\n    scenario: \"某字母无对应银行\"\n    description: \"A、C、D、E 等字母在本轮 20 家 mock 下无银行\"\n    handling: \"该字母不进入索引条，也不渲染分组标签与分组白卡\"\n    expected_behavior: \"索引条恰为 11 个字母；页面无空分组\"\n    ut_layer: both\n    ut_focus: \"索引字母集合 = 分组结果的键集合，且不含空组\"\n    device_focus: \"真机上索引条字母数量与分组标签数量一致\"\n\n  - id: BD-7\n    prd_exception: E7\n    scenario: \"重复点击「更多」\"\n    description: \"已处于展开态时再次触发展开动作\"\n    handling: \"幂等：保持展开态，不叠加导航栈、不重复加载数据\"\n    expected_behavior: \"页面仍为展开态，导航栈深度不变\"\n    ut_layer: both\n    ut_focus: \"展开状态切换函数的幂等性\"\n    device_focus: \"连续两次触发后页面仍为展开态且可正常返回\"\n\n  - id: BD-8\n    prd_exception: E8\n    scenario: \"快速连点银行行\"\n    description: \"300ms 内多次点击同一行\"\n    handling: \"轻提示按既有实现自然合并，不产生多层浮层\"\n    expected_behavior: \"无浮层堆叠、无卡死，页面保持可交互\"\n    ut_layer: device\n    device_focus: \"连点后的界面稳定性\"\n\n  - id: BD-9\n    prd_exception: E9\n    scenario: \"系统返回手势或返回键\"\n    description: \"在两个新增页面上触发系统返回\"\n    handling: \"与页面内返回按钮走同一出栈逻辑\"\n    expected_behavior: \"只出栈一层，回到正确的上级页面，不重复出栈\"\n    ut_layer: device\n    device_focus: \"系统返回与页面内返回按钮的行为一致性\"\n\n  - id: BD-10\n    prd_exception: E10\n    scenario: \"字母索引点击到末尾分组\"\n    description: \"点击 Z（列表末尾分组）\"\n    handling: \"滚动到可滚动范围末端即停\"\n    expected_behavior: \"不越界、不异常回弹，Z 分组尽可能进入视口\"\n    ut_layer: device\n    device_focus: \"末尾分组定位的边界行为\"\n\nperformance:\n  - id: NFR-1\n    metric: \"添加银行卡页面首屏可见耗时\"\n    threshold: \"≤ 500ms\"\n  - id: NFR-2\n    metric: \"收起态 → 展开态切换耗时\"\n    threshold: \"≤ 300ms\"\n  - id: NFR-3\n    metric: \"查看全部银行 → 全部银行页面首帧耗时\"\n    threshold: \"≤ 300ms\"\n  - id: NFR-4\n    metric: \"展开态与全部银行页面滚动帧率\"\n    threshold: \"≥ 55 FPS\"\n  - id: NFR-5\n    metric: \"字母索引点击到目标分组进入视口耗时\"\n    threshold: \"≤ 300ms\"\n  - id: NFR-6\n    metric: \"两个新页面驻留时的内存增量\"\n    threshold: \"≤ 20MB\"\n\ncoverage_summary:\n  functions:\n    - id: F1\n      priority: P0\n      covered_by: [AC-3, AC-G1]\n    - id: F2\n      priority: P0\n      covered_by: [AC-4, AC-G2]\n    - id: F3\n      priority: P0\n      covered_by: [AC-5]\n    - id: F4\n      priority: P0\n      covered_by: [AC-6]\n    - id: F5\n      priority: P0\n      covered_by: [AC-7]\n    - id: F6\n      priority: P0\n      covered_by: [AC-8]\n    - id: F7\n      priority: P0\n      covered_by: [AC-9, AC-10]\n    - id: F8\n      priority: P0\n      covered_by: [AC-1, AC-2, AC-11, AC-15, AC-G4]\n    - id: F9\n      priority: P1\n      covered_by: [AC-12, AC-13, AC-G3]\n    - id: F10\n      priority: P1\n      covered_by: [AC-14]\n    - id: F11\n      priority: P2\n      covered_by: [AC-16]\n  p0_function_coverage: \"8/8 (100%)\"\n  p1_function_coverage: \"2/2 (100%)\"\n  p2_function_coverage: \"1/1 (100%)\"\n  criteria_total: 20\n  boundaries_total: 10\n  ut_layer_breakdown:\n    criteria:\n      unit: 3\n      device: 16\n      both: 1\n    boundaries:\n      unit: 1\n      device: 5\n      both: 4\n  p0_flow_denominator:\n    note: \"P0 ∧ ut_layer∈{device,both} ∧ 有 linked_flow 的 AC 共 11 条：AC-1…AC-11；AC-G4 为横跨多屏的回归断言，其逐边覆盖已由 AC-1/AC-2/AC-11 承担，故不单独注册 checkpoint。\"\n    ids: [AC-1, AC-2, AC-3, AC-4, AC-5, AC-6, AC-7, AC-8, AC-9, AC-10, AC-11]\n\r\n\n=== doc/features\\homepage\\acceptance.yaml ===\r\nfeature: homepage\r\nsource: doc/features/homepage/spec/spec.md\r\nversion: \"1.0\"\r\n\r\ncriteria:\r\n  - id: AC-1\r\n    prd_function: F1\r\n    priority: P0\r\n    description: 冷启动默认首页 Tab，无卡态各区块文案与参考图一致，顶栏仅可见 + 按钮\r\n    testable: true\r\n    verification_steps:\r\n      - 冷启动进入钱包应用\r\n      - 确认默认落在首页 Tab\r\n      - 对照 ref_home_no_card 检查顶栏、卡包区、宫格、消息、轮播与底 Tab\r\n    expected_result: 无卡首页布局与文案 1:1 对齐参考图；顶栏无手表/扫码按钮\r\n    ut_layer: device\r\n    device_focus: 首页无卡态全屏布局、顶栏仅 + 、卡包引导图文案、底 Tab 首页高亮\r\n\r\n  - id: AC-2\r\n    prd_function: F2\r\n    priority: P0\r\n    description: 有卡 mock 时首页卡包区展示卡片堆叠，其余与有卡参考图一致\r\n    testable: true\r\n    verification_steps:\r\n      - 配置 HomeRepository 返回有卡态\r\n      - 进入首页 Tab\r\n      - 对照 ref_home_with_card 检查卡堆叠与消息区\r\n    expected_result: 卡包区为卡片堆叠；消息为扣费成功 mock 文案\r\n    ut_layer: both\r\n    ut_focus: HomeRepository 有卡标记驱动 presentation 分支\r\n    device_focus: 卡堆叠视觉与 ref_home_with_card 一致；无卡引导图不可见\r\n\r\n  - id: AC-3\r\n    prd_function: F3\r\n    priority: P0\r\n    description: 底 Tab 首页/我的切换高亮正确，响应 ≤ 300 ms\r\n    testable: true\r\n    verification_steps:\r\n      - 在首页 Tab 点击「我的」\r\n      - 再点击「首页」\r\n      - 计时 Tab 切换反馈\r\n    expected_result: 高亮态与参考图一致；切换耗时 ≤ 300 ms\r\n    ut_layer: device\r\n    device_focus: 底 Tab 文案与图标高亮切换；MineTabPage/HomeTabPage 可见性\r\n\r\n  - id: AC-4\r\n    prd_function: F4\r\n    priority: P0\r\n    description: 首页顶栏 + 跳转至添加卡片页\r\n    testable: true\r\n    verification_steps:\r\n      - 在首页点击顶栏 +\r\n      - 确认目标页标题\r\n      - 返回首页\r\n    expected_result: 进入「添加卡片」页；返回后仍在首页 Tab\r\n    ut_layer: device\r\n    device_focus: navPathStack 跳转 AddCardEntryPage；顶栏 + 可点击\r\n\r\n  - id: AC-5\r\n    prd_function: F5\r\n    priority: P0\r\n    description: 「添加管理卡片」跳转至卡包页\r\n    testable: true\r\n    verification_steps:\r\n      - 在首页点击「添加管理卡片」\r\n      - 确认卡包页标题与列表\r\n    expected_result: 进入卡包页，布局与 ref_card_pack 一致\r\n    ut_layer: device\r\n    device_focus: pushPath 至 CardPackPage；卡包页顶栏与添加卡片行可见\r\n\r\n  - id: AC-6\r\n    prd_function: F9\r\n    priority: P0\r\n    description: 我的页布局与参考图一致，智闪横幅不可见\r\n    testable: true\r\n    verification_steps:\r\n      - 切换至我的 Tab\r\n      - 检查账号区、金融分组、设置分组\r\n      - 确认无智闪优化横幅\r\n    expected_result: 与 ref_mine 一致；mine_smart_flash_banner 未渲染\r\n    ut_layer: device\r\n    device_focus: MineTabPage 区块顺序与文案；defer 横幅区域空白\r\n\r\n  - id: AC-7\r\n    prd_function: F10\r\n    priority: P0\r\n    description: 未登录点击账号行确认后完成登录\r\n    testable: true\r\n    verification_steps:\r\n      - 确保未登录态\r\n      - 点击账号行并确认登录\r\n      - 观察账号展示变化\r\n    expected_result: LoginState 变为已登录；账号行展示 mock 已登录信息\r\n    ut_layer: both\r\n    ut_focus: AccountService.login 被调用；LoginState 与 UserProfile 更新\r\n    device_focus: 确认对话框出现；登录后账号行 UI 刷新\r\n\r\n  - id: AC-8\r\n    prd_function: F11\r\n    priority: P0\r\n    description: 已登录点击账号行确认后完成登出\r\n    testable: true\r\n    verification_steps:\r\n      - 确保已登录态\r\n      - 点击账号行并确认登出\r\n      - 观察账号展示变化\r\n    expected_result: LoginState 变为未登录；账号展示恢复未登录态\r\n    ut_layer: both\r\n    ut_focus: AccountService.logout 被调用；会话清理\r\n    device_focus: 确认对话框；登出后账号行 UI 恢复\r\n\r\n  - id: AC-9\r\n    prd_function: F12\r\n    priority: P0\r\n    description: 卡包页 + 与添加卡片行均进入添卡页，返回栈正确\r\n    testable: true\r\n    verification_steps:\r\n      - 进入卡包页\r\n      - 分别点击顶栏 + 与「添加卡片」行\r\n      - 使用返回验证栈\r\n    expected_result: 两次均进入添加卡片页；返回回到卡包页\r\n    ut_layer: device\r\n    device_focus: CardPackPage 双入口导航；返回键 pop 行为\r\n\r\n  - id: AC-10\r\n    prd_function: F13\r\n    priority: P0\r\n    description: 添卡页展示五类卡种与非本机卡片行，文案对齐参考图\r\n    testable: true\r\n    verification_steps:\r\n      - 进入添加卡片页\r\n      - 核对五类卡种副标题\r\n      - 核对非本机卡片行\r\n    expected_result: 与 ref_add_card 文案一致；五类卡种齐全\r\n    ut_layer: device\r\n    device_focus: AddCardEntryPage 列表项文案与图标色\r\n\r\n  - id: AC-11\r\n    prd_function: F6\r\n    priority: P1\r\n    description: 服务宫格三项及分页指示；有卡态无发红包项\r\n    testable: true\r\n    verification_steps:\r\n      - 分别查看无卡/有卡首页宫格\r\n      - 滑动宫格分页（若有）\r\n    expected_result: Huawei Card/信用卡还款/优惠加油可见；有卡态无发红包\r\n    ut_layer: device\r\n    device_focus: 宫格三项图标文案；service_grid_red_packet 未出现\r\n\r\n  - id: AC-12\r\n    prd_function: F7\r\n    priority: P1\r\n    description: 消息中心无卡/有卡文案分别正确\r\n    testable: true\r\n    verification_steps:\r\n      - 无卡态读消息行文案\r\n      - 有卡态读消息行含时间戳\r\n    expected_result: 无卡「欢迎使用钱包消息中心!」；有卡含扣费成功与时间戳\r\n    ut_layer: device\r\n    device_focus: message_center_text 逐字匹配 ui-spec\r\n\r\n  - id: AC-13\r\n    prd_function: F8\r\n    priority: P1\r\n    description: 更多服务轮播 3 条 mock 且指示点更新\r\n    testable: true\r\n    verification_steps:\r\n      - 观察轮播自动切换\r\n      - 手动滑动轮播\r\n      - 检查指示点\r\n    expected_result: 至少 3 条广告；指示点随当前项变化\r\n    ut_layer: device\r\n    device_focus: promo 轮播动画与 pager 指示点联动\r\n\r\n  - id: AC-14\r\n    prd_function: F14\r\n    priority: P1\r\n    description: 卡包/添卡入口均可拉起半模态并展示空态\r\n    testable: true\r\n    verification_steps:\r\n      - 从卡包点击「管理非本机卡片」\r\n      - 关闭后从添卡页点击「非本机卡片」\r\n    expected_result: 半模态标题、关闭钮、空态插画与「暂无非本机卡片」均可见\r\n    ut_layer: device\r\n    device_focus: ManageNonLocalSheet 自两入口拉起；空态 UI 对齐 ref_manage_non_local_sheet\r\n\r\n  - id: AC-15\r\n    prd_function: F14\r\n    priority: P1\r\n    description: 半模态关闭后回到触发页无栈残留\r\n    testable: true\r\n    verification_steps:\r\n      - 打开半模态\r\n      - 点击关闭\r\n      - 再次打开/返回\r\n    expected_result: 关闭后仍位于卡包或添卡页；无重复 Sheet 叠层\r\n    ut_layer: device\r\n    device_focus: Sheet dismiss 后底层页可交互；导航栈深度不变\r\n\r\n  - id: AC-16\r\n    prd_function: F13\r\n    priority: P1\r\n    description: 无非本机卡时添卡页计数为 0\r\n    testable: true\r\n    verification_steps:\r\n      - 确保无非本机卡 mock\r\n      - 进入添卡页读非本机卡片行尾数\r\n    expected_result: 计数显示 0\r\n    ut_layer: unit\r\n    ut_focus: CardRepository/添卡页 ViewModel 在非本机卡为空时返回 count=0\r\n\r\n  - id: AC-17\r\n    prd_function: F15\r\n    priority: P2\r\n    description: 未实现入口统一 Toast「暂不支持」\r\n    testable: true\r\n    verification_steps:\r\n      - 点击服务宫格项\r\n      - 点击我的页金融/设置项\r\n      - 点击添卡页卡种行\r\n    expected_result: 均弹出「暂不支持」Toast，应用不崩溃\r\n    ut_layer: device\r\n    device_focus: Toast 文案为「暂不支持」；点击后页面不跳转\r\n\r\n  - id: AC-18\r\n    prd_function: F1\r\n    priority: P1\r\n    description: 断网时首页仍可展示 mock 并完成导航\r\n    testable: true\r\n    verification_steps:\r\n      - 关闭设备网络\r\n      - 冷启动进入首页\r\n      - 执行 Tab 切换与进卡包\r\n    expected_result: mock 内容可见；Tab 与 pushPath 导航可用\r\n    ut_layer: both\r\n    ut_focus: HomeRepository 离线仍返回本地 mock\r\n    device_focus: 断网无白屏；可选弱网提示\r\n\r\n  - id: AC-19\r\n    prd_function: F1\r\n    priority: P0\r\n    description: 首页首屏加载 ≤ 1.5 s\r\n    testable: true\r\n    verification_steps:\r\n      - 冷启动计时至首页主内容可见\r\n      - 重复 3 次取均值\r\n    expected_result: 平均首屏时间 ≤ 1.5 s\r\n    ut_layer: device\r\n    device_focus: 真机计时首屏；主内容区（卡包+宫格）渲染完成\r\n\r\n  - id: AC-20\r\n    prd_function: F1\r\n    priority: P1\r\n    description: 首页纵向滚动帧率 ≥ 54 FPS\r\n    testable: true\r\n    verification_steps:\r\n      - 在首页快速纵向滑动 10 s\r\n      - 读取性能采样 FPS\r\n    expected_result: 采样均值 ≥ 54 FPS\r\n    ut_layer: device\r\n    device_focus: 真机性能工具或 harness 采样滚动流畅度\r\n\r\nboundaries:\r\n  - id: BD-1\r\n    prd_exception: E1\r\n    scenario: network_offline\r\n    description: 设备无网络连接\r\n    priority: P1\r\n    handling: 使用本地 mock 数据渲染，不阻塞主导航\r\n    expected_behavior: 首页/我的可展示；Tab 与二级页跳转可用；可选弱提示\r\n    affected_functions: [F1, F9]\r\n    ut_layer: both\r\n    ut_focus: Repository 离线分支返回缓存/mock\r\n    device_focus: 断网无白屏；导航与 Toast 仍可用\r\n\r\n  - id: BD-2\r\n    prd_exception: E2\r\n    scenario: empty_cards\r\n    description: 用户尚未添加任何卡片\r\n    priority: P0\r\n    handling: 首页展示无卡引导；卡包隐藏已开通卡片区\r\n    expected_behavior: 无卡引导图可见；卡包仅显示添卡入口\r\n    affected_functions: [F1, F12]\r\n    ut_layer: both\r\n    ut_focus: 有卡标记为 false 时 CardPack 列表为空\r\n    device_focus: home_no_card 态；卡包无已开通卡片区\r\n\r\n  - id: BD-3\r\n    prd_exception: E3\r\n    scenario: feature_not_supported\r\n    description: 用户点击未实现的服务/卡种/设置入口\r\n    priority: P2\r\n    handling: 统一 Toast，不跳转\r\n    expected_behavior: 弹出「暂不支持」；当前页不变\r\n    affected_functions: [F15]\r\n    ut_layer: device\r\n    device_focus: Toast 文案与无页面跳转\r\n\r\n  - id: BD-4\r\n    prd_exception: E4\r\n    scenario: login_cancelled\r\n    description: 未登录用户在登录确认框点取消\r\n    priority: P1\r\n    handling: 不调用 AccountService.login\r\n    expected_behavior: 保持未登录；账号行 UI 不变\r\n    affected_functions: [F10]\r\n    ut_layer: both\r\n    ut_focus: login 流程在取消分支不更新 LoginState\r\n    device_focus: 对话框关闭后仍显示未登录态\r\n\r\n  - id: BD-5\r\n    prd_exception: E5\r\n    scenario: no_non_local_cards\r\n    description: 钱包无非本机卡片数据\r\n    priority: P1\r\n    handling: 半模态展示空态；添卡页计数为 0\r\n    expected_behavior: 「暂无非本机卡片」；计数显示 0\r\n    affected_functions: [F13, F14]\r\n    ut_layer: both\r\n    ut_focus: 非本机卡列表为空时 count=0、sheet 空态\r\n    device_focus: 半模态空态插画与文案；添卡页计数 0\r\n\r\nperformance:\r\n  - id: NFR-1\r\n    metric: 页面首屏加载\r\n    threshold: \"<= 1.5\"\r\n    unit: s\r\n    description: 从进入首页 Tab 到主内容（卡包区+宫格）可见\r\n  - id: NFR-2\r\n    metric: 列表滚动帧率\r\n    threshold: \">= 54\"\r\n    unit: FPS\r\n    description: 首页纵向滚动 10 s 采样均值\r\n  - id: NFR-3\r\n    metric: 交互响应\r\n    threshold: \"<= 0.3\"\r\n    unit: s\r\n    description: Tab 切换与按钮点击至反馈\r\n\r\ncoverage_summary:\r\n  total_functions: 15\r\n  p0_functions: 10\r\n  p1_functions: 4\r\n  p2_functions: 1\r\n  criteria_count: 20\r\n  boundaries_count: 5\r\n  performance_count: 3\r\n  functions_with_ac:\r\n    - F1\r\n    - F2\r\n    - F3\r\n    - F4\r\n    - F5\r\n    - F6\r\n    - F7\r\n    - F8\r\n    - F9\r\n    - F10\r\n    - F11\r\n    - F12\r\n    - F13\r\n    - F14\r\n    - F15\r\n  uncovered_functions: []\r\n  p0_p1_coverage: \"15/15\"\r\n  notes: 每个 P0/P1 功能至少一条 AC；E1–E5 映射 BD-1–BD-5；NFR-1/NFR-2 对应 AC-19/AC-20\r\n\r\n=== facts template ===\r\n---\n# Context Exploration Gate — 阶段探索摘要（与 phase-completion-receipt 同目录落盘）\n# 路径：doc/features/<feature>/<phase>/context-exploration.md（默认，以 framework.config.json paths 为准）\n# 模板：framework/harness/templates/context-exploration.md\n# 机器门禁：check-* 校验 frontmatter + schema 1.1.0 量化阈值；语义审查见 verify-*.md behavior_* 检查项。\n# 行为规约：framework/skills/reference/agent-behavioral-principles.md（Research Sub-Phase 必读）\n#\nschema_version: \"1.1.0\"\nfeature: \"<feature-name>\"\nphase: \"<spec | plan | coding | review | ut>\"\nready_to_produce: false\nhas_blocker_coverage_risk: false\nkey_inputs_read:\n  - \"paths.module_catalog — 已读\"\n  - \"paths.glossary — 已读\"\n  - \"paths.architecture_md — 已读\"\n# 实际 Read/Grep 过的源码/实现文件（相对仓库根；harness 验证磁盘存在）\n# 格式=纯相对路径，禁止附加描述（\"路径 - 说明\" 会被当作路径整体校验而失败）；\n# 描述/原因写正文「已检视文件」表格。示例：\n#   source_code_paths:\n#     - src/main/ets/service/FooService.ets\n#     - src/main/ets/model/BarModel.ets\nsource_code_paths: []\n# subagent | sequential | minimal（复杂度越阈时禁止 minimal）\nexploration_mode: \"sequential\"\n# 变更意图（v2.10 exploration_strategy 分类器输入）\nchange_intent: \"feature\"\nestimated_loc_delta: 0\ntouches_layers: []\nadds_new_exports: false\nsingle_function_scope: false\n# 本次探索解锁、即将写入主产物的决策（1:1 对应后续章节/文件）\ndecisions_unlocked: []\nsubagents_used: \"\"\nsearches_performed_estimate: 0\nfiles_inspected_count: 0\n---\n\n## 探索预算与检索\n\n> 记录关键词、目录范围、目的；勿粘贴大段代码。\n\n- ...\n\n## 已检视文件与原因\n\n| 路径（相对仓库根） | 为何读 |\n|-------------------|--------|\n| ...               | ...    |\n\n## Code Facts（代码事实，BLOCKER 级必填）\n\n| 路径 | 发现的事实 | 对本阶段产出的影响 |\n|------|-----------|------------------|\n| ...  | ...       | ...              |\n\n## 关键结论（支撑本阶段产出）\n\n- ...\n\n## 覆盖风险（诚实声明）\n\n| 风险 | 处理 |\n|------|------|\n| ...  | 接受 / 待补 / BLOCKER |\n\n## 进入产出\n\n仅在 `ready_to_produce: true` 且 `has_blocker_coverage_risk: false` 时进入本阶段主产物撰写。\n完成 Research Sub-Phase 自检清单（见 agent-behavioral-principles.md）后再置 `ready_to_produce: true`。\n\r\n=== facts utility key expectations ===\r\n52:  baseline?: { established_by: string; fingerprint: string; dependencies: ResolutionDependency[] };\n58:  return crypto.createHash('sha256').update(raw.replace(/\\r\\n/g, '\\n').split(/^##\\s*phase_delta:/m)[0].trimEnd()).digest('hex');\n82:/** 匹配 `## phase_delta: <phase>` 小节直到下一个 `##` 标题或文末。 */\n85:  const re = new RegExp(`##\\\\s*phase_delta:\\\\s*${escaped}\\\\b([\\\\s\\\\S]*?)(?=\\\\n##\\\\s|$)`, merge ? 'gi' : 'i');\n129:      id: 'context_exploration_facts_phase_delta_missing',\n131:      description: 'facts.md 须含本阶段 `## phase_delta: <phase>` 增量节',\n134:      details: `未找到 \"## phase_delta: ${phase}\" 小节。`,\n135:      suggestion: `在 facts.md 末尾追加 \"## phase_delta: ${phase}\"，无新增事实须显式写 \"none\"（不得留空）。`,\n141:      id: 'context_exploration_facts_phase_delta_empty',\n143:      description: '`## phase_delta: <phase>` 节内容不得为空',\n146:      details: `\"## phase_delta: ${phase}\" 节存在但内容为空。`,\n152:    id: 'context_exploration_facts_phase_delta_present',\n154:    description: 'facts.md 本阶段 phase_delta 节已声明',\n157:    details: `\"## phase_delta: ${phase}\" 节已声明（${content.length} 字符）。`,\n184:  const schemaVersion = typeof fm.schema_version === 'string' ? fm.schema_version.trim() : '';\n196:      ? `保留已核基线正文及原身份，仅在 ## phase_delta: ${phase} 精确追加变化来源与事实；来源实际失效时回责任阶段重建，不只改run_id。`\n202:    const ledgerWarn = (id: string, details: string, suggestion = '来源不可读或不在项目内时无法自动补登记：确认该来源是否仍属本次探索面；仍需要就把它放回项目内并重跑建立阶段，否则从 facts 的 source_code_paths 去掉。追溯弱一级，不阻断本阶段。'): void => { results.push({ id, category: 'structure', description: 'facts 调用身份、来源与范围一致', severity: 'MAJOR', status: 'WARN', details, suggestion, affected_files: [relPath] }); };\n203:    const registrationSuggestion = (source: string): string => `可在 ## phase_delta: ${phase} 的「路径 | 事实 | 影响」表补一行 ${source} 以完善追溯；缺少登记只披露，不阻断本阶段。`;\n211:    const declared = Array.isArray(fm.source_code_paths) ? fm.source_code_paths.filter((source): source is string => typeof source === 'string') : [];\n216:      issue('context_exploration_facts_schema_version', '新事实须使用 1.1；旧 1.0 仅可经显式 baseline 承接');\n237:    const expectedPhase = invocation.baseline?.established_by ?? invocation.first_phase;\n261:    if (record.established_by !== expectedPhase || !expectedPhase || (!invocation.baseline && phase !== invocation.first_phase)) issue('context_exploration_facts_established_by_invalid', '建立资格必须来自首个实际调用或经验证的已有基线');\n263:      if (factsBaselineFingerprint(raw) !== invocation.baseline.fingerprint) issue('context_exploration_facts_baseline_stale', `facts 基线正文或原身份已变化；保留已核基线，在 ## phase_delta: ${phase} 精确追加当前变化来源与事实，不通过改正文或run_id洗新`);\n319:      id: 'context_exploration_facts_schema_version',\n321:      description: 'facts.md schema_version 须为 \"1.0\"',\n325:        `当前 schema_version=${fm.schema_version ?? '<missing>'}，期望 \"1.0\"（带引号的字符串）。` +\n327:        `最小合法 frontmatter：\\n---\\nschema_version: \"1.0\"\\nfeature: ${feature}\\nestablished_by: spec\\n---`,\n344:  const establishedBy = String((fm as Record<string, unknown>).established_by ?? '').trim();\n347:      id: 'context_exploration_facts_established_by_invalid',\n349:      description: 'facts.md frontmatter.established_by 须为旧出生协议的 spec 阶段',\n353:        `established_by=\"${establishedBy || '<missing>'}\"，旧出生协议期望 \"spec\"。` +\n354:        `在 frontmatter 顶层补一行，如：established_by: spec`,\n359:  if (fm.ready_to_produce !== true) {\n363:      description: 'facts.md ready_to_produce 须为 true 方可进入本阶段主产出',\n366:      details: `ready_to_produce=${fm.ready_to_produce ?? '<missing>'}`,\n391:        suggestion: `可在 ## phase_delta: ${phase} 的「路径 | 事实 | 影响」表补齐本阶段变化以完善追溯；缺少登记只披露，不阻断本阶段。` } : check));\n413:    if (feature && checks.some(check => check.status === 'FAIL' && ['context_exploration_facts_source_stale', 'context_exploration_facts_baseline_stale', 'context_exploration_facts_established_by_invalid'].includes(check.id))) {\n417:      for (const check of checks) if (check.status === 'FAIL' && ['context_exploration_facts_source_stale', 'context_exploration_facts_baseline_stale', 'context_exploration_facts_established_by_invalid'].includes(check.id) && owner) check.repair_owner = owner;\n453:      ? '本阶段负责建立 facts.md（frontmatter + Code Facts 表）；必须记录实际建立阶段，不补造 spec/change 执行。'\n","exit_code":0,"status":"completed"}}
