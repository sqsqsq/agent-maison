{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw 'doc/features/bc-openCard-1/contracts.yaml'; Get-Content -Raw 'doc/features/bc-openCard-1/plan/visual-parity.yaml'; Get-Content -Raw 'doc/features/homepage/contracts.yaml'\"","aggregated_output":"# contracts.yaml — bc-openCard-1（plan 阶段机器契约真源）\n# coding / code-review / business-ut / device-testing / harness 一律优先读本文件，避免与 plan.md 双源分叉。\nschema_version: \"1.0\"\nfeature: \"bc-openCard-1\"\nsource: \"doc/features/bc-openCard-1/plan/plan.md\"\nversion: \"1.0\"\n\nmodules:\n  - name: \"WalletMain\"\n    layer: \"02-Feature\"\n    format: \"HAR\"\n    change_type: \"modify\"\n    package_path: \"02-Feature/WalletMain\"\n    export_file: \"02-Feature/WalletMain/src/main/ets/index.ets\"\n  - name: \"Phone\"\n    layer: \"01-Product\"\n    format: \"HAP\"\n    change_type: \"modify\"\n    package_path: \"01-Product/Phone\"\n\n# 本轮不新增任何依赖边；下列为既有依赖现状的复述，oh-package.json5 一律不改。\nmodule_dependencies:\n  WalletMain:\n    - \"CommUI\"\n    - \"CommFunc\"\n  Phone:\n    - \"WalletMain\"\n    - \"CommFunc\"\n\ndata_models:\n  - name: \"BankInfo\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/data/model/BankInfo.ets\"\n    kind: \"interface\"\n    fields:\n      - { name: \"code\", type: \"string\", required: true }\n      - { name: \"name\", type: \"string\", required: true }\n      - { name: \"pinyin\", type: \"string\", required: true }\n      - { name: \"initial\", type: \"string\", required: true }\n      - { name: \"logo\", type: \"Resource\", required: true }\n      - { name: \"badgeRes\", type: \"Resource\", required: false }\n  - name: \"BankGroup\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/data/model/BankGroup.ets\"\n    kind: \"interface\"\n    fields:\n      - { name: \"letter\", type: \"string\", required: true }\n      - { name: \"banks\", type: \"BankInfo[]\", required: true }\n\ninterfaces:\n  - module: \"WalletMain\"\n    layer: \"data\"\n    file: \"02-Feature/WalletMain/src/main/ets/data/repository/BankRepository.ets\"\n    class: \"BankRepository\"\n    methods:\n      - name: \"getBanks\"\n        params: []\n        return: \"Promise<BankInfo[]>\"\n        async: true\n        description: >-\n          返回 20 家银行的模拟数据（编译期常量数组），顺序为 cmb icbc citic hxb ccb abc bocom\n          psbc spdb cmbc pab cgb cib bosh bobj bonj bonb bogz ceb boc；无网络、无 IPC、无数据库、\n          不读任何持久化介质；异步签名与既有 CardRepository 保持一致\n  - module: \"WalletMain\"\n    layer: \"domain\"\n    file: \"02-Feature/WalletMain/src/main/ets/domain/service/BankGroupService.ets\"\n    class: \"BankGroupService\"\n    methods:\n      - name: \"groupByInitial\"\n        params:\n          - { name: \"banks\", type: \"BankInfo[]\" }\n        return: \"BankGroup[]\"\n        async: false\n        description: >-\n          静态纯函数：按 initial 升序分块、块内按 pinyin 升序；空输入返回长度 0 的数组；\n          20 家银行的期望输出为 11 块 B1 G4 H1 J2 M1 N3 P2 S1 X1 Y1 Z3（AC-16）\n      - name: \"collectIndexLetters\"\n        params:\n          - { name: \"groups\", type: \"BankGroup[]\" }\n        return: \"string[]\"\n        async: false\n        description: >-\n          静态纯函数：索引字母集合 = 分块键序，与分组键集合逐一相等，天然不含空分块字母（BD-7）\n      - name: \"calcVisibleRowCount\"\n        params:\n          - { name: \"availableHeightVp\", type: \"number\" }\n          - { name: \"rowHeightVp\", type: \"number\" }\n          - { name: \"pillBlockHeightVp\", type: \"number\" }\n          - { name: \"totalBanks\", type: \"number\" }\n        return: \"number\"\n        async: false\n        description: >-\n          静态纯函数：收起态可见行数 = floor((availableHeightVp - pillBlockHeightVp) / rowHeightVp)，\n          clamp 到 [0, totalBanks]；参考视口 1320x2120 下结果为 7\n      - name: \"calcPillIconCount\"\n        params:\n          - { name: \"totalBanks\", type: \"number\" }\n          - { name: \"visibleRowCount\", type: \"number\" }\n          - { name: \"maxIcons\", type: \"number\" }\n        return: \"number\"\n        async: false\n        description: >-\n          静态纯函数：药丸小图标数 = min(maxIcons, totalBanks - visibleRowCount)，下限 0；\n          为 0 时整个药丸不渲染\n\ncomponents:\n  - name: \"AddBankCardPage\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/pages/AddBankCardPage.ets\"\n    kind: \"page\"\n    decorator: \"@Component\"\n    nav_destination: \"AddBankCardPage\"\n    linked_functions:\n      - \"buildAddBankCardPage\"\n    state:\n      - { name: \"banks\", decorator: \"@State\", type: \"BankInfo[]\" }\n      - { name: \"expanded\", decorator: \"@State\", type: \"boolean\" }\n      - { name: \"availableHeightVp\", decorator: \"@State\", type: \"number\" }\n      - { name: \"loadFailed\", decorator: \"@State\", type: \"boolean\" }\n      - { name: \"lastNavAtMs\", decorator: \"private\", type: \"number\" }\n      - { name: \"lastToastAtMs\", decorator: \"private\", type: \"number\" }\n    children:\n      - \"BankListRow\"\n    description: >-\n      添加银行卡页面：收起态与展开态是同一路由的两个形态（expanded 状态位切换，不入栈，\n      从全部银行页返回后仍保持展开态）。页面容器为 NavDestination + hideTitleBar(true) + 自绘导航条，\n      返回按钮与 onBackPressed 均调用 NavPathContext.stack().pop()。\n      「更多」药丸与收起态白卡以页面内 @Builder 承载，不单独建组件文件。\n      拥有的 element id：col_root / col_nav_bar / col_back_btn / col_page_title / col_subtitle_left /\n      col_subtitle_right / col_bank_card / col_more_pill / col_pill_icon_psbc / col_pill_icon_spdb /\n      col_pill_icon_cmbc / col_pill_icon_pab / col_pill_icon_cgb / col_more_text / col_more_chevron /\n      exp_root / exp_nav_bar / exp_back_btn / exp_page_title / exp_subtitle_left / exp_subtitle_right /\n      exp_bank_card / exp_view_all_banks_btn（白卡内部最后一个子节点，不得渲染到卡外灰底上）。\n  - name: \"AllBanksPage\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/pages/AllBanksPage.ets\"\n    kind: \"page\"\n    decorator: \"@Component\"\n    nav_destination: \"AllBanksPage\"\n    linked_functions:\n      - \"buildAllBanksPage\"\n    state:\n      - { name: \"groups\", decorator: \"@State\", type: \"BankGroup[]\" }\n      - { name: \"indexLetters\", decorator: \"@State\", type: \"string[]\" }\n      - { name: \"loadFailed\", decorator: \"@State\", type: \"boolean\" }\n      - { name: \"listScroller\", decorator: \"private readonly\", type: \"Scroller\" }\n      - { name: \"lastToastAtMs\", decorator: \"private\", type: \"number\" }\n    children:\n      - \"BankListRow\"\n    description: >-\n      全部银行页面：A-Z 分组列表（List，每个字母一个 ListItem，内含字母标签 + 分组白卡）+\n      右缘竖排字母索引条（页面内 @Builder，不单独建组件文件）；字母点击经 listScroller.scrollToIndex\n      定位到对应分块。内容列右内缩 40vp、索引条宽 16vp 距右 4vp，两者 bounds 零相交（ui-spec forbidden_overlap）。\n      方向性参数一律用 start/end 与 Localized 系列入参以满足 RTL 镜像（UX-01）。\n      拥有的 element id：ab_root / ab_nav_bar / ab_back_btn / ab_page_title / ab_group_list /\n      ab_group_label_<L> × 11 / ab_group_card_<L> × 11 / ab_letter_index / ab_index_letter_<L> × 11，\n      <L> ∈ {B,G,H,J,M,N,P,S,X,Y,Z}。\n  - name: \"BankListRow\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/components/BankListRow.ets\"\n    kind: \"component\"\n    decorator: \"@Component\"\n    props:\n      - { name: \"bank\", decorator: \"@Prop\", type: \"BankInfo\" }\n      - { name: \"idPrefix\", decorator: \"@Prop\", type: \"string\" }\n      - { name: \"showDivider\", decorator: \"@Prop\", type: \"boolean\" }\n    events:\n      - name: \"onTap\"\n        description: >-\n          整行点击上抛（命名函数符号，非 inline lambda）；宿主页面收到后\n          showToast($r('app.string.not_supported'))，不跳转、不改变导航栈深度（AC-9 / AC-10）\n    description: >-\n      银行行（logo + 名称 + 可选营销角标 + 右箭头），收起态 / 展开态 / 全部银行页三屏共用。\n      logo 资源缺失时该行仍可见可点击，仅图位为空（BD-5）。行下分割线左内缩 52vp，末行不渲染。\n      element id 由 idPrefix 与 bank.code 拼装：<idPrefix>_row_<code> / <idPrefix>_logo_<code> /\n      <idPrefix>_name_<code> / <idPrefix>_chevron_<code>，角标为 <idPrefix>_badge_<code>（仅 hxb）；\n      idPrefix ∈ {col, exp, ab}。\n  - name: \"CardCategoryList\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/components/CardCategoryList.ets\"\n    kind: \"component\"\n    decorator: \"@Component\"\n    props:\n      - { name: \"categories\", decorator: \"@Prop\", type: \"CardCategory[]\" }\n    description: >-\n      既有组件，本轮修改两处：①id 为 c1 的「银行卡」行 onClick 由 showToast 改为\n      NavPathContext.stack().pushPath({ name: 'AddBankCardPage' })，其余四个卡种行行为一字不改；\n      ②五个卡种行补 element id：c1→ac_bank_card_row、c2→ac_transit_card_row、c3→ac_access_card_row、\n      c4→ac_car_key_row、c5→ac_id_card_row。\n  - name: \"AddCardEntryPage\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/pages/AddCardEntryPage.ets\"\n    kind: \"page\"\n    decorator: \"@Component\"\n    nav_destination: \"AddCardEntryPage\"\n    linked_functions:\n      - \"buildAddCardEntryPage\"\n    description: >-\n      既有页面，本轮修改两处：①.title() 由 ResourceStr 改为 CustomBuilder，内含\n      Text($r('app.string.add_card_title')).id('ac_page_title')，字号/字重按系统标题默认值\n      （20fp / FontWeight.Bold）对齐，文案与位置不变——这是让 AC-11 / AC-13 的身份断言有可\n      by_id 命中的节点所必需的最小改动；②非本机卡片入口行 id 由 non_local_cards_entry 更名为\n      ac_non_local_entry 以对齐 ui-spec。页面布局、数据、交互一律不改。\n  - name: \"CardPackPage\"\n    module: \"WalletMain\"\n    file: \"02-Feature/WalletMain/src/main/ets/presentation/pages/CardPackPage.ets\"\n    kind: \"page\"\n    decorator: \"@Component\"\n    nav_destination: \"CardPackPage\"\n    linked_functions:\n      - \"buildCardPackPage\"\n    description: >-\n      既有页面，本轮修改仅限补两个 element id：标题 Text 补 cp_page_title、\n      「添加卡片」入口行（pushPath 到 AddCardEntryPage 的那一行）补 cp_add_card_btn。\n      行为与版面一字不改，供 AC-11 老路由回归断言使用。\n  - name: \"Index\"\n    module: \"Phone\"\n    file: \"01-Product/Phone/src/main/ets/pages/index.ets\"\n    kind: \"page\"\n    decorator: \"@Entry\"\n    nav_destinations:\n      - \"CardPackPage\"\n      - \"AddCardEntryPage\"\n      - \"AddBankCardPage\"\n      - \"AllBanksPage\"\n    description: >-\n      应用入口根页，本轮修改仅限：从 @aspect/WalletMain 追加 import buildAddBankCardPage /\n      buildAllBanksPage，并在 navDestinationMap 追加两条 else if 分支\n      （AddBankCardPage → buildAddBankCardPage、AllBanksPage → buildAllBanksPage）。\n      Navigation / Tabs / floatingTabBar / NavPathContext.attach 一律不动。\n\nstate_management:\n  - { data: \"banks\", scope: \"AddBankCardPage 实例\", decorator: \"@State\", holder: \"AddBankCardPage\", module: \"WalletMain\" }\n  - { data: \"expanded\", scope: \"AddBankCardPage 实例\", decorator: \"@State\", holder: \"AddBankCardPage\", module: \"WalletMain\" }\n  - { data: \"availableHeightVp\", scope: \"AddBankCardPage 实例\", decorator: \"@State\", holder: \"AddBankCardPage\", module: \"WalletMain\" }\n  - { data: \"groups\", scope: \"AllBanksPage 实例\", decorator: \"@State\", holder: \"AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"indexLetters\", scope: \"AllBanksPage 实例\", decorator: \"@State\", holder: \"AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"loadFailed\", scope: \"页面实例\", decorator: \"@State\", holder: \"AddBankCardPage / AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"listScroller\", scope: \"AllBanksPage 实例\", decorator: \"private readonly\", holder: \"AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"lastNavAtMs\", scope: \"页面实例\", decorator: \"private\", holder: \"AddBankCardPage / AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"lastToastAtMs\", scope: \"页面实例\", decorator: \"private\", holder: \"AddBankCardPage / AllBanksPage\", module: \"WalletMain\" }\n  - { data: \"navPathStack\", scope: \"应用全局单栈\", decorator: \"NavPathContext.attach/stack\", holder: \"Phone 根页（既有，本轮只消费）\", module: \"Phone\" }\n\nnavigation:\n  config_files:\n    - \"02-Feature/WalletMain/src/main/resources/base/profile/route_map.json\"\n\nresource_keys:\n  WalletMain:\n    color:\n      - { key: \"bank_page_bg\", value: \"#F2F3F5\", description: \"页面底色（ui-spec token color.page_bg）\" }\n      - { key: \"bank_card_bg\", value: \"#FFFFFF\", description: \"白卡底色（color.card_bg）\" }\n      - { key: \"bank_text_primary\", value: \"#1A1A1A\", description: \"页面标题与银行行名（color.text_primary）\" }\n      - { key: \"bank_text_secondary\", value: \"#606163\", description: \"副标题 / 更多文案 / 字母标签（color.text_secondary）\" }\n      - { key: \"bank_line_divider\", value: \"#CCCCCC\", description: \"行间分割线（color.line_divider）\" }\n      - { key: \"bank_icon_chevron\", value: \"#CCCCCC\", description: \"行右箭头（color.icon_chevron）\" }\n      - { key: \"bank_nav_btn_bg\", value: \"#E7E8EA\", description: \"返回按钮圆底（color.nav_btn_bg）\" }\n      - { key: \"bank_pill_bg\", value: \"#F2F3F5\", description: \"更多药丸底色（color.pill_bg）\" }\n      - { key: \"bank_link_blue\", value: \"#1F57C8\", description: \"「查看全部银行」文字按钮（color.link_blue）\" }\n      - { key: \"bank_badge_border\", value: \"#D87639\", description: \"营销角标描边与文字（color.badge_border）\" }\n      - { key: \"bank_badge_bg\", value: \"#FFFBEF\", description: \"营销角标底色（color.badge_bg）\" }\n    float:\n      - { key: \"bank_font_page_title\", value: \"20fp\", description: \"页面标题字号（font.page_title）\" }\n      - { key: \"bank_font_row_title\", value: \"16fp\", description: \"银行行名字号（font.row_title）\" }\n      - { key: \"bank_font_caption\", value: \"14fp\", description: \"副标题 / 更多 / 查看全部银行字号（font.caption）\" }\n      - { key: \"bank_font_badge\", value: \"10fp\", description: \"营销角标字号（font.badge）\" }\n      - { key: \"bank_font_index_letter\", value: \"10fp\", description: \"索引字母字号（font.index_letter）\" }\n      - { key: \"bank_space_page_margin\", value: \"16vp\", description: \"页面左右边距（space.page_margin）\" }\n      - { key: \"bank_space_row_height\", value: \"56vp\", description: \"银行行高，可见行数派生的基数（space.row_height）\" }\n      - { key: \"bank_space_logo_size\", value: \"34vp\", description: \"行内 logo 边长（space.logo_size）\" }\n      - { key: \"bank_space_divider_inset\", value: \"52vp\", description: \"行间分割线左内缩（space.divider_inset）\" }\n      - { key: \"bank_space_row_inner_padding\", value: \"16vp\", description: \"行内左右内边距（space.row_inner_padding）\" }\n      - { key: \"bank_space_ab_content_right_margin\", value: \"40vp\", description: \"全部银行页内容列右内缩，为索引条让位（space.ab_content_right_margin）\" }\n      - { key: \"bank_space_ab_index_width\", value: \"16vp\", description: \"字母索引条宽度（space.ab_index_width）\" }\n      - { key: \"bank_space_group_label_height\", value: \"56vp\", description: \"字母标签块高（space.group_label_height）\" }\n      - { key: \"bank_radius_card\", value: \"16vp\", description: \"白卡圆角（radius.card）\" }\n      - { key: \"bank_radius_pill\", value: \"24vp\", description: \"更多药丸圆角（radius.pill）\" }\n      - { key: \"bank_space_pill_height\", value: \"32vp\", description: \"更多药丸自身高度（非 ui-spec token，由收起态 bbox 换算）\" }\n      - { key: \"bank_space_pill_block_height\", value: \"64vp\", description: \"药丸整块占位高（药丸 + 上下留白），可见行数算术的减数（非 ui-spec token，由收起态 bbox 换算）\" }\n    string:\n      - { key: \"add_bank_card_title\", value: \"添加银行卡\", description: \"添加银行卡页面标题（col_page_title / exp_page_title）\" }\n      - { key: \"add_bank_card_no_input\", value: \"免输卡号添卡\", description: \"左副标题（col_subtitle_left / exp_subtitle_left）\" }\n      - { key: \"add_bank_card_support_count\", value: \"支持 20 家银行\", description: \"右副标题（col_subtitle_right / exp_subtitle_right）\" }\n      - { key: \"bank_more\", value: \"更多\", description: \"收起态药丸文案（col_more_text）\" }\n      - { key: \"bank_view_all_banks\", value: \"查看全部银行\", description: \"展开态白卡内页脚（exp_view_all_banks_btn）\" }\n      - { key: \"all_banks_title\", value: \"全部银行\", description: \"全部银行页面标题（ab_page_title）\" }\n      - { key: \"bank_badge_first_bind\", value: \"首绑送12元券包\", description: \"华夏银行营销角标（F11 / AC-17）\" }\n      - { key: \"bank_list_empty\", value: \"暂无可添加的银行\", description: \"空态文案（E1 / BD-1）；不在 ui-spec 文本集内，coding 须登记 visible-text 豁免\" }\n      - { key: \"bank_list_load_failed\", value: \"银行列表加载失败，请稍后重试\", description: \"取数异常提示（E2 / BD-2）；不在 ui-spec 文本集内，coding 须登记 visible-text 豁免\" }\n      - { key: \"bank_nav_failed\", value: \"页面跳转失败，请重试\", description: \"取栈异常提示（E4 / BD-4）；不在 ui-spec 文本集内，coding 须登记 visible-text 豁免\" }\n    media:\n      - { key: \"bank_logo_cmb\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_cmb.png\", description: \"招商银行 logo（源 doc/features/bc-openCard-1/spec/assets/bank_logo_cmb.png）\" }\n      - { key: \"bank_logo_icbc\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_icbc.png\", description: \"工商银行 logo\" }\n      - { key: \"bank_logo_citic\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_citic.png\", description: \"中信银行 logo\" }\n      - { key: \"bank_logo_hxb\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_hxb.png\", description: \"华夏银行 logo\" }\n      - { key: \"bank_logo_ccb\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_ccb.png\", description: \"建设银行 logo\" }\n      - { key: \"bank_logo_abc\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_abc.png\", description: \"农业银行 logo\" }\n      - { key: \"bank_logo_bocom\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_bocom.png\", description: \"交通银行 logo\" }\n      - { key: \"bank_logo_psbc\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_psbc.png\", description: \"邮储银行 logo\" }\n      - { key: \"bank_logo_spdb\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_spdb.png\", description: \"浦发银行 logo\" }\n      - { key: \"bank_logo_cmbc\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_cmbc.png\", description: \"民生银行 logo\" }\n      - { key: \"bank_logo_pab\", media: \"02-Feature/WalletMain/src/main/resources/base/media/bank_logo_pab.png\", description: \"平安银行 logo\" }\n      - { key: \"bank