-card-opening-ui\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1123:    from: view:scenarios/node:open-card-user-journey\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1124:    to: view:logical/node:bank-card-opening-domain\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1135:    from: view:runtime/node:bank-card-opening-flow\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1136:    to: view:logical/node:bank-card-opening-domain\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1147:    from: view:development/node:bank-card-opening-ui\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1148:    to: view:runtime/node:bank-card-opening-flow\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1159:    from: view:development/node:bank-card-repository\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1160:    to: view:logical/node:bank-card-opening-domain\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1171:    from: view:development/node:phone-route-wiring\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1172:    to: view:development/node:bank-card-opening-ui\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1183:contracts:\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1184:  - contract_id: bank-card-persistence\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1517:      blueprint_refs: [view:scenarios/node:open-card-user-journey, view:runtime/node:bank-card-opening-flow, view:development/node:bank-card-opening-ui, contract:bank-card-persistence]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1519:      blueprint_refs: [view:development/node:bank-card-opening-ui, view:scenarios/node:open-card-user-journey]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1521:      blueprint_refs: [view:development/node:bank-card-opening-ui, view:scenarios/node:open-card-user-journey]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1523:      blueprint_refs: [view:development/node:bank-card-opening-ui, view:scenarios/node:open-card-user-journey]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1525:      blueprint_refs: [view:development/node:bank-card-opening-ui, view:scenarios/node:open-card-user-journey]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1551:    evidence_refs: [view:runtime/flow:persisted-bank-card-flow, 01-Product/Phone/src/main/ets/pages/index.ets]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1555:    evidence_refs: [contract:bank-card-persistence]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1559:    evidence_refs: [view:runtime/flow:persisted-bank-card-flow]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1563:    evidence_refs: [view:runtime/node:bank-card-opening-flow]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1567:    evidence_refs: [contract:bank-card-persistence, decision:single-opening-session]\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1569:    persistent_or_remote_ui: { applies: true, evidence_refs: [contract:bank-card-persistence] }\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1570:    multiple_consumers: { applies: true, evidence_refs: [view:runtime/flow:persisted-bank-card-flow] }\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1572:    cold_start_resume_mount_account_switch: { applies: true, evidence_refs: [view:runtime/flow:persisted-bank-card-flow] }\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1573:    user_mutation_refreshes_other_consumers: { applies: true, evidence_refs: [view:runtime/flow:persisted-bank-card-flow] }\ndoc/features/bc-openCard-2/blueprint/component-blueprint.yaml:1574:    cache_sync_freshness_consistency_process_recreation: { applies: true, evidence_refs: [contract:bank-card-persistence] }\n","exit_c