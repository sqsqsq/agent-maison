{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw '02-Feature/WalletMain/src/main/ets/data/model/BankInfo.ets'\"","aggregated_output":"/** 单家银行的展示数据（模拟数据，来源见 BankRepository） */\nexport interface BankInfo {\n  /** 银行短码，同时是 element id 后缀与 logo 资源键后缀，如 'cmb' */\n  code: string;\n  /** 银行显示名，如 '招商银行' */\n  name: string;\n  /** 汉语拼音全拼小写，用于块内升序排序，如 'zhaoshang' */\n  pinyin: string;\n  /** 拼音首字母大写，用于分块与字母索引，如 'Z' */\n  initial: string;\n  /** 品牌 logo 资源 */\n  logo: Resource;\n  /** 营销角标文案资源；无角标时为 undefined */\n  badgeRes?: Resource;\n}\n\r\n","exit_code":0,"status":"completed"}}
