: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_H\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_J\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_M\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_N\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_P\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_S\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_X\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_Y\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n    - ui_spec_node_id: ab_index_letter_Z\n      contract_component: AllBanksPage\n      ui_spec_screen: all_banks\n      contract_module: WalletMain\n\r\nfeature: homepage\r\nsource: doc/features/homepage/plan/plan.md\r\nversion: \"1.0\"\r\n\r\nmodules:\r\n  - name: WalletMain\r\n    layer: 02-Feature\r\n    format: HAR\r\n    change_type: modify\r\n    package_path: 02-Feature/WalletMain\r\n  - name: AccountManager\r\n    layer: 04-BusinessBase\r\n    format: HAR\r\n    change_type: modify\r\n    package_path: 04-BusinessBase/AccountManager\r\n\r\nmodule_dependencies:\r\n  WalletMain:\r\n    - AccountManager\r\n    - CommUI\r\n    - CommFunc\r\n  AccountManager:\r\n    - CommFunc\r\n\r\ndata_models:\r\n  - name: HomeCardDisplayMode\r\n    module: WalletMain\r\n    file: 02-Feature/WalletMain/src/main/ets/data/model/HomeCardState.ets\r\n    kind: enum\r\n    values:\r\n      - name: NO_CARD\r\n        value: no_card\r\n      - name: WITH_CARD\r\n        value: with_card\r\n  - name: MessageInfo\r\n    module: WalletMain\r\n    file: 02-Feature/WalletMain/src/main/ets/data/model/MessageInfo.ets\r\n    kind: interface\r\n    fields:\r\n      - name: text\r\n        type: Resource\r\n        required: true\r\n      - name: timestamp\r\n        type: Resource\r\n        required: false\r\n      - name: showUnreadDot\r\n        type: boolean\r\n        required: true\r\n  - name: ServiceEntry\r\n    module: WalletMain\r\n    file: 02-Feature/WalletMain/src/main/ets/data/model/ServiceEntry.ets\r\n    kind: interface\r\n    fields:\r\n      - name: id\r\n        type: string\r\n        required: true\r\n      - name: name\r\n        type: Resource\r\n        required: true\r\n      - name: icon\r\n        type: Resource\r\n        required: true\r\n  - name: UserProfile\r\n    module: AccountManager\r\n    file: 04-BusinessBase/AccountManager/src/main/ets/data/model/UserProfile.ets\r\n    kind: class\r\n    fields:\r\n      - name: isLoggedIn\r\n        type: boolean\r\n        required: true\r\n      - name: displayAccount\r\n        type: string\r\n        required: true\r\n      - name: avatar\r\n        type: Resource | null\r\n        required: false\r\n\r\ninterfaces:\r\n  - module: WalletMain\r\n    layer: data/repository\r\n    file: 02-Feature/WalletMain/src/main/ets/data/repository/HomeRepository.ets\r\n    class: HomeRepository\r\n    methods:\r\n      - name: getCardDisplayMode\r\n        params: []\r\n        return: Promise<HomeCardDisplayMode>\r\n        async: true\r\n        description: 返回无卡/有卡展示态 mock\r\n      - name: getServiceEntries\r\n        params:\r\n          - name: hasCard\r\n            type: boolean\r\n        return: Promise<ServiceEntry[]>\r\n        async: true\r\n        description: 服务宫格三项 mock\r\n      - name: getPromoList\r\n        params:\r\n          - name: hasCard\r\n            type: boolean\r\n        return: Promise<PromoInfo[]>\r\n        async: true\r\n        description: 至少 3 条轮播 mock\r\n      - name: getMessageInfo\r\n        params:\r\n          - name: mode\r\n            type: HomeCardDisplayMode\r\n        return: Promise<MessageInfo>\r\n        async: true\r\n        description: 消息中心无卡/有卡文案\r\n  - module: WalletMain\r\n    layer: data/repository\r\n    file: 02-Feature/WalletMain/src/main/ets/data/repository/CardRepository.ets\r\n    class: CardRepository\r\n    methods:\r\n      - name: getCardCategories\r\n        params: []\r\n        return: Promise<CardCategory[]>\r\n        async: true\r\n        description: 五类卡种\r\n      - name: getNonLocalCardCount\r\n        params: []\r\n        return: Promise<number>\r\n        async: true\r\n        description: 默认 0\r\n      - name: hasLocalCards\r\n        params: []\r\n        return: Promise<boolean>\r\n        async: true\r\n        description: 卡包已开通区是否展示\r\n  - module: AccountManager\r\n    layer: domain/service\r\n    file: 04-BusinessBase/AccountManager/src/main/ets/domain/service/AccountService.ets\r\n    class: AccountService\r\n    methods:\r\n      - name: login\r\n        params: []\r\n        return: Promise<UserProfile>\r\n        async: true\r\n        description: mock 登录成功\r\n      - name: logout\r\n        params: []\r\n        return: Promise<void>\r\n        async: true\r\n        description: 清理会话\r\n      - name: getUserProfile\r\n        params: []\r\n        return: Promise<UserProfile>\r\n        async: true\r\n        description: 读取 AppStorage 会话\r\n\r\ncomponents:\r\n  - name: HomeTabPage\r\n    module: WalletMain\r\n    file: 02-Feature/WalletMain/src/main/ets/presentation/pages/HomeTabPage.ets\r\n    kind: page\r\n    state:\r\n      - name: services\r\n        decorator: \"@State\"\r\n        type: ServiceEntry[]\r\n      - name: promo