embers_pattern_or_list\": [\n              \"CommFunc\"\n            ],\n            \"can_depend_on_sublayers\": []\n          }\n        ]\n      }\n    ],\n    \"module_inner_layers\": [\n      \"shared\",\n      \"data\",\n      \"domain\",\n      \"presentation\"\n    ],\n    \"inner_dependency_direction\": \"upward\",\n    \"cross_module_exports_file\": \"index.ets\"\n  },\n  \"paths\": {\n    \"features_dir\": \"doc/features\",\n    \"module_catalog\": \"doc/module-catalog.yaml\",\n    \"glossary\": \"doc/glossary.yaml\",\n    \"glossary_seed\": \"doc/glossary-seed.txt\",\n    \"architecture_md\": \"doc/architecture.md\",\n    \"state_file\": \"framework/harness/state/.current-phase.json\",\n    \"receipt_dir_pattern\": \"doc/features/<feature>/<phase>\",\n    \"reports_dir_pattern\": \"doc/features/<feature>/<phase>/reports\",\n    \"docs_committed\": false,\n    \"extension_dir\": \"doc/extensions\",\n    \"module_graphs_dir\": \"<module>/code-graph.yaml\",\n    \"agent_bundle_root\": \".agents\",\n    \"agent_bundle_skill_mode\": \"bridge\"\n  },\n  \"toolchain\": {\n    \"hvigor\": {\n      \"daemon\": true,\n      \"parallel\": true,\n      \"incremental\": true,\n      \"analyze\": \"advanced\"\n    }\n  },\n  \"state_machine\": {\n    \"grace_period_minutes\": 5,\n    \"ttl_hours\": 12,\n    \"max_consecutive_blocks\": 3,\n    \"schema_version\": \"1.1\"\n  },\n  \"spec\": {\n    \"visual_handoff_enforcement\": \"reachable\",\n    \"ui_spec_enforcement\": \"reachable\"\n  },\n  \"coding\": {\n    \"visual_parity_enforcement\": \"warn\"\n  },\n  \"active_workflow\": \"obligation-driven\",\n  \"lifecycle_hooks_enabled\": true,\n  \"tools\": {\n    \"hylyre\": {\n      \"vendor_dir\": \"framework/profiles/hmos-app/vendor/hylyre\",\n      \"venv_dir\": \".hylyre/venv\",\n      \"app_snapshot_cache_dir\": \"doc/app-snapshot-cache\",\n      \"pypi_extra_index_url\": \"https://mirrors.tools.huawei.com/pypi/simple\",\n      \"auto_install\": true,\n      \"doc