       - path: D:\\1.code\\SimulatedWalletForHmos\\04-BusinessBase\\AccountManager\\src\\main\\ets\\data\\model\\UserProfile.ets\n              exists: true\n              sha256: 1c81bfc6faa5cb81bc7bce2155e81db84be7bacae59dabcbda81e4aadb7ca366\n              role: derive\n            - path: D:\\1.code\\SimulatedWalletForHmos\\04-BusinessBase\\AccountManager\\src\\main\\ets\\domain\\service\\AccountService.ets\n              exists: true\n              sha256: 3af42a0b6baa6895bb91a6d66817c9546db2ef605d1b7e96a861d9c349c3be2b\n              role: derive\n            - path: D:\\1.code\\SimulatedWalletForHmos\\04-BusinessBase\\AccountManager\\src\\main\\ets\\index.ets\n              exists: true\n              sha256: 4f41856f439aeb2b26f8e748ad39992dbc1dbb049608c503e7867804a4e95662\n              role: derive\n          source_refs:\n            - 01-Product/Phone/src/main/ets/pages/index.ets\n            - 02-Feature/WalletMain/src/main/ets/data/model/BankInfo.ets\n            - 02-Feature/WalletMain/src/main/ets/data/repository/BankRepository.ets\n            - 02-Feature/WalletMain/src/main/ets/index.ets\n            - 02-Feature/WalletMain/src/main/ets/presentation/pages/AddBankCardPage.ets\n            - 02-Feature/WalletMain/src/main/ets/presentation/pages/AllBanksPage.ets\n            - 02-Feature/WalletMain/src/main/ets/presentation/pages/HomeTabPage.ets\n            - 02-Feature/WalletMain/src/main/ets/shared/constant/BankConstants.ets\n            - 02-Feature/WalletMain/src/main/resources/base/element/color.json\n            - 02-Feature/WalletMain/src/main/resources/base/element/float.json\n            - 02-Feature/WalletMain/src/main/resources/base/element/string.json\n            - 02-Feature/WalletMain/src/main/resources/base/profile/route_map.json\n            - 02-Feature/WalletMain/src/ohosTest/ets/test/bank_open_card_ut.test.ets\n            - 04-BusinessBase/AccountManager/src/main/ets/data/model/UserProfile.ets\n            - 04-BusinessBase/AccountManager/src/main/ets/domain/service/AccountService.ets\n            - 04-BusinessBase/AccountManager/src/main/ets/index.ets\n          content_fingerprint: a9d12ae4b4fc7b7070df3a923b6a7760aaa2dc33483ef9394671bc19d2397d47\n  contract_fingerprints:\n    - cb2ad91cc24a176ed34a87e534170c535883ab43c49c387f18728b2779adeeca\n    - 1699c507921c59f201d8c31d95991c4e2834a65b3d6f61352050e1fd7faf7e47\n    - 3a3f0d98e4b71bea6c4758ce8c95b29d27ecff5070e140b21cc5b32ef18c1098\n    - 4a58dc938b02f3120902bd2dd9a71c6b0c606528c37391d3a8d489c599a96930\n    - 7f14954ae8ce523af21a02485241f8ad2e7aa4e32a7d6acd993a9415b8fffd12\n    - 37b30f21691a9c8fe3aa2a7112f6778bb53d15d47e59b8dc99e7ecf8fb2d38e5\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw 'framework/profiles/hmos-app/skills/skill-assets.yaml'; Get-Content -Raw 'framework/specs/phase-rules/plan-rules.yaml'; Get-Content -Raw 'framework/profiles/hmos-app/phase-rules-overlays/plan-rules.overlay.yaml'; Get-Content -Raw 'framework/skills/feature/plan/contract.yaml'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw 'framework/profiles/hmos-app/skills/skill-assets.yaml'; Get-Content -Raw 'framework/specs/phase-rules/plan-rules.yaml'; Get-Content -Raw 'framework/profiles/hmos-app/phase-rules-overlays/plan-rules.overlay.yaml'; Get-Content -Raw 'framework/skills/feature/plan/contract.yaml'\"","aggregated_output":"# Profile-local Skill 资产清单（机器可读）\n# -----------------------------------------------------------------------------\n# 供根目录 framework/skills/**/SKILL.md 通过 `profile-skill-asset:<skill-id>/<key>` 动态解析。\n# 除下列「repo 根相对」键外，路径均相对 `framework/profiles/<profile>/skills/<skill-id>/`。\n# schema_version: \"1.0\"\n# -----------------------------------------------------------------------------\n\nschema_version: \"1.0\"\nprofile: hmos-app\n\nassets:\n  component-catalog-bootstrap:\n    component_card_template: templates/component-card-template.yaml\n    curate_component_prompt: prompts/curate-component.md\n  framework-init:\n    preset_5_layer_sample: templates/preset-5-layer.sample.json\n\n  code-graph:\n    code_graph_template: templates/code-graph-template.yaml\n    curate_core_prompt: prompts/curate-core-nodes.md\n\n  catalog-bootstrap:\n    examples_domain_mapping: examples-domain-mapping.md\n    # 兼容别名\n    examples_wallet_domain: examples-domain-mapping.md\n    module_card_template: templates/module-card-template.yaml\n    glossary_term_template: templates/glossary-term-template.yaml\n\n  spec:\n    spec_template: templates/spec-template.md\n    prd_template: templates/spec-template.md\n    ui_spec_template: templates/ui-spec-template.yaml\n    example_spec: examples/example-spec.md\n    example_prd: examples/example-spec.md\n    examples_spec_mapping: examples-spec-mapping.md\n\n  plan:\n    plan_template: templates/plan-template.md\n    design_template: templates/plan-template.md\n    api_spec_template: templates/api-spec.md\n    data_model_template: templates/data-model.md\n    example_plan: examples/example-plan.md\n    example_design: examples/example-plan.md\n\n  coding:\n    coding_standards: templates/coding-standards.md\n    module_scaffold: templates/module-scaffold.md\n    arkts_pitfalls: reference/arkts-pitfalls.md\n    arkui_patterns: reference/arkui-patterns.md\n    harmony_api_guide: reference/harmony-api-guide.md\n\n  code-review:\n    review_checklist: templates/review-checklist.md\n\n  business-ut:\n    use_cases_schema: templates/use-cases-schema.md\n    dag_schema: templates/dag-schema.md\n    ut_template: templates/ut-template.md\n    mock_strategy: templates/mock-strategy.md\n    testability_audit_template: templates/testability-audit-template.md\n    mock_plan_schema: templates/mock-plan-schema.md\n    coverage_evidence_schema: templates/coverage-evidence-schema.md\n    module_seam_registry_schema: templates/module-seam-mock-registry-schema.md\n    characterization_template: templates/characterization-template.md\n    format_contract: templates/format-contract.md\n    quick_plan_template: templates/quick-plan-template.yaml\n    context_extraction_protocol: templates/context-extraction-protocol.md\n    sample_flow_dir: examples/sample-flow\n    sample_flow_use_cases: examples/sample-flow/use-cases.yaml\n    # 兼容别名\n    card_opening_dir: examples/sample-flow\n    card_opening_use_cases: examples/sample-flow/use-cases.yaml\n\n  device-testing:\n    test_plan_template: templates/test-plan-template.md\n    test_plan_hylyre_template: templates/test-plan-hylyre-template.md\n    test_report_template: templates/test-report-template.md\n\r\n# P3: 显式 1.1 调用按 required_outputs 检查叙述格式；typed 内容、来源、授权和实际义务仍须校验。\n# ============================================================================\n# Plan 阶段规约 — profile 中立骨架（无 toolchain 细则）\n# ============================================================================\n# 设计文档中与宿主 UI / 导航模型相关的措辞细则在叠加层：\n#   framework/profiles/hmos-app/phase-rules-overlays/plan-rules.overlay.yaml\n#\n# 消费者：\n#   - framework/harness/scripts/check-plan.ts\n#   - framework/harness/prompts/verify-plan.md\n# ============================================================================\n\nphase: plan\nversion: \"1.0\"\napplies_to: \"doc/features/{module}/plan/plan.md\"\n\nstructure_checks:\n  acceptance_content_complete:\n    severity: BLOCKER\n    description: 显式 typed 验收须含可执行步骤、精确预期、合法 ID 与分层关注点。\n  design_scope_facts:\n    severity: BLOCKER\n    description: 新设计事实只经既有 P2 报告提议重签，不删除冻结 required 义务。\n  acceptance_use_cases_resolvable:\n    severity: BLOCKER\n    description: typed 验收的 linked_flow/linked_branch 必须指向真实用例。\n  construction_content_complete:\n    severity: BLOCKER\n    description: 施工文件、类型和接口签名须完整，不能用叙述省略减弱内容检查。\n  usecase_spec_schema:\n    severity: BLOCKER\n    description: 复用 UT 的 UseCasesSpec schema 检查，必要用例不能使用占位条目。\n\n\nsemantic_checks: {}\n\ntraceability_checks:\n  component_asset_selection:\n    severity: BLOCKER\n    description: 组件资产检查；语义见 docs/concepts/component-assets.md。\n  component_asset_projection:\n    severity: BLOCKER\n    description: 组件资产检查；语义见 docs/concepts/component-assets.md。\n  component_export_registered:\n    severity: BLOCKER\n    description: 组件资产检查；语义见 docs/concepts/component-assets.md。\n  component_new_static_checks:\n    severity: BLOCKER\n    description: 组件资产检查；语义见 docs/concepts/component-assets.md。\n  component_uncurated:\n    severity: MAJOR\n    description: 组件资产检查；语义见 docs/concepts/component-assets.md。\n\n  change_unit_feature_projection:\n    description: CU-bound Feature 必须以 canonical change_unit_ref 和完整 ID-only mappings 施工，且机械派生 use-case/DAG 义务\n    severity: BLOCKER\n  cu_scope_matches_blueprint:\n    description: CU-bound contracts.modules 必须 ⊆ 蓝图可修改模块集合（只由 CU touches 解析到 development 节点 module）；越界回 /component-design 调和\n    severity: BLOCKER\n  cu_architecture_impact_not_effective:\n    description: 相关 architecture_impact（add_module/move_module/dependency_edge）须已裁决且与当前 DSL 一致；dependency_edge 按 add/remove 核对目标许可\n    severity: BLOCKER\n  cu_architecture_dsl_other:\n    description: architecture_impact dsl_other 只登记不机检，提示人工核对已经权威批准落盘\n    severity: MAJOR\n  contract_file_reference_closure:\n    description: >\n      contracts.yaml 中的文件引用须能被统一解析为安全的工程内路径；\n      contracts.files 仅为实施预测，定位遗漏不单独阻断；引用不构成写授权，真实职责与授权边界仍按原检查核验\n    severity: BLOCKER\n  spec_constraint_traceability:\n    description: >\n      acceptance.yaml 中结构化 NFR/安全/性能/DFX 约束须在 plan.md 或 contracts.yaml 有实现引用\n    severity: BLOCKER\n\n# --------------------------------------------------------------------------\n# Context Exploration Gate 量化阈值（schema 1.1.0）\n# --------------------------------------------------------------------------\nexploration_thresholds:\n  min_files_inspected: 8\n  min_source_code_paths: 5\n  min_searches: 5\n  min_code_facts: 5\n  require_subagent_when_scope_gte: 2\n  exploration_mode_allowed:\n    - subagent\n    - sequential\n\n# --------------------------------------------------------------------------\n# Context Exploration 触发策略（v2.10 — plan default-on subagent）\n# --------------------------------------------------------------------------\nexploration_strategy:\n  default_mode: subagent\n  trivial_exemption:\n    enabled: true\n    conditions_any:\n      - intent: [rename, extract_function, move_file, typo_fix]\n      - prd_loc_delta_lt: 30\n      - single_function_scope: true\n  scoring:\n    threshold: 60\n    dimensions:\n      - id: module_loc\n        weight: 25\n        tiers:\n          - { gte: 50000, score: 25 }\n          - { gte: 20000, score: 15 }\n          - { gte: 5000, score: 8 }\n      - id: scope_breadth\n        weight: 20\n        tiers:\n          - { gte: 3, score: 20 }\n          - { gte: 2, score: 12 }\n          - { gte: 1, score: 5 }\n      - id: cross_layer\n        weight: 20\n        signal: touches_multiple_outer_layers\n        score_if_true: 20\n      - id: new_api_surface\n        weight: 15\n        signal: adds_exports_or_public_api\n        score_if_true: 15\n      - id: dependency_fan_out\n        weight: 20\n        tiers:\n          - { gte: 10, score: 20 }\n          - { gte: 5, score: 12 }\n          - { gte: 2, score: 5 }\n  sequential_multiplier: 2.0\n  sequential_min_files_inspected_add: 5\n\r\n# ----------------------------------------------------------------------------\n# hmos-app phase-rules overlay（合并到 framework/specs/phase-rules/plan-rules.yaml 骨架之上）\n# ----------------------------------------------------------------------------\n\n# ============================================================================\n# Plan 阶段规约 (Phase Rules)\n# ============================================================================\n# 定义实现计划（plan）（plan 产出）必须满足的通用规则。\n# 适用于所有功能模块的 <features_dir>/{module}/plan/plan.md。\n#\n# 消费者:\n#   - framework/harness/scripts/check-plan.ts  (脚本 Harness, 确定性检查)\n#   - framework/harness/prompts/verify-plan.md (AI Harness, 语义级检查)\n# ============================================================================\n\nphase: plan\nversion: \"1.0\"\napplies_to: \"<features_dir>/{module}/plan/plan.md\"\n\n# --------------------------------------------------------------------------\n# 结构约束 — 脚本 Harness 可自动检测\n# --------------------------------------------------------------------------\nstructure_checks:\n\n  required_chapters:\n    description: >\n      设计文档必须包含以下 9 个章节：\n      Scope 声明与继承、模块架构图、目录/文件结构规划、数据模型定义、页面组件树、\n      状态管理方案、服务层接口定义、路由/导航设计、功能映射表\n    severity: BLOCKER\n    rule:\n      expected_headings:\n        - \"Scope 声明\"\n        - \"模块架构图\"\n        - \"目录/文件结构规划\"\n        - \"数据模型定义\"\n        - \"页面组件树\"\n        - \"状态管理方案\"\n        - \"服务层接口定义\"\n        - \"路由/导航设计\"\n        - \"功能映射表\"\n      match: \"heading_text_contains\"\n\n  scope_declaration:\n    description: >\n      「Scope 声明与继承」章节必须包含 yaml 代码块，\n      定义 inherited_from_prd（legacy yaml 键名，机器字段保留）/\n      in_scope_modules / out_of_scope_modules /\n      rationale / expansions_with_user_approval 字段；\n      in_scope_modules 至少 1 项。\n    severity: BLOCKER\n    rule:\n      section: \"Scope 声明\"\n      expect: \"yaml_code_block\"\n      required_keys:\n        - \"in_scope_modules\"\n        - \"out_of_scope_modules\"\n        - \"rationale\"\n      min_items:\n        in_scope_modules: 1\n\n  scope_consistency_with_spec:\n    description: >\n      plan.in_scope_modules 必须是 spec.in_scope_modules ∪\n      expansions_with_user_approval.modules 的子集；\n      plan 不得在未经用户批准的情况下声明 spec.out_of_scope_modules 中的模块。\n      这是阻止 AI 自行扩大需求范围的核心 Scope 守门规则。\n    severity: BLOCKER\n    rule:\n      source: \"<features_dir>/{module}/spec/spec.md > Scope 声明 > yaml\"\n      target: \"<features_dir>/{module}/plan/plan.md > Scope 声明与继承 > yaml\"\n      assertions:\n        - \"plan.in_scope_modules ⊆ (spec.in_scope_modules ∪ plan.expansions_with_user_approval.modules)\"\n        - \"plan.in_scope_modules ∩ spec.out_of_scope_modules ⊆ plan.expansions_with_user_approval.modules\"\n\n  architecture_impact_declared:\n    description: >\n      plan.md 必须在 Scope 节（或其子节）声明「架构影响声明 (architecture_impact)」，\n      包含合法的 impact 枚举与配套字段，作为后续 plan_to_architecture /\n      architecture_doc_consistency 规则的前置触发开关。\n      impact 合法取值：none | dsl_change | module_set_change | responsibility_rewrite。\n      架构级变更的准确定义见 framework/skills/feature/plan/SKILL.md Step 12。\n    severity: BLOCKER\n    rule:\n      section: \"架构影响声明\"\n      expect: \"yaml_code_block\"\n      required_keys:\n        - \"impact\"\n        - \"affected_items\"\n        - \"architecture_md_updates\"\n        - \"catalog_updates\"\n      allowed_values:\n        impact:\n          - \"none\"\n          - \"dsl_change\"\n          - \"module_set_change\"\n          - \"responsibility_rewrite\"\n      conditional_required:\n        # impact != none 时 affected_items 与 architecture_md_updates 不允许为空\n        - when: \"impact != 'none'\"\n          non_empty:\n            - \"affected_items\"\n            - \"architecture_md_updates\"\n\n  architecture_diagram:\n    description: >\n      「模块架构图」章节必须包含至少一个 Mermaid 代码块，\n      展示模块间依赖关系\n    severity: BLOCKER\n    rule:\n      section: \"模块架构图\"\n      expect: \"mermaid_block\"\n\n  module_change_table:\n    description: >\n      必须包含模块变更摘要表，列明每个涉及模块的所属层、物理路径、\n      格式（HAP/HAR/HSP）、变更类型（新增/修改/迁移）\n    severity: BLOCKER\n    rule:\n      expect: \"markdown_table\"\n      required_columns:\n        - '\"模块\" or \"Module\"'\n        - \"所属层\"\n        - \"格式\"\n        - \"变更类型\"\n\n  file_structure_per_module:\n    description: >\n      每个涉及的模块必须有目录/文件结构规划，精确到 .ets 文件路径，\n      使用代码块展示树形结构\n    severity: BLOCKER\n    rule:\n      section: \"目录/文件结构规划\"\n      per_module:\n        expect: \"code_block_with_tree\"\n\n  data_model_typed:\n    description: >\n      数据模型定义必须使用 TypeScript/ArkTS 代码块，\n      包含字段名、类型、说明；不允许使用 any 类型\n    severity: BLOCKER\n    rule:\n      section: \"数据模型定义\"\n      expect: \"typescript_code_block\"\n      forbidden_types: [\"any\"]\n\n  interface_signatures_complete:\n    description: >\n      服务层接口定义中，所有方法必须包含完整的方法签名：\n      方法名、入参（名+类型）、返回类型、是否异步\n    severity: BLOCKER\n    rule:\n      section: \"服务层接口定义\"\n      per_method:\n        required_fields:\n          - \"method_name\"\n          - \"parameters_with_types\"\n          - \"return_type\"\n\n  component_tree_per_page:\n    description: >\n      每个页面必须有对应的组件树，使用树形文本图展示层级关系\n    severity: MAJOR\n    rule:\n      section: \"页面组件树\"\n      per_page:\n        expect: \"tree_diagram\"\n\n  spec_mapping_table:\n    description: >\n      「spec 功能映射表」必须是 Markdown 表格，至少包含\n      spec 编号、功能名称、优先级、实现模块、关键文件 五列\n    severity: BLOCKER\n    rule:\n      section: \"spec 功能映射表\"\n      expect: \"markdown_table\"\n      required_columns:\n        - '\"spec 编号\" or \"spec 功能编号\"'\n        - \"功能名称\"\n        - \"优先级\"\n        - \"实现模块\"\n        - \"关键文件\"\n\n  state_management_table:\n    description: >\n      「状态管理方案」章节必须包含状态分类表，列明数据、作用域、\n      使用的装饰器/机制、持有者\n    severity: MAJOR\n    rule:\n      section: \"状态管理方案\"\n      expect: \"markdown_table\"\n      required_columns:\n        - \"数据\"\n        - '\"装饰器\" or \"机制\"'\n\n  route_design_table:\n    description: >\n      「路由/导航设计」章节必须包含页面跳转关系表或 Mermaid 图，\n      明确每个 NavDestination 页面的名称和所属模块\n    severity: MAJOR\n    rule:\n      section: \"路由/导航设计\"\n      expect_any_of: [\"markdown_table\", \"mermaid_block\"]\n\n  metadata_header:\n    description: >\n      设计文档顶部必须包含模块标识、对应 spec 路径、版本、状态等元数据\n    severity: MINOR\n    rule:\n      expect: \"blockquote_metadata\"\n      required_fields:\n        - \"模块标识\"\n        - \"对应 spec\"\n        - \"版本\"\n        - \"状态\"\n\n  visual_parity_coverage:\n    description: >\n      ui_change 要求 UI 时 plan 须产出 plan/visual-parity.yaml，映射 ui-spec 每个\n      asset key / token key 到 contracts.resource_keys 与 components。\n    severity: MAJOR\n    rule:\n      expect: \"visual_parity_yaml\"\n      enforcement_config: \"framework.config.json#coding.visual_parity_enforcement\"\n\n# --------------------------------------------------------------------------\n# 语义约束 — AI Harness 做语义级检查\n# --------------------------------------------------------------------------\nsemantic_checks:\n\n  five_layer_compliance:\n    description: >\n      所有模块必须放在 framework.config.json 中声明的合法 outer layer 里，\n      且依赖方向遵循 architecture.outer_layers[].can_depend_on 矩阵；\n      同层内依赖按 intra_layer_deps 模式（forbid / dag / sublayer）裁决。\n      具体层名与方向由实例工程声明；framework 只守\"DAG、无自指、引用已声明层\"\n      等元规则。\n    severity: BLOCKER\n    ai_prompt_hint: >\n      审查模块架构图和依赖关系：(1) 每个模块是否在 outer_layers 声明的合法层里；\n      (2) 依赖箭头是否满足 can_depend_on 矩阵（自上而下或实例工程显式允许的方向）；\n      (3) 同层依赖是否符合 intra_layer_deps 的模式要求。\n\n  module_internal_layer_compliance:\n    description: >\n      每个模块的文件路径必须落在 framework.config.json 中\n      architecture.module_inner_layers 声明的内层之一；依赖方向按 upward\n      规则（索引大的层可依赖索引小的层）。参考实例默认\n      shared / data / domain / presentation 四层，其他实例可自行声明。\n    severity: BLOCKER\n    ai_prompt_hint: >\n      逐个文件检查路径是否落在实例工程声明的内层之一；\n      参考实例的典型分布（以 shared/data/domain/presentation 四层为例）：\n      常量→shared，模型→data/model，仓库→data/repository，\n      服务→domain/service，页面→presentation/pages，组件→presentation/components；\n      其他实例以 module_inner_layers 声明为准。\n\n  module_minimality:\n    description: >\n      仅创建 spec 功能实际需要的模块，不允许预创建无明确需求的模块\n    severity: MAJOR\n    ai_prompt_hint: >\n      检查每个新增模块是否有 spec 中的功能点直接驱动，\n      没有被 spec 功能引用的模块应被质疑\n\n  feature_split_accuracy:\n    description: >\n      功能拆分到模块的决策是否合理：\n      账号相关 → AccountManager，通用 UI → CommUI，\n      工具能力 → CommFunc，页面 UI → Feature 层对应模块\n    severity: MAJOR\n    ai_prompt_hint: >\n      逐条审查功能拆分表，判断每个功能点是否分配到了职责最匹配的模块\n\n  data_type_legality:\n    description: >\n      数据模型字段类型必须是 ArkTS 合法类型\n      （string、number、boolean、Resource、Array、枚举等），\n      不允许使用 any 或未定义的自造类型\n    severity: BLOCKER\n    ai_prompt_hint: >\n      审查所有数据模型定义中的字段类型，确认都是 ArkTS 合法类型\n\n  no_tbd_in_p0_p1:\n    description: >\n      P0/P1 范围内不允许存在\"待定\"、\"TBD\"、\"TODO\"等未决标记\n    severity: BLOCKER\n    ai_prompt_hint: >\n      搜索文档中所有 P0/P1 相关内容，检查是否存在 TBD/待定/TODO 标记\n\n  architecture_doc_consistency:\n    description: >\n      plan.md 中涉及的分层归属、跨模块依赖边、出口约定（cross_module_exports_file，如 index.ets）\n      必须与 doc/architecture.md 声明的外层 / 内层 / cross_module_exports_file 一致；\n      模块清单的行级一致性由 doc/module-catalog.yaml 承担，本规则不再校验。\n      若分层归属 / 依赖边 / 出口约定存在不一致且未在文档中说明差异原因，判为 FAIL。\n    severity: MAJOR\n    ai_prompt_hint: >\n      对比 plan.md 和 architecture.md 的「分层归属（外层 id）」、\n      「跨模块依赖边」、「出口约定（导出文件名与 config 一致）」，标出不一致之处；\n      **不要**比对业务模块清单的行级细节。\n\n  navigation_flow_consistency:\n    description: >\n      路由/导航设计中的页面跳转关系必须与 spec 中的业务流程图一致\n    severity: MAJOR\n    ai_prompt_hint: >\n      对比 plan.md 的路由设计和 spec 的业务流程图，\n      每条跳转路径是否都有对应\n\n# --------------------------------------------------------------------------\n# 追溯约束 — 脚本 + AI 联合检查\n# --------------------------------------------------------------------------\ntraceability_checks:\n\n  spec_p0_coverage:\n    description: >\n      spec 中每个 P0 功能点必须在「spec 功能映射表」中有至少一行映射\n    severity: BLOCKER\n    rule:\n      source: \"spec.md > 功能清单\"\n      filter: 'priority == \"P0\"'\n      target: \"plan.md > spec 功能映射表\"\n      link_field: \"spec 编号\"\n      coverage: \"100%\"\n\n  spec_p1_coverage:\n    description: >\n      spec 中每个 P1 功能点必须在映射表中有至少一行映射\n    severity: BLOCKER\n    rule:\n      source: \"spec.md > 功能清单\"\n      filter: 'priority == \"P1\"'\n      target: \"plan.md > spec 功能映射表\"\n      link_field: \"spec 编号\"\n      coverage: \"100%\"\n\n  mapping_to_file:\n    description: >\n      映射表中每行的「关键文件」必须能在「目录/文件结构规划」中找到\n    severity: BLOCKER\n    rule:\n      source: \"spec 功能映射表.关键文件\"\n      target: \"目录/文件结构规划\"\n      match: \"file_path_exists\"\n\n  acceptance_to_interface:\n    description: >\n      spec 的验收标准中涉及数据展示/操作的 AC 项，\n      应能在plan 文档的数据模型或接口定义中找到支撑\n    severity: MAJOR\n    ai_prompt_hint: >\n      对每条 spec 验收标准，判断 plan.md 中是否有对应的数据模型、\n      接口方法或组件来支撑该验收标准的实现\n\n  plan_to_architecture:\n    description: >\n      仅当 plan.md 声明 architecture_impact.impact != 'none' 时触发：\n      plan.md 在「架构影响声明」中声明的 architecture_md_updates\n      必须已在 doc/architecture.md 中落盘。\n      feature 级变更（impact == 'none'）不触发本规则，check 返回 SKIP，\n      架构文档无需同步（对应 plan Step 12 的重写条款）。\n    severity: MAJOR\n    rule:\n      precondition: \"plan.md > 架构影响声明 > impact != 'none'\"\n      source: \"plan.md > 架构影响声明 > architecture_md_updates\"\n      target: \"doc/architecture.md\"\n      expect: \"all_declared_updates_applied\"\n\r\nschema_version: \"1.1\"\nskill: plan\nskill_doc: SKILL.md\nphases:\n  plan:\n    inputs:\n      - { id: acceptance, sources: [{ kind: artifact, artifact: acceptance@1 }, { kind: derive, provider_id: derive.blueprint-acceptance }] }\n      - { id: codebase, sources: [{ kind: derive, provider_id: derive.codebase }] }\n      - { id: ui_spec, sources: [{ kind: artifact, artifact: ui-spec@1 }] }\n      - { id: contracts, sources: [{ kind: artifact, artifact: contracts@1 }, { kind: derive, provider_id: derive.blueprint-contracts }] }\n    capabilities:\n      - { id: capability_plan_context, axis: functional, inputs: [acceptance], input_role: base, on_missing: fail }\n      - { id: capability_plan_codebase, axis: functional, inputs: [codebase], input_role: enhancement, on_missing: prune }\n      - { id: capability_plan_existing_design, axis: functional, inputs: [contracts], input_role: enhancement, on_missing: prune }\n      - { id: capability_plan_visual_context, axis: visual, inputs: [ui_spec], input_role: enhancement, applicability_provider_id: applicability.ui, on_missing: prune }\n    produces:\n      - { artifact: plan@1 }\n      - { artifact: contracts@1 }\n      - { artifact: use-cases@1 }\n      - { artifact: visual-parity@1 }\n    verifies: { check: check-plan.ts }\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw 'framework/profiles/hmos-app/skills/plan/templates/plan-template.md'; Get-Content -Raw 'framework/profiles/hmos-app/skills/business-ut/templates/use-cases-schema.md'; Get-Content -Raw 'framework/profiles/hmos-app/skills/business-ut/examples/sample-flow/use-cases.yaml'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw 'framework/profiles/hmos-app/skills/plan/templates/plan-template.md'; Get-Content -Raw 'framework/profiles/hmos-app/skills/business-ut/templates/use-cases-schema.md'; Get-Content -Raw 'framework/profiles/hmos-app/skills/business-ut/examples/sample-flow/use-cases.yaml'\"","aggregated_output":"# {模块名称} — 实现计划（plan）\n\n> **模板说明**：本模板以宿主应用常见模块占位名（例如 `demo_home` / `FeatureDemoShell`）演示字段填法；实际工程请替换为 `catalog` / `framework.config.json` / `architecture.md` 中的真实模块标识。\n>\n> **模块标识**: `{module-name}`\n> **对应 spec**: `<features_dir>/{module-name}/spec/spec.md`\n> **版本**: v1.0\n> **创建日期**: {YYYY-MM-DD}\n> **最后更新**: {YYYY-MM-DD}\n> **状态**: 草稿 / 已确认\n>\n> **真源说明**：`plan.md` = 契约草案/来源（ephemeral）；`contracts.yaml` / `use-cases.yaml` = **机器契约真源**（coding / review / UT / harness 优先读取）。\n\n---\n\n## Scope 声明与继承\n\n> **本节继承自 spec 的 Scope 声明，并记录本 plan 阶段用户批准的扩展。**\n> coding 的 git diff 不得越界到 `in_scope_modules` 之外的模块。\n\n### Scope 概览\n\n| 字段 | 取值 | 说明 |\n|------|------|------|\n| 继承自 spec | `true` / `false` | 是否完全继承 spec 的 in_scope_modules（未扩展） |\n| 本计划允许修改的模块 | `{ModuleA}`、`{ModuleB}` | = spec.in_scope_modules ∪ expansions_with_user_approval |\n| 明确不修改的模块 | `{ModuleC}` | 继承自 spec.out_of_scope_modules |\n| 已获用户批准的扩展 | 见下方 yaml | 无扩展则留空数组 `[]` |\n\n### Scope 结构化字段（供 Harness 校验，必填）\n\n```yaml\ninherited_from_prd: true\nin_scope_modules:\n  - {ModuleA}\n  - {ModuleB}\nout_of_scope_modules:\n  - {ModuleC}\nrationale: |\n  本计划完全继承 spec 的 scope 声明，未发起扩展。\nexpansions_with_user_approval: []\n```\n\n> 机器字段 `inherited_from_prd` 为 harness 历史键名；语义上表示「继承自 spec」。\n\n### 架构影响声明 (architecture_impact)\n\n```yaml\narchitecture_impact:\n  impact: none\n  affected_items: []\n  architecture_md_updates: []\n  catalog_updates: []\n```\n\n> `impact` 合法取值：`none` | `dsl_change` | `module_set_change` | `responsibility_rewrite`。`impact != none` 时须在 plan Step 12 同步更新 `doc/architecture.md` 等活规格。\n\n---\n\n## 遵循的既有惯例（仅惯例文件存在时输出）\n\n> 惯例文件不存在时整节省略。只列本次适用项；有所引蓝图时须与蓝图适用惯例集合一致。\n\n| 惯例 id | 范例路径 | 计划落位 |\n|---|---|---|\n| `{convention-id}` | `{golden-example}` | `{project-relative-file-or-directory}` |\n\n---\n\n## 1. 模块架构图\n\n```mermaid\ngraph TD\n    phone[\"phone - HAP 主入口\"] --> feature_mod[\"{module_name}\"]\n    feature_mod --> common[\"common - HAR 公共模块\"]\n```\n\n| Module | 格式 | 变更类型 | 说明 |\n|--------|------|----------|------|\n| {module_name} | HAR | 新增/修改 | {一句话} |\n\n---\n\n## 2. 目录/文件结构规划\n\n| 路径 | 职责 | 新增/修改 |\n|------|------|-----------|\n| `{module}/src/main/ets/{path}/{File}.ets` | {职责} | 新增 |\n| `{module}/index.ets` | 模块导出 | 修改 |\n\n> 完整签名与类型细节落盘后以 `contracts.yaml` 为准；本节仅作人读草案。\n>\n> `contracts.files` 是实施预测，引用路径须合法但不必逐项登记为许可；真实边界取原请求、公共契约和阶段职责。实际源码、页面与路由由下游核验，必要的规格/架构变化交原 owner。\n\n---\n\n## 3. 数据模型定义\n\n| 模型 | 字段（摘要） | 说明 |\n|------|--------------|------|\n| `{ModelName}` | `{field}: {type}` | {用途} |\n\n---\n\n## 4. 页面组件树\n\n### 4.1 {PageName}\n\n```\n{PageName}\n├── {ChildA}\n└── {ChildB}\n```\n\n---\n\n## 5. 状态管理方案\n\n| 数据 | 作用域 | 装饰器/机制 | 持有者 | 生命周期 | 说明 |\n|------|--------|-------------|--------|----------|------|\n| `{domain}` | {scope} | {decorator_or_mechanism} | {holder} | {lifecycle} | {说明} |\n\n---\n\n## 6. 服务层接口定义\n\n| 接口 | 入参（摘要） | 出参（摘要） | 说明 |\n|------|--------------|--------------|------|\n| `{api.method}` | `{...}` | `{...}` | {说明} |\n\n---\n\n## 7. 路由/导航设计\n\n```mermaid\nflowchart LR\n    A[\"{PageA}\"] --> B[\"{PageB}\"]\n```\n\n| 页面 | NavDestination / 路由名 | 参数 | 说明 |\n|------|-------------------------|------|------|\n| {PageA} | `{route_a}` | — | {说明} |\n\n---\n\n## 8. spec 功能映射表\n\n逐项对照 spec 功能清单，确保每个 P0/P1 功能有实现落点（BLOCKER 追溯门禁目标端）。\n\n| spec 编号 | 功能名称 | 优先级 | 实现模块 | 实现层级 | 关键文件 | 实现说明 |\n|-----------|----------|--------|----------|----------|----------|----------|\n| F1 | {功能名} | P0 | {module} | {layer} | {file}.ets | {说明} |\n\n**覆盖率检查**：\n- P0: {X}/{Y}\n- P1: {X}/{Y}\n\n---\n\n## 宿主扩展（可选）\n\n鸿蒙专有细则（ArkUI 导航、能力权限、存储类型等）通过 `doc/extensions/knowledge/`（作者动笔前读；goal 模式下注入阶段 prompt）与 `phase_rules_overlays.plan`（harness 强制）叠加；`hooks/plan/on_context_load.md` 的片段只进 verifier 上下文，不会自动送达作者。\n\r\n# `use-cases.yaml` Schema 规范\n\n> 本文件定义 `<features_dir>/{module}/use-cases.yaml` 的 Schema。\n> **这是一份规约文档（spec），不是代码规格（code form spec）**。\n> 由 **plan（需求设计）** 在设计阶段按需产出，是业务级 UT（business-ut）做端到端分支覆盖的蓝图。\n\n## 定位澄清（避免再次翻车）\n\n- `use-cases.yaml` 描述**业务流经过哪些节点、分支、状态**，以及 **UI 事件 ↔ 业务入口** 的映射表\n- **不强制**为每个 `use_case` 创造 `.ets` 类 / `domain/usecase/` 目录 / Port 接口\n- 业务编排的代码形态由 **coding（编码）** 按实际复杂度选择——三种合法形态：\n  1. Page 上的**命名方法**（简单场景，默认首选）\n  2. Page 持有的**普通业务类**（Flow/Coordinator，多 UI 共享状态时用）\n  3. 模块级**导出函数**（纯计算流程）\n- 唯一硬约束：`ui_bindings.user_actions[].calls` 指向的目标必须是 **UT 可直接调用的命名函数**（不能只是 `.onClick(() => {...})` 里的 inline lambda）\n\n## 何时需要产出 `use-cases.yaml`（复杂度阈值）\n\n三条件**任一满足**才产出：\n\n1. 多个 UI 节点（页面 + 组件 ≥ 2）共享同一业务状态\n2. 多步云调用串行（≥ 2 次云端接口顺序依赖）\n3. 含回滚分支（某步失败需撤销前一步持久化）\n\n否则 `acceptance.yaml` + `dag.yaml` 足够，**不要产 `use-cases.yaml`，不要抽业务编排类**。\n\n## 完整 Schema\n\n```yaml\n# ============================================================================\n# 顶层必填字段\n# ============================================================================\nschema_version: \"2.0\"\nfeature: string                 # feature 名，与目录名一致，如 \"task-demo\"\n\n# ============================================================================\n# use_cases 列表\n# ============================================================================\nuse_cases:\n  - id: string                  # snake_case，feature 内唯一，如 \"task_submission\"\n    description: string         # 中文说明这条业务流做什么\n\n    # ------------------------------------------------------------------------\n    # coordinator：业务编排承载对象的名称\n    #   可为：\n    #     - 类名，如 \"TaskSubmitFlow\"\n    #     - 方法路径，如 \"HomeTabPage.triggerLoad\"（简单场景直接指向 Page 方法）\n    #     - 导出函数名，如 \"loadHomeData\"\n    # ------------------------------------------------------------------------\n    coordinator: string\n\n    # coordinator_file：承载文件相对路径（optional）\n    #   有独立业务类/函数时必填；指向 Page 命名方法时可省（文件由 ui_bindings 推导）\n    coordinator_file: string | null\n\n    # ------------------------------------------------------------------------\n    # ui_bindings：UI 节点 ↔ 业务入口的映射表 ★ 最关键字段\n    #   作用：\n    #     - 告诉 coding：哪些函数必须是命名方法（由 named_business_handler 强制）\n    #     - 告诉 business-ut：每条 UT 翻译成\"按 user_actions.calls 顺序 await 一遍\"\n    #     - 告诉 device-testing：role ∈ {progress, result} 且 user_actions 为空的 UI 交它\n    # ------------------------------------------------------------------------\n    ui_bindings:\n      - ui: string                           # 页面或组件名，如 \"TaskFormPage\"\n        role: \"entry | progress | dialog | result | passive\"\n        subscribes: [string]                 # 订阅的 state 字段，如 [\"flow.state.phase=WaitingOtp\"]\n\n        # user_actions：该 UI 上的用户触发事件\n        #   空数组表示该 UI 纯展示 → UT 不覆盖，交 device-testing 真机\n        user_actions:\n          - trigger: string                  # 中文描述用户动作，如 \"点击提交\"\n            calls: string                    # UT 要调用的命名函数，如 \"flow.submitTask\"\n                                             # ★ 必须是命名方法/导出函数，不能是 inline lambda\n\n    # ------------------------------------------------------------------------\n    # data_boundaries：业务编排依赖的外部数据源（替代旧 ports）\n    #   指向**现有**的 data 层类/模块，不要求新增 Port 接口\n    #   kind：cloud = 云端接口；storage = 本地持久化；system = 系统能力\n    # ------------------------------------------------------------------------\n    data_boundaries:\n      - name: string             # 在 coordinator 里的引用名，如 \"cloudApi\"\n        type: string             # 现有类名，如 \"RemoteTaskGateway\"\n        kind: \"cloud | storage | system\"\n        methods:                 # UT 要打桩的方法清单\n          - name: string\n            params: [string]\n            returns: string\n            async: boolean\n\n    # ------------------------------------------------------------------------\n    # state_model：业务流对外发布的 state（供 UI 订阅 & UT 断言）\n    # ------------------------------------------------------------------------\n    state_model:\n      phases: [string]           # 状态机阶段枚举，首元素约定为 \"Idle\"\n      fields:\n        - name: string\n          type: string\n\n    # ------------------------------------------------------------------------\n    # branches：业务分支清单——business-ut 按此 1:1 生成 UT it()\n    # ------------------------------------------------------------------------\n    branches:\n      - id: string               # snake_case，如 \"happy_path\"\n        scenario: string         # 中文描述该分支语义\n\n        # user_sequence：UT 按此顺序调用 ui_bindings.user_actions.calls\n        #   对应\"用户交互触发序列\"\n        user_sequence: [string]  # 如 [\"submitTask\", \"confirmOtp\"]\n\n        # cloud_stubs / local_stubs：按 data_boundaries 打桩\n        #   value 约定：\n        #     \"ok\"                 → 返回默认 ok 响应\n        #     \"ok_nonempty\"        → 返回非空列表\n        #     \"fail:<CODE>\"        → 返回失败响应，错误码为 CODE\n        #     \"throw[:<Error>]\"    → 抛异常\n        #     其他字面量           → 作为 payload 填入\n        cloud_stubs:\n          \"<boundary>.<method>\": string | object\n        local_stubs:\n          \"<boundary>.<method>\": string | object\n\n        # 期望序列与终态\n        expected_phase_seq: [string]         # phase 变化序列（含 Idle 起点）\n        expected_port_calls: [string]        # 期望的 boundary 调用顺序\n        expected_state:                      # 终态字段断言（除 phase 外）\n          \"<field>\": any\n        not_called: [string]                 # 禁止被调用的 boundary 方法\n        local_expect: [string]               # 期望 local_stubs 被调用的顺序（含回滚）\n\n        linked_acceptance: [string]          # 对应 AC / BD 编号，至少一条\n```\n\n## 强制规则\n\n1. **`ui_bindings` 必填**：至少一个 UI 条目；否则说明这条业务流不涉及 UI，不应进 `use-cases.yaml`。\n2. **`user_actions.calls` 必须命名**：不能是**匿名** inline lambda（直接挂载到 UI 事件）。合法形态含传统函数 / 类方法 / 类字段函数（`handleClick = async () => {}`）/ 顶层命名 const 赋值。由 coding `named_business_handler` 规则强制。\n3. **`data_boundaries.type` 指向现有类**：禁止为了 UT 新增抽象 Port 接口；现有 Repository/Service/SDK 类已经是自然边界。\n4. **`phases` 首元素为 `Idle`**：`expected_phase_seq` 从 `Idle` 开始。\n5. **branches 覆盖分支爆炸**：happy path + 每种可预期失败路径（云侧失败、本地失败、回滚路径）都列入。\n6. **`linked_acceptance` 不能为空**：若某分支暂无对应 AC，spec/2 先补 AC。\n7. **禁止 UI 副作用断言字段**（如 `expected_navigation` / `expected_toast`）：这类期望写到 `acceptance.yaml` > `device_focus`（spec）。\n\n## 与其他 Spec 的追溯关系\n\n```mermaid\nflowchart LR\n  SPEC[\"spec.md\"] --> AC[\"acceptance.yaml<br>criteria / boundaries<br>ut_layer\"]\n  DESIGN[\"plan.md\"] --> UC[\"use-cases.yaml<br>use_cases / branches<br>ui_bindings\"]\n  CODE[\"现有业务代码<br>Page / Repository / Flow\"] --> UC\n  AC -. \"ut_layer ∈ {unit, both}\" .-> UC\n  UC --> DAG[\"*.dag.yaml<br>use_case + branch\"]\n  DAG --> UT[\"*.test.ets<br>按 user_sequence 翻译\"]\n  AC -->|\"ut_layer ∈ {device, both}\"| DEV[\"acceptance.device_focus\"]\n  TODO --> S6[\"device-testing test-plan\"]\n```\n\n- `acceptance.yaml` 每条 `ut_layer ∈ {unit, both}` 的 AC / BD 必须在 `use-cases.yaml` 的 `branches[].linked_acceptance` 中被引用\n- 每条 `*.dag.yaml` 必须填 `use_case: <id>` 与 `branch: <branch_id>` 指回本文件\n- `coordinator` 所在文件里，`ui_bindings.user_actions.calls` 指向的每个目标必须以命名方法/导出函数存在（coding `named_business_handler` 核验）\n\n## 最小示例（多步业务流程）\n\n完整形态见 `` `profile-skill-asset:business-ut/sample_flow_use_cases` ``；下列为精简骨架：\n\n```yaml\nschema_version: \"2.0\"\nfeature: \"task-demo\"\n\nuse_cases:\n  - id: \"task_submission\"\n    description: \"远端校验 + 配额 + 本地写入 + 二次校验\"\n    coordinator: \"TaskSubmitFlow\"\n    coordinator_file: \"02-Feature/TaskDemo/src/main/ets/domain/flow/TaskSubmitFlow.ets\"\n\n    ui_bindings:\n      - ui: \"TaskFormPage\"\n        role: \"entry\"\n        subscribes: []\n        user_actions:\n          - { trigger: \"点击提交\", calls: \"flow.submitTask\" }\n      - ui: \"OtpSheetPage\"\n        role: \"dialog\"\n        subscribes: [\"flow.state.phase=WaitingOtp\"]\n        user_actions:\n          - { trigger: \"确认校验码\", calls: \"flow.confirmOtp\" }\n\n    data_boundaries:\n      - name: \"gateway\"\n        type: \"RemoteTaskGateway\"\n        kind: \"cloud\"\n        methods:\n          - { name: \"validateRequest\", params: [\"TaskPayload\"], returns: \"GateValidateResult\", async: true }\n          - { name: \"verifyOtpCode\", params: [\"string\", \"string\"], returns: \"OtpVerifyResult\", async: true }\n      - name: \"ledger\"\n        type: \"LocalTaskLedger\"\n        kind: \"storage\"\n        methods:\n          - { name: \"save\", params: [\"TaskRecord\"], returns: \"void\", async: true }\n\n    state_model:\n      phases: [Idle, Preparing, WaitingOtp, Verifying, Success, Failed]\n      fields:\n        - { name: \"errorCode\", type: \"string | null\" }\n\n    branches:\n      - id: \"happy_path\"\n        scenario: \"主路径成功\"\n        user_sequence: [\"submitTask\", \"confirmOtp\"]\n        cloud_stubs:\n          \"gateway.validateRequest\": \"ok\"\n          \"gateway.verifyOtpCode\": \"ok\"\n        local_stubs:\n          \"ledger.save\": \"ok\"\n        expected_phase_seq: [Idle, Preparing, WaitingOtp, Verifying, Success]\n        expected_port_calls: [\"gateway.validateRequest\", \"ledger.save\", \"gateway.verifyOtpCode\"]\n        linked_acceptance: [\"AC-1\"]\n```\n\n## 校验建议（Harness 做什么）\n\n| 检查项 | 归属 |\n|---|---|\n| `use-cases.yaml` 存在性按需触发（复杂度三条件） | `check-ut.ts : usecase_spec_optional` |\n| `use-cases.yaml` Schema 合规 | `check-ut.ts : usecase_spec_schema` |\n| `ui_bindings.user_actions.calls` 在代码中以命名方法存在 | `check-coding.ts : named_business_handler` |\n| `data_boundaries.type` 为 `contracts.yaml` 已登记类 | `check-ut.ts : boundary_matches_contracts` |\n| DAG 声明的 `use_case / branch` 在本文件存在 | `check-ut.ts : dag_linked_usecase` |\n| 每个 branch 有对应 `it()` | `check-ut.ts : branch_coverage_full` |\n| 每条 `ut_layer ∈ {unit, both}` 的 AC 被 branches 的 `linked_acceptance` 覆盖 | `check-ut.ts : ut_case_per_unit_ac` |\n| UT 文件 import 白名单 | `check-ut.ts : ut_import_whitelist` |\n| 语义质量（ui_bindings 完备 / handler 可达 / state 完备） | `verify-ut.md` |\n\r\n# ============================================================================\n# 示例：中性多步业务流程 Use Case 规约（v2.1）\n# 位置示意：doc/features/task-demo/use-cases.yaml\n# ============================================================================\nschema_version: \"2.1\"\nfeature: \"task-demo\"\n\nuse_cases:\n  - id: \"task_submission\"\n    description: \"任务提交完整流程：远程校验 → 申请资源配额 → 本地持久化 → 二次校验 → 激活/回滚\"\n\n    coordinator: \"TaskSubmitFlow\"\n    coordinator_file: \"02-Feature/TaskDemo/src/main/ets/domain/flow/TaskSubmitFlow.ets\"\n\n    ui_bindings:\n      - ui: \"TaskFormPage\"\n        role: \"entry\"\n        subscribes: []\n        user_actions:\n          - trigger: \"用户填写信息后点击提交\"\n            calls: \"flow.submitTask\"\n      - ui: \"TaskProgressPage\"\n        role: \"progress\"\n        subscribes:\n          - \"flow.state.phase\"\n        user_actions: []\n      - ui: \"OtpSheetPage\"\n        role: \"dialog\"\n        subscribes:\n          - \"flow.state.phase=WaitingOtp\"\n        user_actions:\n          - trigger: \"用户在对话框确认校验码\"\n            calls: \"flow.confirmOtp\"\n          - trigger: \"用户取消\"\n            calls: \"flow.cancel\"\n      - ui: \"TaskResultPage\"\n        role: \"result\"\n        subscribes:\n          - \"flow.state.phase=Success\"\n          - \"flow.state.phase=Failed\"\n          - \"flow.state.errorCode\"\n        user_actions: []\n\n    data_boundaries:\n      - name: \"gateway\"\n        type: \"RemoteTaskGateway\"\n        kind: \"cloud\"\n        methods:\n          - { name: \"validateRequest\",   params: [\"TaskPayload\"],         returns: \"GateValidateResult\", async: true }\n          - { name: \"allocateResource\",  params: [\"GateValidateResult\"], returns: \"AllocationResult\",  async: true }\n          - { name: \"verifyOtpCode\",     params: [\"string\", \"string\"],     returns: \"OtpVerifyResult\",   async: true }\n      - name: \"ledger\"\n        type: \"LocalTaskLedger\"\n        kind: \"storage\"\n        methods:\n          - { name: \"save\",     params: [\"TaskRecord\"], returns: \"void\", async: true }\n          - { name: \"update\",   params: [\"TaskRecord\"], returns: \"void\", async: true }\n          - { name: \"rollback\", params: [\"string\"],     returns: \"void\", async: true }\n\n    state_model:\n      phases: [Idle, Preparing, Applying, Persisting, WaitingOtp, Verifying, Success, Failed]\n      fields:\n        - { name: \"errorCode\",    type: \"string | null\" }\n        - { name: \"resultTaskId\", type: \"string | null\" }\n\n    branches:\n      - id: \"happy_path\"\n        scenario: \"端到端成功\"\n        setup:\n          \"gateway.validateRequest\":      \"ok\"\n          \"gateway.allocateResource\":      \"ok\"\n          \"gateway.verifyOtpCode\":         \"ok\"\n          \"ledger.save\":                   \"ok\"\n          \"ledger.update\":                 \"ok\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n          - { call: \"flow.confirmOtp\", with: { code: \"654321\" } }\n        expected_phase_sequence: [Idle, Preparing, Applying, Persisting, WaitingOtp, Verifying, Success]\n        expected_port_calls:\n          - \"gateway.validateRequest\"\n          - \"gateway.allocateResource\"\n          - \"ledger.save\"\n          - \"gateway.verifyOtpCode\"\n          - \"ledger.update\"\n        expected_state:\n          errorCode: \"null\"\n          resultTaskId: \"t1\"\n        linked_acceptance: [\"AC-1\"]\n\n      - id: \"validate_fail\"\n        scenario: \"远程校验拒绝\"\n        setup:\n          \"gateway.validateRequest\": \"fail:VAL_ERR\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n        expected_phase_sequence: [Idle, Preparing, Failed]\n        expected_port_calls: [\"gateway.validateRequest\"]\n        expected_state:\n          errorCode: \"VAL_ERR\"\n          resultTaskId: \"null\"\n        not_called:\n          - \"gateway.allocateResource\"\n          - \"ledger.save\"\n          - \"gateway.verifyOtpCode\"\n        linked_acceptance: [\"AC-2\"]\n\n      - id: \"apply_fail\"\n        scenario: \"配额申请失败\"\n        setup:\n          \"gateway.validateRequest\":     \"ok\"\n          \"gateway.allocateResource\":      \"fail:APPLY_ERR\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n        expected_phase_sequence: [Idle, Preparing, Applying, Failed]\n        expected_port_calls: [\"gateway.validateRequest\", \"gateway.allocateResource\"]\n        expected_state:\n          errorCode: \"APPLY_ERR\"\n        not_called:\n          - \"ledger.save\"\n          - \"gateway.verifyOtpCode\"\n        linked_acceptance: [\"AC-7\"]\n\n      - id: \"persist_fail\"\n        scenario: \"本地写入失败\"\n        setup:\n          \"gateway.validateRequest\":     \"ok\"\n          \"gateway.allocateResource\":      \"ok\"\n          \"ledger.save\":                   \"throw\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n        expected_phase_sequence: [Idle, Preparing, Applying, Persisting, Failed]\n        expected_port_calls: [\"gateway.validateRequest\", \"gateway.allocateResource\", \"ledger.save\"]\n        expected_state:\n          errorCode: \"PERSIST_ERR\"\n        not_called:\n          - \"gateway.verifyOtpCode\"\n          - \"ledger.update\"\n        linked_acceptance: [\"AC-4\"]\n\n      - id: \"otp_fail_rollback\"\n        scenario: \"二次校验失败，需回滚\"\n        setup:\n          \"gateway.validateRequest\":     \"ok\"\n          \"gateway.allocateResource\":      \"ok\"\n          \"ledger.save\":                   \"ok\"\n          \"gateway.verifyOtpCode\":         \"fail:OTP_ERR\"\n          \"ledger.rollback\":               \"ok\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n          - { call: \"flow.confirmOtp\", with: { code: \"000000\" } }\n        expected_phase_sequence: [Idle, Preparing, Applying, Persisting, WaitingOtp, Verifying, Failed]\n        expected_port_calls:\n          - \"gateway.validateRequest\"\n          - \"gateway.allocateResource\"\n          - \"ledger.save\"\n          - \"gateway.verifyOtpCode\"\n          - \"ledger.rollback\"\n        expected_state:\n          errorCode: \"OTP_ERR\"\n        not_called: [\"ledger.update\"]\n        linked_acceptance: [\"AC-3\"]\n\n      - id: \"user_cancel_in_waiting_otp\"\n        scenario: \"等待二次校验时用户取消\"\n        setup:\n          \"gateway.validateRequest\":     \"ok\"\n          \"gateway.allocateResource\":      \"ok\"\n          \"ledger.save\":                   \"ok\"\n          \"ledger.rollback\":               \"ok\"\n        triggers:\n          - { call: \"flow.submitTask\", with: { sku: \"SKU1\", actorId: \"u1\" } }\n          - { call: \"flow.cancel\",     with: {} }\n        expected_phase_sequence: [Idle, Preparing, Applying, Persisting, WaitingOtp, Failed]\n        expected_port_calls:\n          - \"gateway.validateRequest\"\n          - \"gateway.allocateResource\"\n          - \"ledger.save\"\n          - \"ledger.rollback\"\n        expected_state:\n          errorCode: \"USER_CANCELLED\"\n        not_called:\n          - \"gateway.verifyOtpCode\"\n          - \"ledger.update\"\n        linked_acceptance: [\"AC-6\"]\n\r\n","exit_code":0,"status":"completed"}}
