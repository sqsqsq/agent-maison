{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw '01-Product/Phone/src/main/ets/pages/index.ets'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"\"C:\\\\Users\\\\shengqsq\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw '01-Product/Phone/src/main/ets/pages/index.ets'\"","aggregated_output":"import { NavPathContext } from '@aspect/CommFunc';\nimport {\n  buildAddBankCardPage,\n  buildAddCardEntryPage,\n  buildAllBanksPage,\n  buildCardPackPage,\n  HomeTabPage,\n  MineTabPage\n} from '@aspect/WalletMain';\n\n@Entry\n@Component\nstruct Index {\n  @State navPathStack: NavPathStack = new NavPathStack();\n  @State currentTabIndex: number = 0;\n\n  aboutToAppear(): void {\n    NavPathContext.attach(this.navPathStack);\n  }\n\n  @Builder\n  navDestinationMap(name: string, _param: Object) {\n    if (name === 'CardPackPage') {\n      buildCardPackPage();\n    } else if (name === 'AddCardEntryPage') {\n      buildAddCardEntryPage();\n    } else if (name === 'AddBankCardPage') {\n      buildAddBankCardPage();\n    } else if (name === 'AllBanksPage') {\n      buildAllBanksPage();\n    }\n  }\n\n  @Builder\n  floatingTabBar() {\n    Row() {\n      Column({ space: 4 }) {\n        SymbolGlyph($r('sys.symbol.house_fill'))\n          .fontSize(22)\n          .fontColor([this.currentTabIndex === 0 ? $r('app.color.tab_selected') : $r('app.color.tab_unselected')])\n        Text($r('app.string.tab_home'))\n          .fontSize(12)\n          .fontColor(this.currentTabIndex === 0 ? $r('app.color.tab_selected') : $r('app.color.tab_unselected'))\n      }\n      .layoutWeight(1)\n      .onClick(() => {\n        this.currentTabIndex = 0;\n      })\n\n      Column({ space: 4 }) {\n        SymbolGlyph($r('sys.symbol.person_fill'))\n          .fontSize(22)\n          .fontColor([this.currentTabIndex === 1 ? $r('app.color.tab_selected') : $r('app.color.tab_unselected')])\n        Text($r('app.string.tab_mine'))\n          .fontSize(12)\n          .fontColor(this.currentTabIndex === 1 ? $r('app.color.tab_selected') : $r('app.color.tab_unselected'))\n      }\n      .layoutWeight(1)\n      .onClick(() => {\n        this.currentTabIndex = 1;\n      })\n    }\n    .width('92%')\n    .padding({ top: 8, bottom: 8 })\n    .margin({ left: '4%', right: '4%', bottom: 12 })\n    .backgroundColor(Color.White)\n    .borderRadius(28)\n    .shadow({ radius: 16, color: '#1A000000', offsetY: 4 })\n  }\n\n  build() {\n    Navigation(this.navPathStack) {\n      Stack({ alignContent: Alignment.Bottom }) {\n        Column() {\n          if (this.currentTabIndex === 0) {\n            HomeTabPage({ navPathStack: $navPathStack })\n          } else {\n            MineTabPage()\n          }\n        }\n        .width('100%')\n        .height('100%')\n        .padding({ bottom: 72 })\n\n        this.floatingTabBar()\n      }\n      .width('100%')\n      .height('100%')\n      .backgroundColor($r('app.color.phone_page_bg'))\n    }\n    .hideTitleBar(true)\n    .mode(NavigationMode.Stack)\n    .navDestination(this.navDestinationMap)\n  }\n}\n\r\n","exit_code":0,"status":"completed"}}
