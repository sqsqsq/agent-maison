\\"errorMessage\\\",\\\"type\\\":\\\"string\\\"}],\\\"return\\\":\\\"OpeningResult\\\"}]} 实际=undefined\\nBankRepository.<missing>: 期望={\\\"class\\\":\\\"BankRepository\\\",\\\"methods\\\":[{\\\"name\\\":\\\"getCards\\\",\\\"params\\\":[{\\\"name\\\":\\\"bankCode\\\",\\\"type\\\":\\\"string\\\"},{\\\"name\\\":\\\"cardType\\\",\\\"type\\\":\\\"BankCardType\\\"}],\\\"return\\\":\\\"Promise<BankCardCandidate[]>\\\"}]} 实际=undefined\\nOtpService.<missing>: 期望={\\\"class\\\":\\\"OtpService\\\",\\\"methods\\\":[{\\\"name\\\":\\\"sendMockCode\\\",\\\"params\\\":[{\\\"name\\\":\\\"mobile\\\",\\\"type\\\":\\\"string\\\"}],\\\"return\\\":\\\"Promise<void>\\\"}]} 实际=undefined\\nOpeningNavigationService.<missing>: 期望={\\\"class\\\":\\\"OpeningNavigationService\\\",\\\"methods\\\":[{\\\"name\\\":\\\"finish\\\",\\\"params\\\":[{\\\"name\\\":\\\"stack\\\",\\\"type\\\":\\\"NavPathStack\\\"},{\\\"name\\\":\\\"result\\\",\\\"type\\\":\\\"OpeningResult\\\"}],\\\"return\\\":\\\"void\\\"}]} 实际=undefined\\nAccountService.<missing>: 期望={\\\"class\\\":\\\"AccountService\\\",\\\"methods\\\":[{\\\"name\\\":\\\"getUserProfile\\\",\\\"params\\\":[],\\\"return\\\":\\\"Promise<UserProfile>\\\"}]} 实际=undefined\\nBankOpeningCompletionContext.<missing>: 期望={\\\"class\\\":\\\"BankOpeningCompletionContext\\\",\\\"methods\\\":[{\\\"name\\\":\\\"publish\\\",\\\"params\\\":[{\\\"name\\\":\\\"fullCardNumber\\\",\\\"type\\\":\\\"string\\\"}],\\\"return\\\":\\\"void\\\"},{\\\"name\\\":\\\"consume\\\",\\\"params\\\":[],\\\"return\\\":\\\"string|undefined\\\"},{\\\"name\\\":\\\"clear\\\",\\\"params\\\":[],\\\"return\\\":\\\"void\\\"}]} 实际=undefined\\nuse_cases:schema_version: 期望=\\\"1.0\\\" 实际=\\\"2.0\\\"\\nuse_cases:coordinator: 期望=\\\"BankCardOpeningService\\\" 实际=undefined\\nuse_cases:ui_bindings: 期望=[{\\\"ui\\\":\\\"AddBankCardPage|AllBanksPage\\\",\\\"role\\\":\\\"opening_entry\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_bank\\\",\\\"calls\\\":[\\\"openCardTypeSheet\\\"]}]},{\\\"ui\\\":\\\"BankCardSelectionPage\\\",\\\"role\\\":\\\"card_selection\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_next\\\",\\\"calls\\\":[\\\"openOtpVerificationSheet\\\"]}]},{\\\"ui\\\":\\\"BankCardOpeningResultPage\\\",\\\"role\\\":\\\"opening_result\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_finish\\\",\\\"calls\\\":[\\\"finishOpeningFlow\\\"]}]}] 实际=undefined\\nuse_cases:UC-1.<missing>: 期望={\\\"id\\\":\\\"UC-1\\\",\\\"name\\\":\\\"完成银行卡开卡\\\",\\\"coordinator\\\":\\\"BankCardOpeningService\\\",\\\"ui_bindings\\\":[{\\\"ui\\\":\\\"AddBankCardPage|AllBanksPage\\\",\\\"role\\\":\\\"entry\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_bank\\\",\\\"calls\\\":[\\\"openCardTypeSheet\\\"]}]},{\\\"ui\\\":\\\"BankCardSelectionPage\\\",\\\"role\\\":\\\"progress\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_next\\\",\\\"calls\\\":[\\\"openOtpVerificationSheet\\\"]}]},{\\\"ui\\\":\\\"OtpVerificationSheet\\\",\\\"role\\\":\\\"dialog\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"submit_otp\\\",\\\"calls\\\":[\\\"saveSelectedCard\\\"]}]},{\\\"ui\\\":\\\"BankCardOpeningResultPage\\\",\\\"role\\\":\\\"result\\\",\\\"user_actions\\\":[{\\\"trigger\\\":\\\"tap_finish\\\",\\\"calls\\\":[\\\"finishOpeningFlow\\\"]}]}],\\\"data_boundaries\\\":[{\\\"name\\\":\\\"BankCardRepository\\\",\\\"type\\\":\\\"BankCardRepository\\\",\\\"kind\\\":\\\"storage\\\",\\\"methods\\\":[\\\"save\\\",\\\"list\\\"]}],\\\"state_model\\\":{\\\"phases\\\":[\\\"ENTRY\\\",\\\"TYPE_SELECTED\\\",\\\"CARD_SELECTED\\\",\\\"OTP_ACTIVE\\\",\\\"SAVING\\\",\\\"RESULT\\\"]},\\\"branches\\\":[{\\\"scenario\\\":\\\"成功保存银行卡\\\",\\\"id\\\":\\\"BR-SUCCESS\\\",\\\"linked_acceptance\\\":[\\\"AC-1\\\",\\\"AC-2\\\",\\\"AC-3\\\",\\\"AC-4\\\",\\\"AC-5\\\"],\\\"expected_phase_seq\\\":[\\\"ENTRY\\\",\\\"TYPE_SELECTED\\\",\\\"CARD_SELECTED\\\",\\\"OTP_ACTIVE\\\",\\\"SAVING\\\",\\\"RESULT\\\"],\\\"expected_port_calls\\\":[\\\"BankRepository.getCards\\\",\\\"OtpService.sendMockCode\\\",\\\"BankCardRepository.save\\\",\\\"OpeningNavigationService.finish\\\"]},{\\\"scenario\\\":\\\"保存银行卡失败\\\",\\\"id\\\":\\\"BR-FAILURE\\\",\\\"linked_acceptance\\\":[\\\"AC-4\\\",\\\"AC-5\\\",\\\"BD-3\\\"],\\\"expected_phase_seq\\\":[\\\"ENTRY\\\",\\\"TYPE_SELECTED\\\",\\\"CARD_SELECTED\\\",\\\"OTP_ACTIVE\\\",\\\"SAVING\\\",\\\"RESULT\\\"],\\\"expected_port_calls\\\":[\\\"BankCardRepository.save\\\",\\\"OpeningNavigationService.finish\\\"]}]} 实际=undefined\",\r\n","exit_code":0,"status":"completed"}}
