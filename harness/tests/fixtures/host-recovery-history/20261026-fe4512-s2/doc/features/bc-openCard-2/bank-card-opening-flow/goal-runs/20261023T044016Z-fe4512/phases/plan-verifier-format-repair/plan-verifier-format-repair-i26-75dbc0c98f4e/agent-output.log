\"color_card_bg\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#FFFFFF\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_text_primary\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#1A1A1A\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_text_secondary\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#606163\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_line_divider\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#CCCCCC\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_icon_chevron\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#CCCCCC\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_nav_btn_bg\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#E7E8EA\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_pill_bg\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#F2F3F5\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_link_blue\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#1F57C8\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_badge_border\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#D87639\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"color_badge_bg\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#FFFBEF\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"opening_overlay_dim\\\\\\\",\\\\n      \\\\\\\"value\\\\\\\": \\\\\\\"#66000000\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\\n\\\\r\\\\n===== pitfalls headings =====\\\\r\\\\n1:# ArkTS / ArkUI 弱模型易错点对照手册\\\\n10:## 1. `@State` 必须初始化\\\\n39:## 2. `@Prop` vs `@Link` vs `@ObjectLink` 选错\\\\n70:## 3. `build()` 内不得有 `if/else` 外的 JS 控制流\\\\n94:## 4. `ForEach` 没写 keyGenerator\\\\n112:## 5. `LazyForEach` 必须搭配 `IDataSource` 实现\\\\n132:## 6. `$r()` 资源引用必须完全匹配资源文件里的 key\\\\n134:**症状**：用了资源 key 但没在 `resources/base/element/string.json` 等文件里登记，运行时黑屏或打印 `Resource is invalid`。\\\\n150:## 7. HAR/HSP 库模块必须通过 `Index.ets` 导出\\\\n172:## 8. `oh-package.json5` 的依赖路径格式\\\\n195:## 9. `Router` 和 `Navigation/NavPathStack` 不要混用\\\\n214:      .navDestination(this.destBuilder)\\\\n216:  @Builder destBuilder(name: string) {\\\\n224:## 10. `async/await` 只能用在 `build()` 之外\\\\n251:## 11. UI 文本必须用 `$r()` 而非硬编码中文字符串\\\\n270:## 12. 禁止使用 `any` 类型\\\\n293:## 13. `@Component` 的 struct 名必须 PascalCase 且与文件名一致\\\\n311:## 14. `AppStorage` / `LocalStorage` 的读写类型安全\\\\n330:## 15. 公共组件不要跨模块直接 import 内部路径\\\\n344:## 使用建议\\\\n\\\\r\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndoc/features/bc-openCard-2/bank-card-opening-flow\\\\goal-runs\\\\20261023T044016Z-fe4512\\\\phases\\\\coding\\\\agent-output.log:24:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_8\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"Research 已确认 CR-007 与目标一致：`ui-spec`/`ref-elements` 明确要求 `background_search_bank`，OCR 与观察侧车给出的结构是“左侧放大镜＋搜索银行、右侧分隔线＋蓝色搜索”，当前页面确实缺失。最小修复落在现有 `AddBankCardPage` 和字符串资源；不增加搜索业务状态或新依赖，避免把视觉补齐扩成未授权功能。\\\"}}\\ndoc/features/bc-openCard-2/bank-card-opening-flow\\\\goal-runs\\\\20261023T044016Z-fe4512\\\\phases\\\\coding\\\\agent-output.log:26:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"\\\\\\\"C:\\\\\\\\\\\\\\\\Users\\\\\\\\\\\\\\\\shengqsq\\\\\\\\\\\\\\\\.cache\\\\\\\\\\\\\\\\codex-runtimes\\\\\\\\\\\\\\\\codex-primary-runtime\\\\\\\\\\\\\\\\dependencies\\\\\\\\\\\\\\\\native\\\\\\\\\\\\\\\\powershell\\\\\\\\\\\\\\\\pwsh.exe\\\\\\\" -Command \\\\\\\"Get-Content 'framework/profiles/hmos-app/skills/coding/reference/arkts-pitfalls.md' | Select-Object -Skip 130 -First 40; Get-Content 'framework/profiles/hmos-app/skills/coding/reference/arkts-pitfalls.md' | Select-Object -Skip 248 -First 52; rg -n -C 5 \\\\\\\\\\\\\\\"资源|Builder|ArkUI|字符串|硬编码|SymbolGlyph\\\\\\\\\\\\\\\" 'framework/profiles/hmos-app/skills/coding/templates/coding-standards.md'; Get-Content -Raw 'doc/architecture.md'; rg -n -A 70 -B 5 \\\\\\\\\\\\\\\"name: WalletMain|module_id: WalletMain|WalletMain:\\\\\\\\\\\\\\\" 'doc/module-catalog.yaml'; rg -n -A 30 -B 5 \\\\\\\\\\\\\\\"term: 添卡|name: 添卡|首页\\\\\\\\\\\\\\\" 'doc/glossary.yaml'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\\r\\\\n## 6. `$r()` 资源引用必须完全匹配资源文件里的 key\\\\r\\\\n\\\\r\\\\n**症状**：用了资源 key 但没在 `resources/base/element/string.json` 等文件里登记，运行时黑屏或打印 `Resource is invalid`。\\\\r\\\\n\\\\r\\\\n```ts\\\\r\\\\n// ❌ 错：字符串拼接\\\\r\\\\nText($r(`app.string.${this.module}_title`))    // ArkTS 不允许动态资源 key\\\\r\\\\n\\\\r\\\\n// ❌ 错：资源 key 没在 string.json 里声明\\\\r\\\\nText($r('app.string.demo_row_title'))         // 若 string.json 里没有 demo_row_title 条目则报错\\\\r\\\\n\\\\r\\\\n// ✅ 对：静态字符串 + 已登记\\\\r\\\\n// resources/base/element/string.json 中必须有：{\\\\\\\"name\\\\\\\": \\\\\\\"demo_row_title\\\\\\\", \\\\\\\"value\\\\\\\": \\\\\\\"演示标题\\\\\\\"}\\\\r\\\\nText($r('app.string.demo_row_title'))\\\\r\\\\n```\\\\r\\\\n\\\\r\\\\n---\\\\r\\\\n\\\\r\\\\n## 7. HAR/HSP 库模块必须通过 `Index.ets` 导出\\\\r\\\\n\\\\r\\\\n**症状**：其他模块 `import { Foo } from '@hw/LedgerDemo'` 找不到符号。\\\\r\\\\n\\\\r\\\\n```ts\\\\r\\\\n// ❌ 错：直接从内部路径 import\\\\r\\\\nimport { EntryRepo } from '@hw/LedgerDemo/src/main/ets/data/repository/EntryRepo'\\\\r\\\\n\\\\r\\\\n// ❌ 错：Index.ets 不存在或没有 export\\\\r\\\\n// Index.ets 内容为空\\\\r\\\\n\\\\r\\\\n// ✅ 对：Index.ets 集中导出对外 API\\\\r\\\\n// Index.ets\\\\r\\\\nexport { EntryRepo } from './src/main/ets/data/repository/EntryRepo'\\\\r\\\\nexport type { LedgerRow } from './src/main/ets/data/model/LedgerRow'\\\\r\\\\n\\\\r\\\\n// 外部使用：\\\\r\\\\nimport { EntryRepo, LedgerRow } from '@hw/LedgerDemo'\\\\r\\\\n```\\\\r\\\\n\\\\r\\\\n---\\\\r\\\\n---\\\\r\\\\n\\\\r\\\\n## 11. UI 文本必须用 `$r()` 而非硬编码中文字符串\\\\r\\\\n\\\\r\\\\n**症状**：PR 里全是硬编码中文，Harness 的 `no_hardcoded_strings` 报 MAJOR。\\\\r\\\\n\\\\r\\\\n```ts\\\\r\\\\n// ❌ 错\\\\r\\\\nText('演示标题')\\\\r\\\\nButton('添加')\\\\r\\\\n\\\\r\\\\n// ✅ 对\\\\r\\\\nText($r('app.string.demo_row_title'))\\\\r\\\\nButton($r('app.string.common_add'))\\\\r\\\\n// resources/base/element/string.json 补上：\\\\r\\\\n// { \\\\\\\"name\\\\\\\": \\\\\\\"demo_row_title\\\\\\\", \\\\\\\"value\\\\\\\": \\\\\\\"演示标题\\\\\\\" }\\\\r\\\\n// { \\\\\\\"name\\\\\\\": \\\\\\\"common_add\\\\\\\", \\\\\\\"value\\\\\\\": \\\\\\\"添加\\\\\\\" }\\\\r\\\\n```\\\\r\\\\n\\\\r\\\\n---\\\\r\\\\n\\\\r\\\\n## 12. 禁止使用 `any` 类型\\\\r\\\\n\\\\r\\\\n**症状**：为了赶进度用 `any`，导致 Harness 的 `no_any_type` 报 MAJOR。弱模型常常在 \\\\\\\"不确定类型\\\\\\\" 时偷懒用 any。\\\\r\\\\n\\\\r\\\\n```ts\\\\r\\\\n// ❌ 错\\\\r\\\\nfunction handleData(data: any): any {\\\\r\\\\n  return data.list\\\\r\\\\n}\\\\r\\\\nconst items: any[] = []\\\\r\\\\n\\\\r\\\\n// ✅ 对：显式类型或泛型\\\\r\\\\nfunction handleData<T extends { list: Item[] }>(data: T): Item[] {\\\\r\\\\n  return data.list\\\\r\\\\n}\\\\r\\\\nconst items: Item[] = []\\\\r\\\\n\\\\r\\\\n// ✅ 若确实不知道类型：用 Object | unknown\\\\r\\\\nfunction log(obj: Object): void { console.log(JSON.stringify(obj)) }\\\\r\\\\n```\\\\r\\\\n\\\\r\\\\n---\\\\r\\\\n\\\\r\\\\n## 13. `@Component` 的 struct 名必须 PascalCase 且与文件名一致\\\\r\\\\n\\\\r\\\\n**症状**：命名不一致导致页面/组件文件导出后 import 路径对不上，Harness 的 `naming_conventions` 报 MAJOR。\\\\r\\\\n\\\\r\\\\n**例外**：与 `framework.config.json` → `architecture.cross_module_exports_file` 同名的导出入口文件（默认 `index.ets`，含小写 `index`）不要求文件名 PascalCase；该文件内若仅有 barrel 导出也可能无 `@Component` 对齐问题。典型页面/组件 `.ets` 仍须 struct 与文件名一致（PascalCase）。\\\\r\\\\n\\\\r\\\\n```ts\\\\r\\\\n// ❌ 错：文件 home_tab_page.ets 内写 struct homeTabPage\\\\r\\\\n22-├── inventory_service/               # HAR — 列表示例模块\\\\n23-│   └── src/main/ets/...\\\\n24-├── shared_platform/                 # HAR — 公共基础模块\\\\n25-│   └── src/main/ets/\\\\n26-│       └── shared/                 # 公共模块通常只有 shared 层\\\\n27:├── AppScope/                       # 应用级配置与资源\\\\n28-├── build-profile.json5             # 全局构建配置（注册所有模块）\\\\n29-├── oh-package.json5                # 全局依赖配置\\\\n30-└── hvigorfile.ts\\\\n31-```\\\\n32-\\\\n--\\\\n219-\\\\n220-@Component\\\\n221-export struct BaseTileView {\\\\n222-  @Prop tileColor: ResourceColor = $r('app.color.tile_default_bg')\\\\n223-  @Prop borderRadiusValue: number = 12\\\\n224:  @BuilderParam content: () => void\\\\n225-\\\\n226-  build() {\\\\n227-    Column() {\\\\n228-      if (this.content) {\\\\n229-        this.content()\\\\n--\\\\n237-}\\\\n238-```\\\\n239-\\\\n240-**规则**：\\\\n241-- 与业务语义无关，纯 UI 容器/样式组件\\\\n242:- 用 `@Prop` 接收外观配置，用 `@BuilderParam` 接收内容插槽\\\\n243-- **不得**引入 data/domain/presentation 层的任何类型\\\\n244-\\\\n245-### 4.4 data/model — 业务数据模型\\\\n246-\\\\n247-```typescript\\\\n--\\\\n376-}\\\\n377-```\\\\n378-\\\\n379-**通用规则**：\\\\n380-- 每个 UI 事件最终进入的业务函数必须是**命名方法 / 导出函数 / 类方法**，不能藏在 `onClick = () => { ... }` inline lambda 里（由 harness `named_business_handler` BLOCKER 强制）\\\\n381:- **不得** import 任何 UI 符号（`@Component` / `NavPathStack` / `showToast` / `$r` / `@kit.ArkUI` 等），保证可在 Hypium 中脱离 ArkUI runtime 实例化\\\\n382-- 直接复用 `contracts.yaml > interfaces[].class` 已登记的现有数据层类作为构造器依赖（形态 B）；**禁止**为了\\\\\\\"便于打桩\\\\\\\"新造 `XxxPort` 接口\\\\n383-- 命名体现业务意图（`submitTask` / `confirmOtp` / `loadDashboard`），避免空词（`handler` / `onClick1`）\\\\n384-\\\\n385-### 4.7 presentation/components — 复杂组件\\\\n386-\\\\n--\\\\n422-      }\\\\n423-    }\\\\n424-    .width('100%')\\\\n425-  }\\\\n426-\\\\n427:  @Builder\\\\n428-  private ItemCarouselContent() {\\\\n429-    Swiper() {\\\\n430-      ForEach(this.items, (it: ItemInfo) => {\\\\n431-        // 条目渲染占位\\\\n432-      }, (it: ItemInfo) => it.id)\\\\n433-    }\\\\n434-    .index(this.currentIndex)\\\\n435-    .onChange((index: number) => { this.currentIndex = index })\\\\n436-  }\\\\n437-\\\\n438:  @Builder\\\\n439-  private EmptyGuide() {\\\\n440-    Column() {\\\\n441-      Text($r('app.string.demo_empty_hint'))\\\\n442-    }\\\\n443-    .justifyContent(FlexAlign.Center)\\\\n--\\\\n457-// presentation/pages/DashboardPage.ets\\\\n458-\\\\n459-import { ItemCarousel } from '../components/ItemCarousel'\\\\n460-import { FunctionGrid } from '../components/FunctionGrid'\\\\n461-\\\\n462:@Builder\\\\n463:export function dashboardPageBuilder() {\\\\n464-  DashboardPage()\\\\n465-}\\\\n466-\\\\n467-@Component\\\\n468-struct DashboardPage {\\\\n--\\\\n483-}\\\\n484-```\\\\n485-\\\\n486-**规则**：\\\\n487-- 功能模块的页面基于 `NavDestination`（不是 `@Entry`）\\\\n488:- 导出 `@Builder` 函数作为路由入口（供 Navigation 的 navDestination 使用）\\\\n489-- 页面本身是多个复杂组件和基础组件的**聚合**\\\\n490-- 页面层尽量薄，复杂逻辑下沉到复杂组件或 domain 层\\\\n491-\\\\n492----\\\\n493-\\\\n--\\\\n496-每个 HAR/HSP 库模块的根目录有一个 `Index.ets`，控制对外暴露的 API：\\\\n497-\\\\n498-```typescript\\\\n499-// feature_demo/src/main/ets/Index.ets\\\\n500-\\\\n501:// 导出页面 Builder（供 entry_app 路由使用）\\\\n502:export { dashboardPageBuilder } from './presentation/pages/DashboardPage'\\\\n503-\\\\n504-export { ItemInfo } from './data/model/ItemInfo'\\\\n505-export { ItemKind } from './shared/constant/DemoTypes'\\\\n506-```\\\\n507-\\\\n508-**规则**：\\\\n509-- 只导出**必须被其他模块引用**的内容\\\\n510-- Repository、UseCase 通常不导出（模块私有）\\\\n511:- 页面通过导出 Builder 函数供 Navigation 路由\\\\n512-\\\\n513----\\\\n514-\\\\n515:## 6. 资源管理\\\\n516-\\\\n517:### 6.1 字符串资源化\\\\n518-\\\\n519:**禁止在 UI 代码中硬编码文字字符串**：\\\\n520-\\\\n521-```typescript\\\\n522-// ❌ 错误\\\\n523-Text('暂无数据')\\\\n524-\\\\n525-// ✅ 正确\\\\n526-Text($r('app.string.demo_empty_hint'))\\\\n527-```\\\\n528-\\\\n529:资源文件位置（每个 Module 各自维护）：\\\\n530-```\\\\n531-{module}/src/main/resources/base/element/string.json     # 默认（英文）\\\\n532-{module}/src/main/resources/zh_CN/element/string.json    # 中文\\\\n533-```\\\\n534-\\\\n535:### 6.2 颜色资源化\\\\n536-\\\\n537-```typescript\\\\n538-// ❌ 错误\\\\n539-.backgroundColor('#FF5722')\\\\n540-\\\\n--\\\\n542-.backgroundColor($r('app.color.primary_orange'))\\\\n543-```\\\\n544-\\\\n545-深色模式：`{module}/src/main/resources/dark/element/color.json`\\\\n546-\\\\n547:### 6.3 图片资源\\\\n548-\\\\n549-- 路径: `{module}/src/main/resources/base/media/`\\\\n550-- 引用: `$r('app.media.icon_name')`\\\\n551-- 优先 SVG 格式\\\\n552-- 命名: snake_case — `ic_home_active.svg`\\\\n--\\\\n591-\\\\n592-## 9. 导入规范\\\\n593-\\\\n594-```typescript\\\\n595-// 1. 鸿蒙 SDK\\\\n596:import { router } from '@kit.ArkUI'\\\\n597-import { hilog } from '@kit.PerformanceAnalysisKit'\\\\n598-\\\\n599-// 2. 跨模块引用（通过 HAR/HSP 库模块的 Index.ets 导出）\\\\n600-import { ItemInfo, ItemKind } from '@feature_demo'\\\\n601-\\\\n--\\\\n631-## 11. 模拟数据策略\\\\n632-\\\\n633-| 数据类型 | 所在层 | 模拟方式 |\\\\n634-|----------|--------|----------|\\\\n635-| API 接口定义 | shared/client | 定义 interface，实现返回模拟数据 |\\\\n636:| 业务数据 | data/repository | Repository 内部用硬编码 JSON 模拟 |\\\\n637:| 网络图片 | 资源文件 | 使用 `$r('app.media.xxx')` 替代 URL |\\\\n638-| 异步延迟 | data/repository | `setTimeout` 模拟 200-500ms 延时 |\\\\n639-\\\\n640-模拟数据实现在 Repository 层，当后续接入真实后端时，只需修改 Repository 的实现，不影响 domain 和 presentation 层。\\\\n# SimulatedWalletForHmos — 模块与分层架构\\\\n\\\\n> 本文档描述本工程的模块分层与依赖约定，是架构设计的单一事实源之一。  \\\\n> **机器可读结构**见工程根目录 [framework.config.json](../framework.config.json) 的 `architecture` 段；修改分层后请同步更新本文与 config。\\\\n\\\\n---\\\\n\\\\n## 生成说明\\\\n\\\\n- 本文档由 **Skill `00-framework-init`** 基于 `framework` 模板首次生成。\\\\n- **后续仅架构级变更才更新本文**（`dsl_change` / `module_set_change` / `responsibility_rewrite` 三类，详见下方「变更触发条件」）；feature 级变更（既有模块内新增页面 / 接口 / 数据模型 / 修复）不写入本文，变更历史由 git 与 [doc/features/](features/) 承担。\\\\n- 若调整了外层 / 内层 / 出口文件名，必须同步 `framework.config.json` 并通过 harness 相关检查。\\\\n\\\\n### 变更触发条件（写入/修改本文前先对号入座）\\\\n\\\\n| impact 等级 | 触发场景 | 本文需同步的小节 |\\\\n|-------------|----------|------------------|\\\\n| `dsl_change` | `framework.config.json > architecture` 结构变化（分层 / 依赖边 / 同层策略 / 内层顺序 / 出口约定） | 外层架构 Mermaid、层间依赖表、模块内分层、物理目录 |\\\\n| `module_set_change` | 模块集合变化（新增 / 下线 / 迁层） | 业务模块清单增删一行、架构级变更记录 |\\\\n| `responsibility_rewrite` | [module-catalog.yaml](module-catalog.yaml) 中某模块 `primary_responsibility` 大幅重写 | 业务模块清单该模块的\\\\\\\"一句话职责\\\\\\\"、架构级变更记录 |\\\\n| `none` | 任何普通 feature 需求 | **不写入本文** |\\\\n\\\\n---\\\\n\\\\n## 外层架构（outer_layers）\\\\n\\\\n依赖方向以 `framework.config.json` → `architecture.outer_layers` 为准：**仅允许声明过的层间依赖**，禁止逆向。\\\\n\\\\n```mermaid\\\\ngraph TD\\\\n  L1[\\\\\\\"01-Product\\\\\\\"]\\\\n  L2[\\\\\\\"02-Feature\\\\\\\"]\\\\n  L3[\\\\\\\"03-CommonBusiness\\\\\\\"]\\\\n  L4[\\\\\\\"04-BusinessBase\\\\\\\"]\\\\n  L5[\\\\\\\"05-SystemBase\\\\\\\"]\\\\n  L1 --> L2\\\\n  L1 --> L3\\\\n  L1 --> L4\\\\n  L1 --> L5\\\\n  L2 --> L3\\\\n  L2 --> L4\\\\n  L2 --> L5\\\\n  L3 --> L4\\\\n  L3 --> L5\\\\n  L4 --> L5\\\\n```\\\\n\\\\n### 层间依赖表（摘录）\\\\n\\\\n| 外层 id | 允许依赖的其它外层（can_depend_on） | 同层策略（intra_layer_deps） |\\\\n|---------|--------------------------------------|------------------------------|\\\\n| 01-Product | 02-Feature, 03-CommonBusiness, 04-BusinessBase, 05-SystemBase | dag |\\\\n| 02-Feature | 03-CommonBusiness, 04-BusinessBase, 05-SystemBase | dag |\\\\n| 03-CommonBusiness | 04-BusinessBase, 05-SystemBase | dag |\\\\n| 04-BusinessBase | 05-SystemBase | dag |\\\\n| 05-SystemBase | （无） | sublayer（CommUI → CommFunc） |\\\\n\\\\n**05-SystemBase 子层**：`CommUI` 可依赖 `CommFunc`；`CommFunc` 不依赖 `CommUI`。成员模块见 `architecture.outer_layers[].sublayers`。\\\\n\\\\n---\\\\n\\\\n## 模块内分层（module_inner_layers）\\\\n\\\\n模块代码目录内部采用以下分层（**数组顺序 = upward 依赖方向**，索引小的可被索引大的 import）：\\\\n\\\\n`shared, data, domain, presentation`\\\\n\\\\n跨模块引用必须通过各模块根目录下、与 `framework.config.json` → `architecture.cross_module_exports_file` 一致的导出入口（默认 **`index.ets`**）导出，禁止深路径 import 到其它模块内部实现。\\\\n\\\\n---\\\\n\\\\n## 物理目录与构建\\\\n\\\\n`build-profile.json5` 中 `modules` 与源码路径对应关系（摘录）：\\\\n\\\\n| 模块名 | srcPath |\\\\n|--------|---------|\\\\n| Phone | `./01-Product/Phone` |\\\\n| WalletMain | `./02-Feature/WalletMain` |\\\\n| AccountManager | `./04-BusinessBase/AccountManager` |\\\\n| CommUI | `./05-SystemBase/CommUI` |\\\\n| CommFunc | `./05-SystemBase/CommFunc` |\\\\n\\\\n---\\\\n\\\\n## 业务模块清单\\\\n\\\\n> 本表仅作架构图的图例，**仅在 `module_set_change` 或 `responsibility_rewrite` 时更新**。\\\\n> 模块职责 / 公共能力 / 易混点 / `NOT_responsible_for` 等详情以 [module-catalog.yaml](module-catalog.yaml) 为 SSOT，**不要**在此重复复制。\\\\n\\\\n| 模块名 | 所属外层 | 一句话职责 |\\\\n|--------|----------|-----------|\\\\n| CommFunc | 05-SystemBase（子层 CommFunc） | 系统侧通用能力：日志封装、脱敏/格式化等无 UI 工具 |\\\\n| CommUI | 05-SystemBase（子层 CommUI） | 公共 ArkUI 组件、主题色与 Toast 等可复用 UI 积木；依赖 CommFunc |\\\\n| AccountManager | 04-BusinessBase | 账号域：登录态、UserProfile、AccountService 等 |\\\\n| WalletMain | 02-Feature | 钱包主 feature：首页/我的/卡包/添卡等页面与路由 |\\\\n| Phone | 01-Product | 入口 HAP：PhoneAbility + 根页壳，聚合各 HAR |\\\\n\\\\n---\\\\n\\\\n## 架构级变更记录\\\\n\\\\n> **准入条件**：仅记录 `dsl_change` / `module_set_change` / `responsibility_rewrite` 三类架构级事件。\\\\n> **禁入内容**：feature 级变更（页面新增 / 接口新增 / 数据模型扩展 / bug 修复 / 样式调整等）一律不记录，由 git history 与 [doc/features/](features/) 承担。\\\\n\\\\n| 日期 | 影响等级 | 说明 |\\\\n|------|----------|------|\\\\n| （无） |  |  |\\\\n\\\\r\\\\n22-          若涉及**登录/登出、`UserProfile` / `LoginState` / `AppStorage` 中账号键、`AccountService` 单例** → 选 **AccountManager**。`AccountManager` 可依赖本模块；**禁止**在 `CommFunc` 内持账号业务状态。\\\\n23-      - term: \\\\\\\"钱包主功能\\\\\\\"\\\\n24-        module: \\\\\\\"WalletMain\\\\\\\"\\\\n25-        disambiguation: |\\\\n26-          **脱敏/日志/与 Tab·卡包无关的纯技术工具** → **CommFunc**（本模块）。\\\\n27:          **钱包首页/我的/卡包/添卡、服务宫格、卡引导与 feature 内仓库** → **WalletMain**；`WalletMain` 可依赖本模块，**禁止**在 `CommFunc` 中实现主功能业务页或卡种流程。\\\\n28-\\\\n29-  - term: \\\\\\\"通用日志\\\\\\\"\\\\n30-    canonical_module: \\\\\\\"CommFunc\\\\\\\"\\\\n31-    owner_layer: \\\\\\\"05-SystemBase\\\\\\\"\\\\n32-    aliases: []\\\\n33-    sample_usage: \\\\\\\"当 PRD 写「用统一 Logger 打 hilog、统一 DOMAIN」时，指本词；不是「我的」里的账户展示或业务异常上报策略。\\\\\\\"\\\\n34-    confidence_hint: \\\\\\\"精确命中 `CommFunc.typical_business_terms`；NOT 中未以「不要记日志」形式否定本词（已扫）。\\\\\\\"\\\\n35-    easily_confused_with:\\\\n36-      - term: \\\\\\\"公共 UI 组件\\\\\\\"\\\\n37-        module: \\\\\\\"CommUI\\\\\\\"\\\\n38-        disambiguation: |\\\\n39-          若 PRD/设计描述的是**无界面的**日志、脱敏、纯工具类 API → 选 **CommFunc**（本模块）。\\\\n40-          若描述的是**可复用 UI 组件/布局/动效/资源**、或与用户可见界面强相关 → 选 **CommUI**。\\\\n41-          子层硬规则：CommUI 可依赖 CommFunc；**CommFunc 不依赖 CommUI**；若 impo