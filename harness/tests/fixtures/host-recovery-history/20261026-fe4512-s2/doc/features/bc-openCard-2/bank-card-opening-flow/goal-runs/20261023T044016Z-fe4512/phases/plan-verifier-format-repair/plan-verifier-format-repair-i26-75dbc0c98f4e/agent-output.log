l_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"selection_hint\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"selection_card_container\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"bank_card_candidate_1\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"selection_agreement_check\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"selection_agreement\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"selection_next_btn\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"}\\\\n      ]\\\\n    },\\\\n    {\\\\n      \\\\\\\"screen_id\\\\\\\": \\\\\\\"card_type_sheet__overlay__card_type_overlay_root\\\\\\\",\\\\n      \\\\\\\"reference_image_hash\\\\\\\": \\\\\\\"66d2652dc31d35c1\\\\\\\",\\\\n      \\\\\\\"evaluated_screenshot_hash\\\\\\\": \\\\\\\"0bf40df29dd7bf9c\\\\\\\",\\\\n      \\\\\\\"must_fix\\\\\\\": [\\\\n        \\\\\\\"Restore the background bank-search row between the subtitles and bank list.\\\\\\\",\\\\n        \\\\\\\"Increase the sheet height and move its top edge upward to approximately the reference position, restoring the vertical positions of its heading, close control, card group, authorization text, agreement and button.\\\\\\\",\\\\n        \\\\\\\"Reduce the bank logo inside the sheet to the reference's compact size and restore its small rounded outline.\\\\\\\",\\\\n        \\\\\\\"Restore the thin separators beneath the bank header and debit-card row.\\\\\\\",\\\\n        \\\\\\\"Render the agreement's introductory text in dark text and reserve blue for the agreement titles.\\\\\\\",\\\\n        \\\\\\\"Make the disabled Continue button and its label clearly visible without changing selection-dependent enablement.\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"defects\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"missing_render\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"ref_element\\\\\\\": \\\\\\\"background_search_bank\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.036, 0.213, 0.928, 0.071],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The reference's search field and Search action are absent from the visible background; the bank list starts directly beneath the subtitles. This is a visible layout omission, not proof that search is unreachable elsewhere.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [0]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_sheet_panel\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0, 0.453, 1, 0.547],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The sheet starts around 45.3% of screenshot height versus approximately 39% in the reference. Its title, close control, card rows and lower content are consequently about 6% of screen height too low, compressing the button's bottom clearance.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [1]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"shape_mismatch\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_bank_row\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.071, 0.57, 0.082, 0.051],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The sheet's bank logo is roughly as large as the background-list logo, whereas the reference uses a substantially smaller logo within a rounded outlined tile. This changes the bank-header hierarchy.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [2]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"missing_render\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"ref_element\\\\\\\": \\\\\\\"card_type_bank_card\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.063, 0.632, 0.875, 0.004],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The thin divider beneath the bank header is not visible, removing the reference's separation between bank identity and card-type choices. The bank header itself is present; the missing part is its divider.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [3]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"debit_card_row\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.063, 0.646, 0.875, 0.065],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The divider beneath the debit-card row is absent, so the two choices lack the reference's row separation. Both choices remain legible. The unselected state alone is not treated as a defect.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [3]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_agreement_copy\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.036, 0.861, 0.743, 0.025],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The introductory phrase is blue along with the agreement titles; the reference keeps that introduction dark. This flattens the text hierarchy. Plain, noninteractive agreement text is permitted.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [4]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_continue_btn\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.264, 0.91, 0.475, 0.067],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The button is almost indistinguishable from the sheet and its white label is barely readable. No card type is selected, so this does not establish an enablement defect or an unreachable continuation.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [5]\\\\n        }\\\\n      ],\\\\n      \\\\\\\"region_attest\\\\\\\": [\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_add_bank_title\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_add_bank_subtitles\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_search_bank\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_bank_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_title\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_close\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_panel\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_bank_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"debit_card_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"credit_card_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_authorization_copy\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_agreement_copy\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_continue_btn\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"}\\\\n      ]\\\\n    },\\\\n    {\\\\n      \\\\\\\"screen_id\\\\\\\": \\\\\\\"card_type_sheet__overlay__card_type_sheet_panel\\\\\\\",\\\\n      \\\\\\\"reference_image_hash\\\\\\\": \\\\\\\"66d2652dc31d35c1\\\\\\\",\\\\n      \\\\\\\"evaluated_screenshot_hash\\\\\\\": \\\\\\\"cae97f8c56afae03\\\\\\\",\\\\n      \\\\\\\"must_fix\\\\\\\": [\\\\n        \\\\\\\"Restore the background bank-search row between the subtitles and bank list.\\\\\\\",\\\\n        \\\\\\\"Increase the sheet height and move its top edge upward to approximately the reference position, restoring the vertical positions of its heading, close control, card group, authorization text, agreement and button.\\\\\\\",\\\\n        \\\\\\\"Reduce the bank logo inside the sheet to the reference's compact size and restore its small rounded outline.\\\\\\\",\\\\n        \\\\\\\"Restore the thin separators beneath the bank header and debit-card row.\\\\\\\",\\\\n        \\\\\\\"Render the agreement's introductory text in dark text and reserve blue for the agreement titles.\\\\\\\",\\\\n        \\\\\\\"Make the disabled Continue button and its label clearly visible without changing selection-dependent enablement.\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"defects\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"missing_render\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"ref_element\\\\\\\": \\\\\\\"background_search_bank\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.036, 0.213, 0.928, 0.071],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The visible background omits the reference's search field and Search action, placing the bank list immediately beneath the subtitles. This observation does not establish whether search exists in another state.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [0]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_sheet_panel\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0, 0.453, 1, 0.547],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The sheet begins around 45.3% of screenshot height rather than the reference's approximately 39%. Its heading, close control, bank group, choices and lower copy are shifted downward, leaving substantially less clearance beneath the continuation button.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [1]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"shape_mismatch\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_bank_row\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.071, 0.57, 0.082, 0.051],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The bank-header logo is substantially larger than the reference's compact outlined logo tile. This makes bank identity disproportionately prominent within the sheet.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [2]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"missing_render\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"ref_element\\\\\\\": \\\\\\\"card_type_bank_card\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.063, 0.632, 0.875, 0.004],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The reference's thin divider beneath the bank header is missing. The header is rendered, but the boundary separating it from card-type choices is absent.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [3]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"debit_card_row\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.063, 0.646, 0.875, 0.065],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The debit-card row lacks the reference's bottom separator, reducing visual separation from the credit-card choice. Both labels remain readable; their unselected state is not itself a defect.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [3]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"minor\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_agreement_copy\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.036, 0.861, 0.743, 0.025],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The introduction and agreement titles share the same blue styling, unlike the reference's dark introduction followed by blue titles. This is a visual hierarchy difference, not a request for interactive links.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [4]\\\\n        },\\\\n        {\\\\n          \\\\\\\"class\\\\\\\": \\\\\\\"other\\\\\\\",\\\\n          \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n          \\\\\\\"element\\\\\\\": \\\\\\\"card_type_continue_btn\\\\\\\",\\\\n          \\\\\\\"bbox\\\\\\\": [0.264, 0.91, 0.475, 0.067],\\\\n          \\\\\\\"note\\\\\\\": \\\\\\\"The very pale button and near-white label are barely distinguishable from the sheet. Disabled behavior is consistent with the captured unselected choices; the screenshot cannot establish enabled-state behavior.\\\\\\\",\\\\n          \\\\\\\"must_fix_refs\\\\\\\": [5]\\\\n        }\\\\n      ],\\\\n      \\\\\\\"region_attest\\\\\\\": [\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_add_bank_title\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_add_bank_subtitles\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_search_bank\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"background_bank_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"no_diff\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_title\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_close\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_sheet_panel\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\\\\\"method\\\\\\\": \\\\\\\"vl_screening\\\\\\\"},\\\\n        {\\\\\\\"region\\\\\\\": \\\\\\\"card_type_bank_row\\\\\\\", \\\\\\\"verdict\\\\\\\": \\\\\\\"diff_logged\\\\\\\", \\\