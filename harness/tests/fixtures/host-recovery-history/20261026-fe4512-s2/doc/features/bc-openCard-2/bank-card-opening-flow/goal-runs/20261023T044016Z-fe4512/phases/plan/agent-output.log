54:     ut_focus: \"六位数字校验、倒计时状态机和重发门禁。\"\r\n  55:     device_focus: \"数字键盘、弹层视觉和按钮启停。\"\r\n  56:     checkpoint:\r\n  57:       pre_screen: bank_card_selection\r\n  58:       action: { target_element_id: selection_next_btn }\r\n  59:       post_screen: otp_verification_sheet\r\n  60:       required_element_ids: [otp_sheet_title, otp_phone_hint, otp_input, otp_resend_action, otp_next_btn]\r\n  61:     requirement_ref:\r\n  62:       source_path: doc/features/原始需求/1-2-银行卡/原始需求.md\r\n  63:       snippet: \"输入验证码半模态页面，拉起后默认触发一次假的短信发送，之后右侧按钮变为倒计时，用户必须输入6位验证码才能点击下一步。\"\r\n  64:       snippet_sha256: \"b90e431612171cdcdbad3b41bd936f75fd3d8cf42149b788dc4236fc4bfac64d\"\r\n  65: \r\n  66:   - id: AC-4\r\n  67:     prd_function: F5\r\n  68:     priority: P0\r\n  69:     description: \"提交验证码后完整卡数据写入 RDB；无论成功或失败都携带完整卡号和结果进入结果页。\"\r\n  70:     testable: true\r\n  71:     verification_steps: [\"分别让 Repository 保存成功和失败\", \"读取数据库记录\", \"检查 OpeningResult 的完整卡号和结果\"]\r\n  72:     expected_result: \"成功时数据库字段完整且卡号唯一；失败时无半写记录但结果页收到完整卡号与失败状态。\"\r\n  73:     ut_layer: both\r\n  74:     ut_focus: \"RDB 映射、幂等和失败结果。\"\r\n  75:     device_focus: \"成功/失败结果页呈现与跨页参数。\"\r\n  76:     checkpoint:\r\n  77:       pre_screen: otp_verification_sheet\r\n  78:       action: { target_element_id: otp_next_btn }\r\n  79:       post_screen: opening_result_success\r\n  80:       required_element_ids: [result_status_icon, result_title, result_description, result_guide_illustration, result_finish_btn]\r\n  81:     requirement_ref:\r\n  82:       source_path: doc/features/原始需求/1-2-银行卡/原始需求.md\r\n  83:       snippet: \"无论写入成功还是失败，将本次添加的卡片卡号（全卡号）和开卡结果带着跳转到添加结果页。\"\r\n  84:       snippet_sha256: \"397d06bf90202823855fe10b339d868f7017d13f0d0292dbc9b83480886cf52c\"\r\n  85: \r\n  86:   - id: AC-5\r\n  87:     prd_function: F6\r\n  88:     priority: P0\r\n  89:     description: \"结果页无返回入口并拦截侧滑/系统返回，只能点击完成；完成后开卡过程页从栈中移除。\"\r\n  90:     testable: true\r\n  91:     verification_steps: [\"在结果页尝试系统返回与侧滑\", \"点击完成\", \"连续返回检查历史页已清除\"]\r\n  92:     expected_result: \"返回动作不离开结果页；成功携带完整卡号回钱包首页，失败回最初添加卡片页，均不能再看到本轮过程页。\"\r\n  93:     navigation_resolution: \"蓝图详细导航裁决将‘最初添加卡片页’绑定为 AddBankCardPage/添加银行卡页；不得绑定 AddCardEntryPage。\"\r\n  94:     ut_layer: device\r\n  95:     ut_focus: \"导航清栈计算可用纯函数覆盖。\"\r\n  96:     device_focus: \"返回手势拦截、完成按钮和真实 NavPathStack。\"\r\n  97:     checkpoint:\r\n  98:       pre_screen: opening_result_success\r\n  99:       action: { target_element_id: result_finish_btn }\r\n 100:       post_screen: wallet_home\r\n 101:       required_element_ids: [home_root]\r\n 102:     requirement_ref:\r\n 103:       source_path: doc/features/原始需求/1-2-银行卡/原始需求.md\r\n 104:       snippet: \"添加结果页是个全屏页面，没有左滑箭头，也禁止左滑事件。\"\r\n 105:       snippet_sha256: \"490381c8b6b42efb77a3f56604b3468939e34dc8184cc5fd11a0cf049607b619\"\r\n 106: \r\n 107:   - id: AC-6\r\n 108:     prd_function: F7\r\n 109:     priority: P1\r\n 110:     description: \"原有添加卡片、添加银行卡、全部银行、钱包首页导航链保持可用。\"\r\n 111:     testable: true\r\n 112:     verification_steps: [\"运行既有路由用例\", \"在真机往返添加卡片与全部银行页面\"]\r\n 113:     expected_result: \"既有路由名称和页面返回语义不受新增流程破坏。\"\r\n 114:     ut_layer: both\r\n 115:     ut_focus: \"路由注册和旧入口回归。\"\r\n 116:     device_focus: \"旧页面互相跳转与返回。\"\r\n 117:     requirement_ref:\r\n 118:       source_path: doc/features/原始需求/1-2-银行卡/原始需求.md\r\n 119:       snippet: \"测试用例要包含老代码和本轮新开发代码的页面互相跳转功能，不能导致原有路由受损。\"\r\n 120:       snippet_sha256: \"ac15e5291b666545510f25a924e0a4199a235258a04a34557d111026129edaf8\"\r\n 121: \r\n 122: boundaries:\r\n 123:   - id: BD-1\r\n 124:     prd_exception: E1\r\n 125:     scenario: \"用户输入或选择不完整。\"\r\n 126:     description: \"未选择卡型、卡片、未同意协议或验证码不是六位数字时不得继续。\"\r\n 127:     priority: P0\r\n 128:     handling: \"保持当前页面和输入，继续按钮置灰，不创建数据库记录。\"\r\n 129:     expected_behavior: \"用户补齐合法输入后才可继续。\"\r\n 130:     affected_functions: [F2, F3, F4]\r\n 131:     ut_layer: both\r\n 132:     ut_focus: \"卡型、卡片、协议与六位数字验证码的组合门禁。\"\r\n 133:     device_focus: \"四个界面的按钮启停和中途取消行为。\"\r\n 134: \r\n 135:   - id: BD-2\r\n 136:     prd_exception: E2\r\n 137:     scenario: \"用户快速重复点击发送验证码。\"\r\n 138:     description: \"倒计时期间重复点击发送不触发新发送；归零后仅一次点击重启 60 秒。\"\r\n 139:     priority: P0\r\n 140:     handling: \"倒计时状态为唯一门禁，忽略不可用期间点击。\"\r\n 141:     expected_behavior: \"同一倒计时窗口只发生一次 mock 发送。\"\r\n 142:     affected_functions: [F4]\r\n 143:     ut_layer: both\r\n 144:     ut_focus: \"60 秒倒计时状态机、重复点击忽略与归零重启。\"\r\n 145:     device_focus: \"倒计时文案和重发按钮实际交互。\"\r\n 146: \r\n 147:   - id: BD-3\r\n 148:     prd_exception: E3\r\n 149:     scenario: \"数据库创建、查询或插入失败。\"\r\n 150:     description: \"RDB 保存异常仍进入失败结果页且不泄漏完整卡号到日志或界面。\"\r\n\n===== doc/features/bc-openCard-2/bank-card-opening-flow/plan/plan.md:220-260 =====\r\n 220: └── aboutToAppear\r\n 221:     └── BankOpeningCompletionContext.consume()\r\n 222:         └── lastOpenedCardNumber（仅内存，不展示、不记录日志）\r\n 223: ```\r\n 224: \r\n 225: ## 5. 状态管理方案\r\n 226: \r\n 227: | 数据 | 作用域 | 装饰器/机制 | 持有者 | 生命周期/清理 |\r\n 228: |---|---|---|---|---|\r\n 229: | 当前银行、卡型、卡型 Sheet 可见性 | 入口页面实例 | `@State` | AddBankCardPage / AllBanksPage | 关闭 Sheet 清空本次未提交选择。 |\r\n 230: | 卡候选、当前卡、协议勾选、OTP Sheet 可见性 | 具体卡片页实例 | `@State` | BankCardSelectionPage | 返回销毁；关闭 OTP 只清验证码状态，保留卡片选择。 |\r\n 231: | mobile、otp、countdown、sending、saving | OTP Sheet 实例 | `@State` + `setInterval` | OtpVerificationSheet | 出现即发送；关闭/aboutToDisappear 取消 Timer 并清空。 |\r\n 232: | 已保存银行卡 | 应用沙箱持久态 | RDB | BankCardRepository | 冷启动可读；按完整卡号幂等。 |\r\n 233: | OpeningResult | 页面跳转参数 | `NavPathStack` param | BankCardOpeningResultPage | 完成后随过程栈清理。 |\r\n 234: | 成功完整卡号 | 进程内单次上下文 | static publish/consume/clear | BankOpeningCompletionContext | 结果页先 publish 后 clear；首页 appear 单次消费即清空。 |\r\n 235: | 页面栈 | 应用全局 | `NavPathContext.attach/stack` | Phone Index | 沿用唯一根栈，不新建导航体系。 |\r\n 236: \r\n 237: 运行顺序：入口打开卡型 Sheet → push 具体卡片页 → 打开 OTP Sheet → 转换 `StoredCard` 并等待 RDB → 生成 `OpeningResult` 并 push 结果页 → 成功 publish 卡号并 clear 回首页，失败 `popToName('AddBankCardPage')`。失败保存仍进入结果页，且数据库无半写。\r\n 238: \r\n 239: ## 6. 服务层接口定义\r\n 240: \r\n 241: | 接口 | 完整签名 | 异步 | 说明 |\r\n 242: |---|---|---|---|\r\n 243: | BankRepository.getBanks | `getBanks(): Promise<BankInfo[]>` | 是 | 现有银行 mock，补支持卡型。 |\r\n 244: | BankRepository.getCards | `getCards(bankCode: string, cardType: BankCardType): Promise<BankCardCandidate[]>` | 是 | 每银行/卡型返回 1–2 张完整候选卡。 |\r\n 245: | BankCardRepository.save | `save(card: StoredCard): Promise<StoredCard>` | 是 | 按完整卡号幂等原子保存。 |\r\n 246: | BankCardRepository.list | `list(): Promise<StoredCard[]>` | 是 | 读取已保存卡。 |\r\n 247: | BankCardOpeningService.maskCardNumber | `maskCardNumber(cardNumber: string): string` | 否 | 只输出前四、掩码和后四。 |\r\n 248: | BankCardOpeningService.isValidOtp | `isValidOtp(otp: string): boolean` | 否 | 精确六位数字。 |\r\n 249: | BankCardOpeningService.toStoredCard | `toStoredCard(candidate: BankCardCandidate): StoredCard` | 否 | 补齐默认支付状态、时间和空交易记录。 |\r\n 250: | BankCardOpeningService.toOpeningResult | `toOpeningResult(candidate: BankCardCandidate, success: boolean, errorMessage: string): OpeningResult` | 否 | 成功/失败都保留完整卡号。 |\r\n 251: | OtpService.sendMockCode | `sendMockCode(mobile: string): Promise<void>` | 是 | 本地假发送，不调用真实短信服务。 |\r\n 252: | OpeningNavigationService.finish | `finish(stack: NavPathStack, result: OpeningResult): void` | 否 | 成功 clear 回首页；失败定向返回 AddBankCardPage。 |\r\n 253: | AccountService.getUserProfile | `getUserProfile(): Promise<UserProfile>` | 是 | 返回账号 mock mobile。 |\r\n 254: | BankOpeningCompletionContext.publish | `publish(fullCardNumber: string): void` | 否 | 暂存未消费成功卡号。 |\r\n 255: | BankOpeningCompletionContext.consume | `consume(): string | undefined` | 否 | 单次取出并清空。 |\r\n 256: | BankOpeningCompletionContext.clear | `clear(): void` | 否 | 显式清空。 |\r\n 257: \r\n 258: `BankCardRepository` 通过构造注入页面取得的应用 `Context`，不把 UI runtime 能力伪装成 data boundary；对外业务方法保持上述蓝图签名。\r\n 259: \r\n 260: ### 业务流程 UseCase 清单\r\n\n===== doc/features/bc-openCard-2/bank-card-opening-flow/contracts.yaml:110-250 =====\r\n 110:     file: 02-Feature/WalletMain/src/main/ets/data/repository/BankRepository.ets\r\n 111:     class: BankRepository\r\n 112:     methods:\r\n 113:       - { name: getBanks, params: [], return: \"Promise<BankInfo[]>\", async: true, description: \"返回本地 mock 银行及支持卡型。\" }\r\n 114:       - name: getCards\r\n 115:         params: [{ name: bankCode, type: string }, { name: cardType, type: BankCardType }]\r\n 116:         return: \"Promise<BankCardCandidate[]>\"\r\n 117:         async: true\r\n 118:         description: \"按银行与卡型返回一至两张完整 mock 候选卡。\"\r\n 119:   - layer: domain\r\n 120:     file: 02-Feature/WalletMain/src/main/ets/domain/service/OtpService.ets\r\n 121:     class: OtpService\r\n 122:     methods:\r\n 123:       - { name: sendMockCode, params: [{ name: mobile, type: string }], return: \"Promise<void>\", async: true, description: \"本地假发送。\" }\r\n 124:   - layer: domain\r\n 125:     file: 02-Feature/WalletMain/src/main/ets/domain/service/OpeningNavigationService.ets\r\n 126:     class: OpeningNavigationService\r\n 127:     methods:\r\n 128:       - name: finish\r\n 129:         params: [{ name: stack, type: NavPathStack }, { name: result, type: OpeningResult }]\r\n 130:         return: void\r\n 131:         async: false\r\n 132:         description: \"成功发布完整卡号后 clear 回首页；失败 popToName 到 AddBankCardPage。\"\r\n 133:   - layer: domain\r\n 134:     file: 04-BusinessBase/AccountManager/src/main/ets/domain/service/AccountService.ets\r\n 135:     class: AccountService\r\n 136:     methods:\r\n 137:       - { name: getUserProfile, params: [], return: \"Promise<UserProfile>\", async: true, description: \"返回含 mobile 的账号 mock。\" }\r\n 138:   - layer: data\r\n 139:     file: 02-Feature/WalletMain/src/main/ets/data/model/BankOpeningCompletionContext.ets\r\n 140:     class: BankOpeningCompletionContext\r\n 141:     methods:\r\n 142:       - { name: publish, params: [{ name: fullCardNumber, type: string }], return: void, async: false, description: \"暂存一次性成功卡号。\" }\r\n 143:       - { name: consume, params: [], return: \"string|undefined\", async: false, description: \"取出并立即清空。\" }\r\n 144:       - { name: clear, params: [], return: void, async: false, description: \"清空未消费值。\" }\r\n 145: \r\n 146: components:\r\n 147:   - name: AddBankCardPage\r\n 148:     module: WalletMain\r\n 149:     file: 02-Feature/WalletMain/src/main/ets/presentation/pages/AddBankCardPage.ets\r\n 150:     kind: page\r\n 151:     asset_selection: &custom_opening_ui\r\n 152:       resolution: custom\r\n 153:       rationale: \"卡型、卡片、验证码和结果页均携带银行卡流程状态，不能由无业务状态的通用列表项直接配置得到。\"\r\n 154:     state: [{ name: selectedBank, decorator: \"@State\", type: \"BankInfo | null\" }, { name: showCardTypeSheet, decorator: \"@State\", type: boolean }]\r\n 155:     events: [{ name: openCardTypeSheet, description: \"银行点击统一入口。\" }]\r\n 156:     children: [BankListRow, CardTypeSheet]\r\n 157:   - name: AllBanksPage\r\n 158:     module: WalletMain\r\n 159:     file: 02-Feature/WalletMain/src/main/ets/presentation/pages/AllBanksPage.ets\r\n 160:     kind: page\r\n 161:     asset_selection: *custom_opening_ui\r\n 162:     state: [{ name: selectedBank, decorator: \"@State\", type: \"BankInfo | null\" }, { name: showCardTypeSheet, decorator: \"@State\", type: boolean }]\r\n 163:     events: [{ name: openCardTypeSheet, description: \"银行点击统一入口。\" }]\r\n 164:     children: [BankListRow, CardTypeSheet]\r\n 165:   - name: CardTypeSheet\r\n 166:     module: WalletMain\r\n 167:     file: 02-Feature/WalletMain/src/main/ets/presentation/components/CardTypeSheet.ets\r\n 168:     kind: component\r\n 169:     asset_selection: *custom_opening_ui\r\n 170:     props: [{ name: bank, decorator: \"@Prop\", type: BankInfo }]\r\n 171:     state: [{ name: selectedType, decorator: \"@State\", type: \"BankCardType | null\" }]\r\n 172:     events: [{ name: onContinue, description: \"携带 bankCode/cardType 进入选卡页。\" }, { name: onClose, description: \"丢弃未提交卡型。\" }]\r\n 173:   - name: BankCardSelectionPage\r\n 174:     module: WalletMain\r\n 175:     file: 02-Feature/WalletMain/src/main/ets/presentation/pages/BankCardSelectionPage.ets\r\n 176:     kind: page\r\n 177:     asset_selection: *custom_opening_ui\r\n 178:     nav_destination: BankCardSelectionPage\r\n 179:     linked_functions: [buildBankCardSelectionPage]\r\n 180:     state:\r\n 181:       - { name: candidates, decorator: \"@State\", type: \"BankCardCandidate[]\" }\r\n 182:       - { name: selectedCandidate, decorator: \"@State\", type: \"BankCardCandidate | null\" }\r\n 183:       - { name: agreementAccepted, decorator: \"@State\", type: boolean }\r\n 184:       - { name: showOtpSheet, decorator: \"@State\", type: boolean }\r\n 185:     events: [{ name: openOtpVerificationSheet, description: \"选卡且同意协议后打开验证码弹层。\" }]\r\n 186:     children: [OtpVerificationSheet]\r\n 187:   - name: OtpVerificationSheet\r\n 188:     module: WalletMain\r\n 189:     file: 02-Feature/WalletMain/src/main/ets/presentation/components/OtpVerificationSheet.ets\r\n 190:     kind: component\r\n 191:     asset_selection: *custom_opening_ui\r\n 192:     props: [{ name: candidate, decorator: \"@Prop\", type: BankCardCandidate }]\r\n 193:     state:\r\n 194:       - { name: mobile, decorator: \"@State\", type: string }\r\n 195:       - { name: otp, decorator: \"@State\", type: string }\r\n 196:       - { name: countdownSeconds, decorator: \"@State\", type: number }\r\n 197:       - { name: sending, decorator: \"@State\", type: boolean }\r\n 198:       - { name: saving, decorator: \"@State\", type: boolean }\r\n 199:     events: [{ name: resendCode, description: \"归零后重新发送。\" }, { name: saveSelectedCard, description: \"保存并跳转结果页。\" }, { name: onClose, description: \"取消 Timer 并清理 OTP 状态。\" }]\r\n 200:   - name: BankCardOpeningResultPage\r\n 201:     module: WalletMain\r\n 202:     file: 02-Feature/WalletMain/src/main/ets/presentation/pages/BankCardOpeningResultPage.ets\r\n 203:     kind: page\r\n 204:     asset_selection: *custom_opening_ui\r\n 205:     nav_destination: BankCardOpeningResultPage\r\n 206:     linked_functions: [buildBankCardOpeningResultPage]\r\n 207:     props: [{ name: result, decorator: route_param, type: OpeningResult }]\r\n 208:     events: [{ name: finishOpeningFlow, description: \"唯一退出动作。\" }]\r\n 209:   - name: HomeTabPage\r\n 210:     module: WalletMain\r\n 211:     file: 02-Feature/WalletMain/src/main/ets/presentation/pages/HomeTabPage.ets\r\n 212:     kind: page\r\n 213:     asset_selection: *custom_opening_ui\r\n 214:     state: [{ name: lastOpenedCardNumber, decorator: \"@State\", type: \"string | undefined\" }]\r\n 215:     events: [{ name: consumeOpeningCompletion, description: \"aboutToAppear 单次消费成功卡号。\" }]\r\n 216: \r\n 217: state_management:\r\n 218:   - state_id: opening-session\r\n 219:     data: opening-session\r\n 220:     scope: 当前入口到结果页\r\n 221:     decorator: \"@State + NavPathStack params\"\r\n 222:     holder: \"AddBankCardPage|AllBanksPage / BankCardSelectionPage / OtpVerificationSheet\"\r\n 223:     module: WalletMain\r\n 224:     design_ref:\r\n 225:       artifact: component-blueprint@1\r\n 226:       component_id: wallet-bank-card-opening\r\n 227:       blueprint_id: bc-openCard-2\r\n 228:       revision: 1\r\n 229:       source_fingerprint: sha256:fb887c31df3f865b23b566d1e43d3f3364ee13da663fdc0257ef628a40bc9590\r\n 230:       artifact_sha256: sha256:5dfb52537711026c3a4b82d4b4e9a4e3dc979ea749e3d33c61308428c0093a29\r\n 231:       target: { kind: node, view_id: runtime, id: bank-card-opening-flow }\r\n 232:     owner_ref: view:runtime/node:bank-card-opening-flow\r\n 233:     contract_refs: [contract:bank-card-persistence]\r\n 234:     ordered_steps:\r\n 235:       - \"AddBankCardPage 或 AllBanksPage 调用 CardTypeSheet.open(bank)，传入所选 BankInfo；关闭时丢弃未提交选择。\"\r\n 236:       - \"CardTypeSheet 只允许选中一个受支持卡型；同意并继续后调用 NavPathContext.stack().pushPath 进入 BankCardSelectionPage，参数包含 bankCode 与 cardType。\"\r\n 237:       - \"BankCardSelectionPage 调用 BankRepository.getCards(bankCode, cardType) 返回 1 至 2 张完整 mock 卡；页面只渲染 maskCardNumber(fullNumber)。\"\r\n 238:       - \"用户选卡并同意协议后，BankCardSelectionPage 打开 OtpVerificationSheet，内存参数包含所选完整 BankCardCandidate。\"\r\n 239:       - \"OtpVerificationSheet 出现时调用 AccountService.getUserProfile() 取得 UserProfile.mobile，渲染掩码手机号；随后调用 OtpService.sendMockCode(mobile) 并启动 60 秒倒计时，仅接受六位数字，倒计时结束前禁止重发。\"\r\n 240:       - \"OtpVerificationSheet 关闭或 aboutToDisappear 时取消 Timer 并清空 otp/sending/saving；关闭验证码弹层只丢弃验证码状态，保留具体卡片页上的当前卡片选择供用户继续。\"\r\n 241:       - \"用户提交验证码后，OtpVerificationSheet 调用 BankCardOpeningService.toStoredCard(candidate) 生成 StoredCard，再调用 BankCardRepository.save(card) 并等待 RDB 返回；服务将成功或异常统一映射为 OpeningResult(fullCardNumber, success, errorMessage)。\"\r\n 242:       - \"页面将 OpeningResult 通过 NavPathStack 参数推入 BankCardOpeningResultPage；结果页禁用返回手势和系统返回。\"\r\n 243:       - \"用户点击完成后，结果页调用 OpeningNavigationService.finish(stack, result)：成功先把 fullCardNumber 写入进程内 BankOpeningCompletionContext，再调用 stack.clear(false) 回根首页；失败调用 stack.popToName('AddBankCardPage', false)，保留最初 AddBankCardPage 并删除 AllBanksPage、选卡页和结果页。\"\r\n 244:   - state_id: persisted-bank-card-flow-mapping\r\n 245:     data: persisted-bank-card-flow\r\n 246:     scope: 应用沙箱持久态及成功完成一次性交接\r\n 247:     decorator: \"RDB + publish/consume\"\r\n 248:     holder: BankCardRepository\r\n 249:     module: WalletMain\r\n 250:     design_ref:\r\n\n===== doc/features/bc-openCard-2/bank-card-opening-flow/use-cases.yaml:25-65 =====\r\n  25:     ui_bindings:\r\n  26:       - ui: AddBankCardPage|AllBanksPage\r\n  27:         role: entry\r\n  28:         user_actions:\r\n  29:           - { trigger: tap_bank, calls: [openCardTypeSheet] }\r\n  30:       - ui: BankCardSelectionPage\r\n  31:         role: progress\r\n  32:         user_actions:\r\n  33:           - { trigger: tap_next, calls: [openOtpVerificationSheet] }\r\n  34:       - ui: OtpVerificationSheet\r\n  35:         role: dialog\r\n  36:         user_actions:\r\n  37:           - { trigger: submit_otp, calls: [saveSelectedCard] }\r\n  38:       - ui: BankCardOpeningResultPage\r\n  39:         role: result\r\n  40:         user_actions:\r\n  41:           - { trigger: tap_finish, calls: [finishOpeningFlow] }\r\n  42:     data_boundaries:\r\n  43:       - name: BankCardRepository\r\n  44:         type: BankCardRepository\r\n  45:         kind: storage\r\n  46:         methods: [save, list]\r\n  47:     state_model:\r\n  48:       phases: [ENTRY, TYPE_SELECTED, CARD_SELECTED, OTP_ACTIVE, SAVING, RESULT]\r\n  49:     branches:\r\n  50:       - scenario: 成功保存银行卡\r\n  51:         id: BR-SUCCESS\r\n  52:         linked_acceptance: [AC-1, AC-2, AC-3, AC-4, AC-5]\r\n  53:         expected_phase_seq: [ENTRY, TYPE_SELECTED, CARD_SELECTED, OTP_ACTIVE, SAVING, RESULT]\r\n  54:         expected_port_calls: [BankRepository.getCards, OtpService.sendMockCode, BankCardRepository.save, OpeningNavigationService.finish]\r\n  55:       - scenario: 保存银行卡失败\r\n  56:         id: BR-FAILURE\r\n  57:         linked_acceptance: [AC-4, AC-5, BD-3]\r\n  58:         expected_phase_seq: [ENTRY, TYPE_SELECTED, CARD_SELECTED, OTP_ACTIVE, SAVING, RESULT]\r\n  59:         expected_port_calls: [BankCardRepository.save, OpeningNavigationService.finish]\r\n\n===== 02-Feature/WalletMain/src/main/ets/domain/service/OtpService.ets:1-90 =====\r\n   1: /** 本地短信模拟服务；不发送网络请求，也不记录手机号。 */\r\n   2: export class OtpService {\r\n   3:   async sendMockCode(mobile: string): Promise<void> {\r\n   4:     if (mobile.length === 0) {\r\n   5:       return Promise.resolve();\r\n   6:     }\r\n   7:     return Promise.resolve();\r\n   8:   }\r\n   9: }\r\n  10: \r\n  11: /** 可由页面时钟或 UT 显式驱动的 OTP 状态对象。 */\r\n  12: export class OtpVerificationState {\r\n  13:   otp: string = '';\r\n  14:   countdownSeconds: number = 0;\r\n  15:   sending: boolean = false;\r\n  16:   active: boolean = false;\r\n  17:   private mobile: string = '';\r\n  18:   private readonly otpService: OtpService;\r\n  19:   private readonly countdownStart: number;\r\n  20: \r\n  21:   constructor(otpService: OtpService, countdownStart: number) {\r\n  22:     this.otpService = otpService;\r\n  23:     this.countdownStart = countdownStart;\r\n  24:   }\r\n  25: \r\n  26:   async start(mobile: string): Promise<boolean> {\r\n  27:     this.reset();\r\n  28:     this.active = true;\r\n  29:     this.mobile = mobile;\r\n  30:     return this.send();\r\n  31:   }\r\n  32: \r\n  33:   async resend(): Promise<boolean> {\r\n  34:     if (!this.active || this.countdownSeconds > 0) {\r\n  35:       return false;\r\n  36:     }\r\n  37:     return this.send();\r\n  38:   }\r\n  39: \r\n  40:   tick(): number {\r\n  41:     if (!this.active || this.countdownSeconds === 0) {\r\n  42:       return this.countdownSeconds;\r\n  43:     }\r\n  44:     this.countdownSeconds -= 1;\r\n  45:     return this.countdownSeconds;\r\n  46:   }\r\n  47: \r\n  48:   updateOtp(value: string, maxLength: number): string {\r\n  49:     this.otp = value.replace(/[^0-9]/g, '').substring(0, maxLength);\r\n  50:     return this.otp;\r\n  51:   }\r\n  52: \r\n  53:   canSubmit(expectedLength: number): boolean {\r\n  54:     return this.active && this.otp.length === expectedLength && /^\\d+$/.test(this.otp);\r\n  55:   }\r\n  56: \r\n  57:   cancel(): void {\r\n  58:     this.active = false;\r\n  59:     this.reset();\r\n  60:   }\r\n  61: \r\n  62:   reset(): void {\r\n  63:     this.otp = '';\r\n  64:     this.countdownSeconds = 0;\r\n  65:     this.sending = false;\r\n  66:     this.mobile = '';\r\n  67:   }\r\n  68: \r\n  69:   private async send(): Promise<boolean> {\r\n  70:     if (!this.active || this.sending || this.mobile.length === 0) {\r\n  71:       return false;\r\n  72:     }\r\n  73:     this.sending = true;\r\n  74:     try {\r\n  75:       await this.otpService.sendMockCode(this.mobile);\r\n  76:       if (!this.active) {\r\n  77:         return false;\r\n  78:       }\r\n  79:       this.countdownSeconds = this.countdownStart;\r\n  80:       return true;\r\n  81:     } finally {\r\n  82:       this.sending = false;\r\n  83:     }\r\n  84:   }\r\n  85: }\r\n\n===== 02-Feature/WalletMain/src/main/ets/domain/service/BankCardOpeningService.ets:60-210 =====\r\n  60:   }\r\n  61: \r\n  62:   setAgreementAccepted(accepted: boolean): void {\r\n  63:     this.session.setAgreementAccepted(accepted);\r\n  64:   }\r\n  65: \r\n  66:   canOpenOtp(): boolean {\r\n  67:     return this.session.canOpenOtp();\r\n  68:   }\r\n  69: \r\n  70:   async startOtp(mobile: string): Promise<boolean> {\r\n  71:     if (!this.canOpenOtp() || this.otpState === null) {\r\n  72:       return false;\r\n  73:     }\r\n  74:     const sent: boolean = await this.otpState.start(mobile);\r\n  75:     if (sent) {\r\n  76:       this.openingPhase = BankCardOpeningPhase.OTP_ACTIVE;\r\n  77:     }\r\n  78:     return sent;\r\n  79:   }\r\n  80: \r\n  81:   async resendOtp(): Promise<boolean> {\r\n  82:     if (this.otpState === null) {\r\n  83:       return false;\r\n  84:     }\r\n  85:     return this.otpState.resend();\r\n  86:   }\r\n  87: \r\n  88:   tickOtp(): number {\r\n  89:     return this.otpState === null ? 0 : this.otpState.tick();\r\n  90:   }\r\n  91: \r\n  92:   updateOtp(value: string, maxLength: number): string {\r\n  93:     if (this.otpState === null) {\r\n  94:       return '';\r\n  95:     }\r\n  96:     const otp: string = this.otpState.updateOtp(value, maxLength);\r\n  97:     this.session.setOtp(otp);\r\n  98:     return otp;\r\n  99:   }\r\n 100: \r\n 101:   otpValue(): string {\r\n 102:     return this.otpState === null ? '' : this.otpState.otp;\r\n 103:   }\r\n 104: \r\n 105:   otpCountdownSeconds(): number {\r\n 106:     return this.otpState === null ? 0 : this.otpState.countdownSeconds;\r\n 107:   }\r\n 108: \r\n 109:   otpSending(): boolean {\r\n 110:     return this.otpState !== null && this.otpState.sending;\r\n 111:   }\r\n 112: \r\n 113:   canSubmit(expectedOtpLength: number): boolean {\r\n 114:     return this.otpState !== null && this.otpState.canSubmit(expectedOtpLength) && this.session.canSubmit();\r\n 115:   }\r\n 116: \r\n 117:   phase(): BankCardOpeningPhase {\r\n 118:     return this.openingPhase;\r\n 119:   }\r\n 120: \r\n 121:   result(): OpeningResult | null {\r\n 122:     return this.openingResult;\r\n 123:   }\r\n 124: \r\n 125:   maskCardNumber(cardNumber: string): string {\r\n 126:     if (cardNumber.length <= 8) {\r\n 127:       return cardNumber;\r\n 128:     }\r\n 129:     return `${cardNumber.substring(0, 4)} **** **** ${cardNumber.substring(cardNumber.length - 4)}`;\r\n 130:   }\r\n 131: \r\n 132:   isValidOtp(otp: string): boolean {\r\n 133:     return /^\\d{6}$/.test(otp);\r\n 134:   }\r\n 135: \r\n 136:   toStoredCard(candidate: BankCardCandidate): StoredCard {\r\n 137:     return new StoredCard({\r\n 138:       cardNumber: candidate.cardNumber,\r\n 139:       category: 'BANK_CARD',\r\n 140:       bankName: candidate.bankName,\r\n 141:       bankCardType: candidate.cardType === BankCardType.DEBIT ? 'DEBIT' : 'CREDIT',\r\n 142:       addedAt: Date.now(),\r\n 143:       huaweiPayEnabled: true,\r\n 144:       unionPayQuickPassEnabled: true,\r\n 145:       transactionRecords: '[]'\r\n 146:     });\r\n 147:   }\r\n 148: \r\n 149:   toOpeningResult(\r\n 150:     candidate: BankCardCandidate,\r\n 151:     success: boolean,\r\n 152:     errorMessage: string = ''\r\n 153:   ): OpeningResult {\r\n 154:     return new OpeningResult({\r\n 155:       fullCardNumber: candidate.cardNumber,\r\n 156:       success: success,\r\n 157:       errorMessage: errorMessage.length > 0 ? errorMessage : undefined\r\n 158:     });\r\n 159:   }\r\n 160: \r\n 161:   async saveCandidate(candidate: BankCardCandidate): Promise<OpeningResult> {\r\n 162:     if (this.repository === null) {\r\n 163:       return this.toOpeningResult(candidate, false, 'RDB_STORE_UNAVAILABLE');\r\n 164:     }\r\n 165:     try {\r\n 166:       await this.repository.save(this.toStoredCard(candidate));\r\n 167:       return this.toOpeningResult(candidate, true);\r\n 168:     } catch {\r\n 169:       return this.toOpeningResult(candidate, false, 'RDB_SAVE_FAILED');\r\n 170:     }\r\n 171:   }\r\n 172: \r\n 173:   async completeOpening(expectedOtpLength: number): Promise<OpeningResult | null> {\r\n 174:     const candidate: BankCardCandidate | null = this.session.selectedCandidate();\r\n 175:     if (candidate === null || !this.canSubmit(expectedOtpLength)) {\r\n 176:       return null;\r\n 177:     }\r\n 178:     this.openingPhase = BankCardOpeningPhase.SAVING;\r\n 179:     this.openingResult = await this.saveCandidate(candidate);\r\n 180:     this.openingPhase = BankCardOpeningPhase.RESULT;\r\n 181:     return this.openingResult;\r\n 182:   }\r\n 183: \r\n 184:   cancelOtp(): void {\r\n 185:     if (this.openingPhase !== BankCardOpeningPhase.OTP_ACTIVE) {\r\n 186:       return;\r\n 187:     }\r\n 188:     if (this.otpState !== null) {\r\n 189:       this.otpState.cancel();\r\n 190:     }\r\n 191:     this.session.setOtp('');\r\n 192:     this.openingPhase = BankCardOpeningPhase.CARD_SELECTED;\r\n 193:   }\r\n 194: \r\n 195:   cancel(): void {\r\n 196:     if (this.otpState !== null) {\r\n 197:       this.otpState.cancel();\r\n 198:     }\r\n 199:     this.session.cancel();\r\n 200:     this.openingResult = null;\r\n 201:     this.openingPhase = BankCardOpeningPhase.ENTRY;\r\n 202:   }\r\n 203: }\r\n 204: \r\n 205: /** 跨 ArkUI 页面复用的开卡选择与继续门禁。 */\r\n 206: export class BankCardOpeningSession {\r\n 207:   private bankCode: string = '';\r\n 208:   private cardType: BankCardType | null = null;\r\n 209:   private candidate: BankCardCandidate | null = null;\r\n 210:   private agreementAccepted: boolean = false;\r\n","exit_code":0,"status":"completed"}}
