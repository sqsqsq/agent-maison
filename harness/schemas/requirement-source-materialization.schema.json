{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmaison.dev/schemas/requirement-source-materialization.schema.json",
  "title": "AgentMaison Requirement Source Materialization",
  "description": "宿主 → Maison 的来源材料物化输入契约（M7 seam: requirement-source-materialization）。宿主负责获取、脱敏并把来源材料落到项目内；Maison 只消费项目内可解析的 source_ref、原始字节 sha256、provenance 与 authority。Maison 不知道内网标识、token、URL 或归档 API。items[] 的形状与 app-component-blueprint.schema.json 的 currentScopeItem 语义一致（同一 kind 枚举、同一 provenance/sha256/stableId 定义），并额外要求 authority——校验通过的 item 可原样进入 discovery.inputs.current_scope_items。",
  "type": "object",
  "required": ["artifact", "blueprint_id", "component_id", "items"],
  "properties": {
    "artifact": { "const": "requirement-source-materialization@1" },
    "blueprint_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "component_id": { "$ref": "#/$defs/stableId" },
    "producer": {
      "type": "object",
      "description": "宿主侧 provider 身份，仅作 extraction method 记录，不构成权威。",
      "required": ["provider_id"],
      "properties": {
        "provider_id": { "$ref": "#/$defs/stableId" },
        "materialized_at": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/materializedScopeItem" }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provenance": {
      "type": "object",
      "required": ["source_kind", "source_ref", "observed_at", "evidence_strength", "extraction_method"],
      "properties": {
        "source_kind": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_strength": { "enum": ["authoritative", "observed", "inferred", "unknown"] },
        "extraction_method": { "type": "string", "minLength": 1 }
      }
    },
    "materializedScopeItem": {
      "type": "object",
      "description": "与 app-component-blueprint.schema.json#/$defs/currentScopeItem 同形，并强制 authority。source_ref 必须是项目内相对路径（可带 #fragment），由既有 resolveCurrentScopeSource 解析。",
      "required": ["item_id", "kind", "source_ref", "source_sha256", "provenance", "authority"],
      "properties": {
        "item_id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["requirement", "goal", "invariant", "high_risk"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authority": {
          "type": "object",
          "description": "谁为这份材料负责。Maison 不解释内网组织语义，只要求可归属的 owner 与显式 formality 分类。",
          "required": ["owner", "formality"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "formality": {
              "description": "上游显式分类具有权威性（meta-model: Formal requirement determination）。unspecified 表示上游未分类，由人在入口确认，不得由 Maison 猜测。",
              "enum": ["formal_requirement", "non_formal_maintenance", "unspecified"]
            }
          }
        }
      }
    }
  }
}
