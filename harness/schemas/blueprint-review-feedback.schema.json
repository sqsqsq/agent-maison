{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmaison.dev/schemas/blueprint-review-feedback.schema.json",
  "title": "AgentMaison Blueprint Review Feedback",
  "description": "宿主 → Maison 的结构化评审反馈契约（M7 seam: blueprint-review-feedback）。四类分类必须显式区分；只有同时带 authority、source_revision 与明确 decision 语义的 authoritative_ruling 才可进入 decided_with_authority，且必须经既有 reconciliation 生成新 revision，不得回写旧 revision。与 blueprint-review-publication 方向相反、owner 不同，两条接缝不合并。",
  "type": "object",
  "required": ["artifact", "blueprint_id", "component_id", "source_revision", "items"],
  "properties": {
    "artifact": { "const": "blueprint-review-feedback@1" },
    "blueprint_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "component_id": { "$ref": "#/$defs/stableId" },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "被评审的蓝图 revision。批次级声明；每条 item 的 source_revision 必须与之一致。"
    },
    "provider": {
      "type": "object",
      "required": ["provider_id"],
      "properties": {
        "provider_id": { "$ref": "#/$defs/stableId" },
        "collected_at": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feedbackItem" }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "feedbackItem": {
      "type": "object",
      "required": ["feedback_id", "kind", "source_revision", "target_ref", "body"],
      "properties": {
        "feedback_id": { "$ref": "#/$defs/stableId" },
        "kind": {
          "description": "opinion=意见；fact_supplement=事实补充（须带 evidence_refs）；suggestion=建议；authoritative_ruling=授权裁决（唯一可进 decided_with_authority 的类别）。",
          "enum": ["opinion", "fact_supplement", "suggestion", "authoritative_ruling"]
        },
        "source_revision": { "type": "integer", "minimum": 1 },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "description": "被评论的蓝图稳定地址（view:/node:/relation:/flow:/decision:/contract: 等），必须能在该 revision 内解析。"
        },
        "body": { "type": "string", "minLength": 1 },
        "authority": {
          "type": "object",
          "description": "只有 authoritative_ruling 需要且必须携带。",
          "required": ["owner", "role"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "granted_by": { "type": "string", "minLength": 1 }
          }
        },
        "decision": {
          "type": "object",
          "description": "只有 authoritative_ruling 需要且必须携带；语义必须明确到可以驱动 reconciliation。",
          "required": ["verdict", "rationale"],
          "properties": {
            "verdict": { "enum": ["accept", "reject", "amend"] },
            "rationale": { "type": "string", "minLength": 1 },
            "amended_value": {}
          }
        },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
