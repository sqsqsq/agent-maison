{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework.local/harness/summary.schema.json",
  "title": "Framework Harness Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "feature",
    "verdict",
    "blocker_count",
    "fail_count",
    "warn_count",
    "script_report",
    "merged_report",
    "ai_prompt",
    "summary_json",
    "run_statuses",
    "readiness_signals",
    "blocking_warnings",
    "blocking_skips",
    "blockers",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1", "1.2"],
      "description": "Writer emits 1.2. Legacy 1.0/1.1 remains readable but has unknown assurance and legacy_unverified closure."
    },
    "report_validity": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED"],
      "description": "报告工件可解析/可信——独立于产品裁决（design §1.2），不是产品质量轴"
    },
    "quality_axes": { "$ref": "#/$defs/quality_axes" },
    "release_readiness": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "completion_status": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["spec", "plan", "prd", "design", "coding", "review", "ut", "testing", "catalog", "glossary", "docs", "init"]
    },
    "feature": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "INCOMPLETE"] },
    "blocker_count": { "type": "integer", "minimum": 0 },
    "fail_count": { "type": "integer", "minimum": 0 },
    "warn_count": { "type": "integer", "minimum": 0 },
    "asset_debt_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{16}|no-debt)$",
      "description": "asset 域债务 revision（域内条目投影 sha256 前16 或 no-debt 哨兵）；harness 机器写入，testing 期 asset 轴继承时重算比对——缺失/失配不继承"
    },
    "gate_fingerprint": {
      "type": "string",
      "pattern": "^.+:[0-9a-f]{12}$",
      "description": "门禁集指纹 <frameworkVersion>:<phase-rules sha256 前12>；harness 机器写入，check-receipt 重算比对——framework 升级后旧回执失效（回执 stale 治理）"
    },
    "script_report": { "type": "string", "minLength": 1 },
    "merged_report": { "type": "string", "minLength": 1 },
    "ai_prompt": { "type": "string", "minLength": 1 },
    "summary_json": { "type": "string", "minLength": 1 },
    "run_statuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/run_status" }
    },
    "ut_run_status": { "type": "string" },
    "readiness_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/readiness_signal" }
    },
    "blocking_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocking_notice" }
    },
    "blocking_skips": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocking_notice" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "receipt_status": { "type": "string" },
    "closure_status": { "type": "string", "enum": ["open", "closed"] },
    "repair_candidates": {
      "type": "array",
      "description": "责任阶段统一路由（plan b6e4c9f2）：可信可修缺陷的唯一真源——harness 派生非 agent 自报；goal/manual/batch 三链共用（assess 直读本字段）。缺失=本轮无可信候选。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "files", "summary", "item_fingerprint", "source_phase"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["spec", "plan", "coding"],
            "description": "责任类别（既有 CorrectionCategory 子集；phase 由 assess 按 workflow 映射，不存 phase 名）"
          },
          "files": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "item_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "缺陷身份指纹；整轮防震荡指纹=排序后集合 hash（不落盘，消费方现算）"
          },
          "identity_schema": {
            "type": "string",
            "enum": ["signal@1"],
            "description": "adjudicated-repair-loop（plan e2b7c4a9）：信号级候选标记——仅 testing 结构化视觉信号候选携带（identity = sha256(computeDefectFingerprint(screen, defect))）；无字段 = legacy check-domain 候选（可诊断/路由，不入累计 one-shot 收敛与 no-op 判定）。可选、向后兼容。"
          },
          "source_phase": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assurance": {
      "type": "string",
      "enum": ["blocked", "degraded", "full", "not_applicable"],
      "description": "Mechanical projection of the immutable capability resolution report."
    },
    "capability_resolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability_resolution" }
    },
    "capability_resolution_contract_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "closure_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "committed_at", "receipt_path", "evidence_manifest_path"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "committed_at": { "type": "string", "minLength": 1 },
        "receipt_path": { "type": "string", "minLength": 1 },
        "evidence_manifest_path": { "type": "string", "minLength": 1 }
      },
      "description": "Verified full-track closure marker. Deliberately excludes the manifest hash to avoid a summary-manifest hash cycle."
    },
    "generated_at": { "type": "string", "description": "t2 v2（receipt-slim）：base summary 生成时刻" },
    "source_commit_sha": { "type": "string", "description": "t2 v2：生成时 git HEAD——slim 回执三方绑定（summary↔receipt claimed↔当前 HEAD），杜绝旧 PASS 件复用" },
    "worktree_digest": { "type": "string", "description": "t2 v3：产品层目录工作区状态摘要——HEAD 不动源码改动同样使旧件失效（check-receipt slim 重算比对）" },
    "run_id": { "type": "string", "description": "t2 v2：goal run 身份（MAISON_GOAL_RUN_ID）" },
    "compile_first_error": { "$ref": "#/$defs/compile_first_error" },
    "soft_advisories": {
      "type": "array",
      "items": { "$ref": "#/$defs/soft_advisory" }
    },
    "visual_round": { "$ref": "#/$defs/visual_round" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.2" } },
        "required": ["schema_version"]
      },
      "then": { "required": ["assurance", "capability_resolutions", "capability_resolution_contract_fingerprint", "closure_status"] }
    }
  ],
  "$defs": {
    "quality_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "visual", "asset", "evidence"],
      "properties": {
        "functional": { "$ref": "#/$defs/quality_axis" },
        "visual": { "$ref": "#/$defs/quality_axis" },
        "asset": { "$ref": "#/$defs/quality_axis" },
        "evidence": { "$ref": "#/$defs/quality_axis" }
      }
    },
    "quality_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "required_for_release", "verdict", "blocking_class", "source_checks", "resolution"],
      "properties": {
        "applicable": { "type": "boolean" },
        "required_for_release": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "UNVERIFIED", "STALE", "MISSING", "NOT_APPLICABLE"] },
        "blocking_class": { "enum": ["needs_fix", "needs_human", "external_dependency", null] },
        "source_checks": { "type": "array", "items": { "type": "string" } },
        "resolution": {
          "type": ["null", "object"],
          "additionalProperties": false,
          "required": ["class", "owner", "retry_phase"],
          "properties": {
            "class": { "type": "string", "enum": ["needs_fix", "needs_human", "external_dependency"] },
            "owner": { "type": "string", "enum": ["agent", "human", "toolchain", "external"] },
            "retry_phase": { "type": ["null", "string"] }
          }
        }
      }
    },
    "resolution_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "role": { "enum": ["applicability", "artifact", "derive"] }
      }
    },
    "source_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "state", "dependencies"],
      "properties": {
        "kind": { "enum": ["artifact", "derive"] },
        "source": { "type": "string", "minLength": 1 },
        "state": { "enum": ["resolved", "absent", "invalid", "not_applicable"] },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/resolution_dependency" } },
        "upstream_producer": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "input_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "selected_source", "selected_source_fingerprint", "attempts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["resolved", "absent", "invalid", "not_applicable"] },
        "selected_source": { "type": ["string", "null"] },
        "selected_source_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/source_attempt" } }
      }
    },
    "capability_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "active", "state", "on_missing", "applicability_provider_id", "applicability_dependencies", "inputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "axis": { "enum": ["functional", "visual", "asset", "evidence"] },
        "active": { "type": "boolean" },
        "state": { "enum": ["resolved", "pruned", "blocked", "not_applicable"] },
        "on_missing": { "enum": ["prune", "fail"] },
        "applicability_provider_id": { "type": ["string", "null"] },
        "applicability_dependencies": { "type": "array", "items": { "$ref": "#/$defs/resolution_dependency" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input_resolution" } }
      }
    },
    "visual_round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop_id", "disposition"],
      "description": "t1（plan f7a3d9c2）：视觉轮次账本回执——runner 追加/重放后回传；goal-runner 写入 events.jsonl 做 integrity 对账。duplicate 时同样携带重放后的 decision（rev5）",
      "properties": {
        "loop_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "string" },
        "row_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "disposition": { "type": "string", "enum": ["appended", "duplicate", "append_failed"] },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fused"],
          "properties": {
            "fused": { "type": "boolean" },
            "failure_kind": { "type": "string", "enum": ["no_progress_fuse"] },
            "attribution": { "type": "string", "enum": ["no_fix_attempt", "ineffective_fix"] },
            "residual_fingerprints": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "run_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "WARN", "SKIP"] },
        "can_claim_done": { "type": "boolean" },
        "details": { "type": "string" }
      }
    },
    "readiness_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ready", "incomplete", "unknown"] },
        "message": { "type": "string" },
        "source_check": { "type": "string" }
      }
    },
    "blocking_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "details_excerpt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "blocking_class": { "type": "string" },
        "details_excerpt": { "type": "string" },
        "suggestion": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "details_excerpt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "classification": { "type": "string" },
        "blocking_class": { "type": "string" },
        "details_excerpt": { "type": "string" },
        "affected_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestion": { "type": "string" },
        "source": {
          "type": "string",
          "description": "t1d（plan e6a3c9f4）：产出来源（safeRun origin / profile dispatch 标签 / check-<phase>.ts 回退）——供 agent 直接定位判定实现"
        },
        "actionability": {
          "type": "string",
          "enum": ["agent_fixable", "human_only", "toolchain_blocked"],
          "description": "注册表解析后的可修性：toolchain_blocked 投影 await_operator_toolchain；legacy human_only 不再产生人签放行或 await_human_gate_deferral。回喂过滤与 no-progress 签名剔除共同消费。"
        },
        "operator_note": {
          "type": "string",
          "description": "P1-7（plan 7c4f2e9b）：operator/人类专用说明（framework 内部机制话术）——goal-report 渲染，不进 agent 重试回喂"
        }
      }
    },
    "compile_first_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "message": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" }
      }
    },
    "soft_advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["WARN", "SKIP"] },
        "details": { "type": "string" },
        "effective_image_input": { "type": "string" },
        "source": { "type": "string" }
      }
    }
  }
}
